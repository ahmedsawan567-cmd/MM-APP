@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@model MMApplication.Api.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>تسجيل الدخول — المرأة مول</title>
    <link rel="icon" type="image/svg+xml" href="~/img/brand/mark.svg">
    <link rel="icon" type="image/png" sizes="192x192" href="~/img/brand/icon-192.png">
    <link rel="apple-touch-icon" href="~/img/brand/apple-touch-icon.png">
    <meta name="theme-color" content="#B607BC">
    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem('mm-theme'); } catch (e) { }
            if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/tailwind.css" asp-append-version="true">
    <script src="~/lib/lucide.min.js" asp-append-version="true"></script>
</head>
<body class="min-h-screen">
    <div class="grid min-h-screen lg:grid-cols-2">

        <!-- لوحة الهوية -->
        <section class="relative hidden overflow-hidden bg-gradient-to-br from-brand-950 via-brand-800 to-brand-600 text-white lg:flex lg:flex-col lg:justify-between p-12">
            <div class="pointer-events-none absolute -left-24 -top-24 h-96 w-96 rounded-full bg-gold-500/30 blur-3xl"></div>
            <div class="pointer-events-none absolute -bottom-32 -right-16 h-[28rem] w-[28rem] rounded-full bg-gold-300/15 blur-3xl"></div>
            <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.07]" aria-hidden="true">
                <defs><pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0V32" fill="none" stroke="white" stroke-width="1" /></pattern></defs>
                <rect width="100%" height="100%" fill="url(#grid)" />
            </svg>

            <div class="relative flex items-center gap-3">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white p-2 shadow-lg shadow-black/20">
                    <img src="~/img/brand/mark.svg" alt="" class="h-full w-full" />
                </div>
                <div>
                    <div class="text-lg font-extrabold">المرأة مول</div>
                    <div class="text-xs text-white/70">منظومة الولاء والفواتير</div>
                </div>
            </div>

            <div class="relative max-w-md">
                <h1 class="text-4xl font-extrabold leading-tight">إدارة الولاء والفواتير<br />في مكان واحد</h1>
                <p class="mt-4 text-white/75 leading-relaxed">تابع المبيعات وراجع الفواتير التي قرأها الذكاء الاصطناعي، وأدر المكافآت والمتاجر بسهولة.</p>
                <ul class="mt-8 space-y-3 text-sm text-white/85">
                    <li class="flex items-center gap-3"><span class="flex h-8 w-8 items-center justify-center rounded-lg bg-white/10"><i data-lucide="sparkles" class="h-4 w-4 text-gold-200"></i></span> قراءة الفواتير بالذكاء الاصطناعي</li>
                    <li class="flex items-center gap-3"><span class="flex h-8 w-8 items-center justify-center rounded-lg bg-white/10"><i data-lucide="shield-check" class="h-4 w-4 text-gold-200"></i></span> مراجعة الفواتير المشبوهة قبل منح النقاط</li>
                    <li class="flex items-center gap-3"><span class="flex h-8 w-8 items-center justify-center rounded-lg bg-white/10"><i data-lucide="chart-no-axes-combined" class="h-4 w-4 text-gold-200"></i></span> تقارير المبيعات والنقاط مع تصدير Excel</li>
                </ul>
            </div>

            <div class="relative text-xs text-white/50">© @DateTime.UtcNow.Year المرأة مول</div>
        </section>

        <!-- نموذج الدخول -->
        <main class="flex items-center justify-center bg-canvas p-6 sm:p-10">
            <div class="w-full max-w-sm animate-fade-in">
                <div class="mb-8 flex justify-center lg:hidden">
                    <div class="rounded-3xl bg-white p-4 ring-1 ring-line">
                        <img src="~/img/brand/logo.svg" alt="المرأة مول" class="h-28 w-28" />
                    </div>
                </div>

                <h2 class="text-2xl font-extrabold text-ink">تسجيل الدخول</h2>
                <p class="mt-1 text-sm text-ink-3">ادخل بحساب طاقم العمل للوصول إلى لوحة التحكم</p>

                @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
                {
                    <div class="mt-6 flex items-start gap-2.5 rounded-xl bg-rose-50 p-3.5 text-sm text-rose-700 ring-1 ring-inset ring-rose-200" role="alert">
                        <i data-lucide="circle-alert" class="mt-0.5 h-4 w-4 shrink-0"></i>
                        <span>@Model.ErrorMessage</span>
                    </div>
                }

                <form asp-controller="AdminDashboard" asp-action="Login" asp-route-returnUrl="@Model?.ReturnUrl" method="post" class="mt-6 space-y-4">
                    @Html.AntiForgeryToken()

                    <div>
                        <label for="usernameField" class="form-label">اسم المستخدم أو البريد أو الهاتف</label>
                        <div class="relative">
                            <i data-lucide="user" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-3"></i>
                            <input type="text" id="usernameField" name="Username" value="@Model?.Username" required autocomplete="username" autofocus
                                   class="form-input py-2.5 pr-10" placeholder="رقم الهاتف أو اسم المستخدم" />
                        </div>
                    </div>

                    <div>
                        <label for="passwordField" class="form-label">كلمة المرور</label>
                        <div class="relative">
                            <i data-lucide="lock" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-3"></i>
                            <input type="password" id="passwordField" name="Password" required autocomplete="current-password"
                                   class="form-input py-2.5 pl-10 pr-10" placeholder="••••••••" />
                            <button type="button" onclick="togglePassword()" class="absolute left-2 top-1/2 -translate-y-1/2 rounded-lg p-1.5 text-ink-3 hover:text-ink" aria-label="إظهار كلمة المرور">
                                <i data-lucide="eye" id="pwdIcon" class="h-4 w-4"></i>
                            </button>
                        </div>
                    </div>

                    <label class="flex cursor-pointer items-center gap-2 text-sm text-ink-2">
                        <input type="checkbox" name="RememberMe" value="true" checked class="form-check" />
                        تذكرني على هذا الجهاز
                    </label>

                    <button type="submit" class="btn-primary btn-lg w-full">
                        دخول
                        <i data-lucide="arrow-left" class="h-4 w-4"></i>
                    </button>
                </form>

                @* حسابات التجربة تظهر في بيئة التطوير فقط (لا تُرسل كلمات المرور للمتصفح في الإنتاج) *@
                @if (Env.IsDevelopment())
                {
                    <div class="mt-8 rounded-2xl border border-dashed border-line p-4">
                        <div class="mb-3 flex items-center gap-2 text-xs font-bold text-ink-3">
                            <i data-lucide="flask-conical" class="h-3.5 w-3.5"></i> حسابات تجريبية (بيئة التطوير فقط)
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            @foreach (var (label, user, pwd) in new[] { ("المدير العام", "USR-MOSTAFA", "Admin123!"), ("المطور التقني", "programer", "Programmer123!"), ("مدقق الاحتيال", "USR-MOURAD", "Auditor123!"), ("مدير متجر", "USR-KADI-MGR", "Manager123!") })
                            {
                                <button type="button" onclick="quickFill('@user', '@pwd')" class="rounded-xl bg-surface p-2.5 text-right ring-1 ring-line transition hover:ring-brand-600">
                                    <div class="text-xs font-bold text-ink">@label</div>
                                    <div class="text-xs text-ink-3" dir="ltr">@user</div>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </main>
    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById('passwordField');
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            document.getElementById('pwdIcon').outerHTML = `<i data-lucide="${show ? 'eye-off' : 'eye'}" id="pwdIcon" class="h-4 w-4"></i>`;
            lucide.createIcons();
        }
        function quickFill(user, pwd) {
            document.getElementById('usernameField').value = user;
            document.getElementById('passwordField').value = pwd;
        }
        document.addEventListener('DOMContentLoaded', () => lucide.createIcons());
    </script>
</body>
</html>
