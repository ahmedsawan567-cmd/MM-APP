@model MMApplication.Api.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول - منظومة المرأة مول";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول المركزي - منظومة المرأة مول</title>
    
    <!-- Google Fonts: Cairo & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Cairo"', 'system-ui', 'sans-serif'],
                        mono: ['"Plus Jakarta Sans"', 'monospace']
                    }
                }
            }
        }
    </script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="min-h-screen bg-[#090d16] text-slate-100 flex items-center justify-center p-4 font-sans antialiased relative overflow-hidden">

    <!-- Subtle Background Ambient Glows -->
    <div class="absolute -top-32 -right-32 w-96 h-96 bg-blue-600/10 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-indigo-600/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="w-full max-w-md relative z-10 space-y-6">
        
        <!-- Brand Header -->
        <div class="text-center space-y-2">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 shadow-xl shadow-blue-500/20 mb-1">
                <i data-lucide="store" class="w-7 h-7 text-white"></i>
            </div>
            <h1 class="text-xl font-bold text-white tracking-tight">المرأة مول | لوحة التحكم المركزية</h1>
            <p class="text-xs text-slate-400">إدارة المتاجر، نماذج الفواتير بالـ AI، ومكافآت الولاء</p>
        </div>

        <!-- Authentication Card -->
        <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl backdrop-blur-xl space-y-5">
            
            <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                <span class="text-xs font-bold text-slate-200">تسجيل الدخول للمنظومة</span>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-mono">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Supabase Online
                </span>
            </div>

            <!-- Error Banner -->
            @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
            {
                <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs flex items-center gap-2.5">
                    <i data-lucide="alert-circle" class="w-4 h-4 text-rose-400 shrink-0"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <!-- Form -->
            <form asp-controller="AdminDashboard" asp-action="Login" asp-route-returnUrl="@Model?.ReturnUrl" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1.5">اسم المستخدم أو البريد أو الهاتف</label>
                    <div class="relative">
                        <input type="text" 
                               id="usernameField"
                               name="Username" 
                               value="@Model?.Username" 
                               placeholder="أدخل اسم المستخدم..."
                               required
                               class="w-full pr-10 pl-3 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:bg-slate-800 transition">
                        <i data-lucide="user" class="w-4 h-4 text-slate-400 absolute right-3 top-3"></i>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1.5">كلمة المرور</label>
                    <div class="relative">
                        <input type="password" 
                               id="passwordField"
                               name="Password" 
                               placeholder="••••••••"
                               required
                               class="w-full pr-10 pl-10 py-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:bg-slate-800 transition font-mono">
                        <i data-lucide="lock" class="w-4 h-4 text-slate-400 absolute right-3 top-3"></i>
                        <button type="button" onclick="togglePasswordVisibility()" class="absolute left-3 top-3 text-slate-400 hover:text-white">
                            <i data-lucide="eye" id="pwdToggleIcon" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>

                <div class="flex items-center justify-between text-xs text-slate-400 pt-1">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="RememberMe" value="true" checked class="w-4 h-4 rounded bg-slate-800 border-slate-700 text-blue-600 focus:ring-0">
                        <span>تذكر هذا الجهاز</span>
                    </label>
                    <span class="text-[11px] text-slate-500 font-mono">Session 12h</span>
                </div>

                <button type="submit" class="w-full py-2.5 px-4 rounded-xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-500 shadow-lg shadow-blue-600/30 transition flex items-center justify-center gap-2 mt-2">
                    <i data-lucide="log-in" class="w-4 h-4"></i>
                    <span>دخول المنظومة</span>
                </button>
            </form>

            <!-- Quick Auto-Fill Demo Accounts -->
            <div class="pt-4 border-t border-slate-800 space-y-2">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">حسابات تجريبية سريعة للاختبار:</span>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <button type="button" onclick="quickFill('programer', 'Programmer123!')" class="p-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 border border-slate-700/60 text-right transition">
                        <div class="font-bold text-white text-[11px]">المطور التقني</div>
                        <div class="text-[10px] text-blue-400 font-mono">programer</div>
                    </button>
                    <button type="button" onclick="quickFill('USR-MOSTAFA', 'Admin123!')" class="p-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 border border-slate-700/60 text-right transition">
                        <div class="font-bold text-white text-[11px]">المدير العام</div>
                        <div class="text-[10px] text-indigo-400 font-mono">USR-MOSTAFA</div>
                    </button>
                    <button type="button" onclick="quickFill('USR-KADI-MGR', 'Manager123!')" class="p-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 border border-slate-700/60 text-right transition">
                        <div class="font-bold text-white text-[11px]">مدير كافيه كادي</div>
                        <div class="text-[10px] text-emerald-400 font-mono">USR-KADI-MGR</div>
                    </button>
                    <button type="button" onclick="quickFill('USR-MOURAD', 'Auditor123!')" class="p-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 border border-slate-700/60 text-right transition">
                        <div class="font-bold text-white text-[11px]">مدقق الاحتيال</div>
                        <div class="text-[10px] text-amber-400 font-mono">USR-MOURAD</div>
                    </button>
                </div>
            </div>

        </div>

    </div>

    <script>
        function togglePasswordVisibility() {
            const input = document.getElementById('passwordField');
            const icon = document.getElementById('pwdToggleIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.setAttribute('data-lucide', 'eye-off');
            } else {
                input.type = 'password';
                icon.setAttribute('data-lucide', 'eye');
            }
            if (window.lucide) lucide.createIcons();
        }

        function quickFill(user, pwd) {
            document.getElementById('usernameField').value = user;
            document.getElementById('passwordField').value = pwd;
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (window.lucide) lucide.createIcons();
        });
    </script>
</body>
</html>
