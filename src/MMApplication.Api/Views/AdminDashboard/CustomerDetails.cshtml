@model MMApplication.Api.ViewModels.CustomerDetailsPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = $"كشف حساب العميل: {Model.FullName}";
    ViewData["ActiveTab"] = "customers";
}

<div class="space-y-6">

    <!-- 1. Breadcrumbs & Page Header -->
    <div class="space-y-3">
        <!-- Breadcrumbs -->
        <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
            <a asp-action="Index" class="hover:text-slate-900 transition">الرئيسية</a>
            <i data-lucide="chevron-left" class="w-3.5 h-3.5 text-slate-400"></i>
            <a asp-action="Customers" class="hover:text-slate-900 transition">سجل العملاء</a>
            <i data-lucide="chevron-left" class="w-3.5 h-3.5 text-slate-400"></i>
            <span class="text-slate-900 font-bold">@Model.FullName</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
            <div>
                <div class="flex items-center gap-2 flex-wrap mb-1.5">
                    <span class="badge @(Model.Tier == "Platinum" ? "badge-purple" : (Model.Tier == "Gold" ? "badge-amber" : "badge-slate"))">
                        <i data-lucide="award" class="w-3 h-3"></i>
                        <span>عضوية @(Model.Tier == "Platinum" ? "بلاتينية VIP" : (Model.Tier == "Gold" ? "ذهبية" : (Model.Tier == "Silver" ? "فضية" : "برونزية")))</span>
                    </span>

                    @if (Model.IsSuspended)
                    {
                        <span class="badge badge-rose">
                            <i data-lucide="ban" class="w-3 h-3"></i>
                            <span>الحساب مجمّد</span>
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-emerald">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                            <span>حساب نشط وموثق</span>
                        </span>
                    }

                    <span class="text-xs text-slate-500 num flex items-center gap-1">
                        <i data-lucide="phone" class="w-3.5 h-3.5 text-slate-400"></i>
                        <span dir="ltr">@Model.PhoneNumber</span>
                    </span>
                </div>

                <h1 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <span>@Model.FullName</span>
                    <span class="text-xs font-bold text-slate-400 num">#@Model.CustomerId</span>
                </h1>

                <p class="text-xs text-slate-500 mt-1">
                    تاريخ الانضمام: <span class="num text-slate-700 font-semibold">@Model.RegisteredAt.ToString("yyyy/MM/dd")</span> • آخر نشاط: <span class="num text-slate-700 font-semibold">@(Model.LastActivityDate?.ToString("yyyy/MM/dd HH:mm") ?? "-")</span>
                </p>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-2 flex-wrap">
                <button onclick="openModal('modal-adjust-points')" class="btn-primary">
                    <i data-lucide="coins" class="w-4 h-4"></i>
                    <span>تعديل النقاط</span>
                </button>
                <button onclick="toggleCustomerSuspend('@Model.CustomerId')" class="btn-secondary @(Model.IsSuspended ? "text-emerald-700 hover:bg-emerald-50" : "text-rose-700 hover:bg-rose-50")">
                    <i data-lucide="@(Model.IsSuspended ? "unlock" : "lock")" class="w-4 h-4"></i>
                    <span>@(Model.IsSuspended ? "فك التجميد" : "تجميد الحساب")</span>
                </button>
                <button onclick="showToast('جاري تصدير كشف الحساب المفصل...', 'info')" class="btn-secondary">
                    <i data-lucide="download" class="w-4 h-4 text-slate-500"></i>
                    <span>تصدير كشف الحساب</span>
                </button>
            </div>
        </div>
    </div>

    <!-- 2. KPI Metrics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">رصيد محفظة النقاط</span>
                <i data-lucide="coins" class="w-4 h-4 text-amber-500"></i>
            </div>
            <div class="text-xl font-bold text-amber-600 num">@Model.PointsBalance.ToString("N0") <span class="text-xs font-sans font-normal text-slate-500">نقطة</span></div>
            <div class="text-[11px] text-slate-400 mt-1 num">تعادل نقداً: @((Model.PointsBalance * 0.1m).ToString("N2")) د.ل</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">إجمالي الإنفاق بالمول</span>
                <i data-lucide="wallet" class="w-4 h-4 text-emerald-500"></i>
            </div>
            <div class="text-xl font-bold text-emerald-600 num">@Model.TotalSpent.ToString("N2") <span class="text-xs font-sans font-normal text-slate-500">د.ل</span></div>
            <div class="text-[11px] text-slate-400 mt-1">من واقع فواتير المتاجر المعتمدة</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">عدد الفواتير الممسوحة</span>
                <i data-lucide="receipt" class="w-4 h-4 text-blue-500"></i>
            </div>
            <div class="text-xl font-bold text-slate-900 num">@Model.InvoicesCount <span class="text-xs font-sans font-normal text-slate-500">فاتورة</span></div>
            <div class="text-[11px] text-emerald-700 mt-1 font-medium num">@Model.ApprovedCount معتمدة • معلقة: @Model.PendingCount</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">الاسترداد النقدي (Cashback)</span>
                <i data-lucide="banknote" class="w-4 h-4 text-purple-600"></i>
            </div>
            <div class="text-xl font-bold text-purple-600 num">@Model.TotalCashBackEarned.ToString("N2") <span class="text-xs font-sans font-normal text-slate-500">د.ل</span></div>
            <div class="text-[11px] text-slate-400 mt-1">محسوبة على مشتريات الكاش باك</div>
        </div>
    </div>

    <!-- 3. Segmented Navigation Tabs -->
    <div class="bg-white p-2 rounded-2xl border border-slate-200 shadow-2xs flex items-center gap-1.5" id="custDetailsTabs">
        <button onclick="switchCustTab('invoices', this)" class="segmented-tab active px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-2 bg-slate-900 text-white shadow-xs">
            <i data-lucide="receipt" class="w-3.5 h-3.5"></i>
            <span>سجل الفواتير والمشتريات</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-slate-800 text-slate-200">@Model.Invoices.Count</span>
        </button>
        <button onclick="switchCustTab('stores', this)" class="segmented-tab px-4 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100">
            <i data-lucide="store" class="w-3.5 h-3.5 text-blue-500"></i>
            <span>المتاجر الأكثر ارتياداً</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-slate-100 text-slate-600">@Model.StoreVisits.Count</span>
        </button>
        <button onclick="switchCustTab('rewards', this)" class="segmented-tab px-4 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100">
            <i data-lucide="gift" class="w-3.5 h-3.5 text-purple-500"></i>
            <span>الجوائز المستبدلة</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-slate-100 text-slate-600">@Model.Redemptions.Count</span>
        </button>
    </div>

    <!-- TAB 1: INVOICES & TRANSACTIONS LEDGER -->
    <div id="tab-cust-invoices" class="cust-tab-content space-y-4">
        <div class="card overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-white">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">كشف حساب الفواتير والمشتريات المفصل</h3>
                    <p class="text-xs text-slate-500 mt-0.5">تفاصيل كل فاتورة: وقت المسح الدقيق، المتجر، القيمة، النقاط، ومستوى الخطورة</p>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>رقم الفاتورة / المتجر</th>
                            <th>تاريخ ووقت الشراء</th>
                            <th>وقت المسح والتسجيل</th>
                            <th>المبلغ الإجمالي</th>
                            <th>النقاط المكتسبة</th>
                            <th>مؤشر الخطورة (Risk)</th>
                            <th>الحالة</th>
                            <th class="text-left">الفاتورة / الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Invoices.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-12 text-slate-400">
                                    <div class="w-12 h-12 rounded-full bg-slate-50 text-slate-400 flex items-center justify-center mx-auto mb-2">
                                        <i data-lucide="receipt-text" class="w-6 h-6"></i>
                                    </div>
                                    <div class="font-bold text-slate-700">لا توجد فواتير مسجلة لهذا العميل</div>
                                    <p class="text-xs text-slate-400 mt-1">ستظهر الفواتير بمجرد قيام المتسوق بمسحها من التطبيق</p>
                                </td>
                            </tr>
                        }
                        @foreach (var inv in Model.Invoices)
                        {
                            <tr>
                                <td>
                                    <div class="font-bold text-slate-900">@inv.MerchantName</div>
                                    <div class="text-xs text-slate-500 num flex items-center gap-1 mt-0.5">
                                        <span>#@(inv.InvoiceNumber ?? inv.Id[..8])</span>
                                        <span>•</span>
                                        <span>@inv.StoreCategory</span>
                                    </div>
                                </td>
                                <td class="num text-slate-700">
                                    <div>@inv.InvoiceDate.ToString("yyyy/MM/dd")</div>
                                    <div class="text-xs text-slate-400">@inv.InvoiceDate.ToString("hh:mm tt")</div>
                                </td>
                                <td class="num text-slate-500 text-xs">
                                    <div>@inv.ScanDateTime.ToString("yyyy/MM/dd")</div>
                                    <div class="text-xs text-slate-400">@inv.ScanDateTime.ToString("hh:mm:ss tt")</div>
                                </td>
                                <td class="font-bold text-slate-900 num">
                                    @inv.TotalAmount.ToString("N2") <span class="text-xs text-slate-500 font-normal">د.ل</span>
                                </td>
                                <td>
                                    <span class="font-bold text-amber-600 num">
                                        +@inv.PointsEarned <span class="text-xs font-normal text-slate-500">نقطة</span>
                                    </span>
                                </td>
                                <td>
                                    <div class="flex items-center gap-1.5">
                                        <div class="w-12 h-1.5 rounded-full bg-slate-100 overflow-hidden">
                                            <div class="h-full @(inv.RiskScore > 70 ? "bg-rose-500" : (inv.RiskScore >= 31 ? "bg-amber-500" : "bg-emerald-500"))" style="width: @(inv.RiskScore)%"></div>
                                        </div>
                                        <span class="font-bold text-xs num @(inv.RiskScore > 70 ? "text-rose-700" : (inv.RiskScore >= 31 ? "text-amber-700" : "text-emerald-700"))">
                                            @inv.RiskScore%
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(inv.FraudFlagReason))
                                    {
                                        <div class="text-[10px] text-rose-600 font-bold truncate max-w-[140px] mt-0.5" title="@inv.FraudFlagReason">@inv.FraudFlagReason</div>
                                    }
                                </td>
                                <td>
                                    @if (inv.Status == InvoiceStatus.APPROVED)
                                    {
                                        <span class="badge badge-emerald">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> معتمدة
                                        </span>
                                    }
                                    else if (inv.Status == InvoiceStatus.PENDING)
                                    {
                                        <span class="badge badge-amber">قيد التدقيق</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-rose">مرفوضة</span>
                                    }
                                </td>
                                <td class="text-left">
                                    @if (!string.IsNullOrEmpty(inv.ImageUrl))
                                    {
                                        <button onclick="previewInvoicePhoto('@inv.ImageUrl', '@inv.MerchantName', '@inv.TotalAmount.ToString("N2") د.ل')" class="btn-secondary !py-1 !px-2.5 !text-xs">
                                            <i data-lucide="eye" class="w-3.5 h-3.5 text-slate-500"></i>
                                            <span>معاينة</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-400 num">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 2: STORE VISITS & SPEND BREAKDOWN -->
    <div id="tab-cust-stores" class="cust-tab-content hidden space-y-4">
        <div class="card p-5">
            <div class="mb-4">
                <h3 class="text-sm font-bold text-slate-900">سجل المتاجر الأكثر زيارة وإنفاقاً من قبل العميل</h3>
                <p class="text-xs text-slate-500 mt-0.5">توزيع سلوك المتسوق عبر منافذ ومستأجري المول</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var st in Model.StoreVisits)
                {
                    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-700 flex items-center justify-center font-bold">
                                    <i data-lucide="shopping-bag" class="w-4 h-4 text-blue-600"></i>
                                </div>
                                <div>
                                    <div class="font-bold text-slate-900 text-xs">@st.StoreName</div>
                                    <div class="text-[11px] text-slate-500">@st.Category</div>
                                </div>
                            </div>
                            @if (st.IsFavorite)
                            {
                                <span class="badge badge-amber text-[10px]">متجر مفضل ★</span>
                            }
                        </div>

                        <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-200/80 text-xs">
                            <div>
                                <span class="text-xs text-slate-500 block">إجمالي المشتريات:</span>
                                <span class="font-bold text-emerald-600 text-sm num">@st.TotalSpent.ToString("N2") د.ل</span>
                            </div>
                            <div>
                                <span class="text-xs text-slate-500 block">عدد الزيارات:</span>
                                <span class="font-bold text-slate-800 num">@st.VisitCount مرات</span>
                            </div>
                        </div>

                        <div class="text-xs text-slate-500 flex items-center justify-between pt-1">
                            <span>النقاط المكتسبة: <b class="text-amber-600 num">+@st.TotalPointsEarned</b></span>
                            <span>آخر زيارة: <b class="text-slate-600 num">@st.LastVisitDate.ToString("yyyy/MM/dd")</b></span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- TAB 3: REDEEMED REWARDS CATALOG -->
    <div id="tab-cust-rewards" class="cust-tab-content hidden space-y-4">
        <div class="card overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-white">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">سجل الجوائز والمكافآت التي استبدلها العميل</h3>
                    <p class="text-xs text-slate-500 mt-0.5">القسائم والخصومات والتذاكر المستفاد منها برصيد النقاط</p>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>المكافأة / الجائزة</th>
                            <th>النوع والتصنيف</th>
                            <th>النقاط المخصومة</th>
                            <th>القيمة التقديرية</th>
                            <th>تاريخ الاستبدال</th>
                            <th>كود القسيمة</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Redemptions.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-12 text-slate-400">
                                    <div class="w-12 h-12 rounded-full bg-slate-50 text-slate-400 flex items-center justify-center mx-auto mb-2">
                                        <i data-lucide="gift" class="w-6 h-6"></i>
                                    </div>
                                    <div class="font-bold text-slate-700">لم يقم العميل باستبدال أي مكافآت بعد</div>
                                    <p class="text-xs text-slate-400 mt-1">ستظهر القسائم والتذاكر فور استبدالها عبر التطبيق</p>
                                </td>
                            </tr>
                        }
                        @foreach (var r in Model.Redemptions)
                        {
                            <tr>
                                <td class="font-bold text-slate-900 flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-lg bg-purple-50 text-purple-600 border border-purple-100 flex items-center justify-center">
                                        <i data-lucide="gift" class="w-3.5 h-3.5"></i>
                                    </div>
                                    <span>@r.RewardTitle</span>
                                </td>
                                <td class="text-slate-600 font-medium text-xs">@r.Category</td>
                                <td class="font-bold text-rose-600 num">-@r.PointsSpent نقطة</td>
                                <td class="font-bold text-emerald-600 num">@r.MonetaryValue.ToString("N2") د.ل</td>
                                <td class="num text-slate-500 text-xs">@r.RedemptionDate.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>
                                    <span class="font-bold text-xs text-slate-800 bg-slate-100 px-2 py-0.5 rounded border border-slate-200 num">
                                        @r.RedemptionCode
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-emerald">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> مكتملة
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODALS -->
<!-- ======================================================== -->

<!-- Modal: Adjust Points -->
<div id="modal-adjust-points" class="hidden modal-overlay">
    <div class="modal-box max-w-md">
        <div class="modal-header">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                <i data-lucide="coins" class="w-4 h-4 text-amber-500"></i>
                <span>تعديل رصيد نقاط العميل: @Model.FullName</span>
            </h3>
            <button onclick="closeModal('modal-adjust-points')" class="text-slate-400 hover:text-slate-700"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>

        <div class="modal-body space-y-3.5">
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 flex items-center justify-between text-xs">
                <span class="text-slate-600 font-medium">الرصيد الحالي:</span>
                <span class="font-bold num text-slate-900">@Model.PointsBalance نقطة</span>
            </div>

            <div>
                <label class="form-label">نوع الحركة:</label>
                <select id="adj-type" class="form-select">
                    <option value="add">إضافة نقاط تعويضية / مكافأة (+)</option>
                    <option value="deduct">خصم نقاط (-)</option>
                </select>
            </div>

            <div>
                <label class="form-label">عدد النقاط:</label>
                <input type="number" id="adj-points" value="100" min="1" class="form-input font-bold num">
            </div>

            <div>
                <label class="form-label">سبب التعديل (يسجل في سجل الرقابة):</label>
                <input type="text" id="adj-reason" placeholder="مثال: تعويض عن عطل في ماسح المتجر" class="form-input">
            </div>
        </div>

        <div class="modal-footer">
            <button onclick="closeModal('modal-adjust-points')" class="btn-secondary">إلغاء</button>
            <button onclick="submitAdjustPoints('@Model.CustomerId')" class="btn-primary">اعتماد وحفظ التعديل</button>
        </div>
    </div>
</div>

<!-- Modal: Invoice Photo Preview -->
<div id="modal-invoice-preview" class="hidden modal-overlay">
    <div class="modal-box max-w-lg">
        <div class="modal-header">
            <div>
                <h3 class="font-bold text-slate-900 text-sm" id="prev-merchant">معاينة صورة الفاتورة</h3>
                <p class="text-xs text-slate-400 mt-0.5" id="prev-amount"></p>
            </div>
            <button onclick="closeModal('modal-invoice-preview')" class="text-slate-400 hover:text-slate-700"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>

        <div class="modal-body">
            <div class="rounded-xl overflow-hidden bg-slate-100 border border-slate-200 max-h-96 flex items-center justify-center p-2">
                <img id="prev-img" src="" class="max-h-96 w-auto object-contain rounded" alt="Invoice Photo">
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function switchCustTab(tabId, el) {
        document.querySelectorAll('.cust-tab-content').forEach(c => c.classList.add('hidden'));
        const target = document.getElementById(`tab-cust-${tabId}`);
        if (target) target.classList.remove('hidden');

        document.querySelectorAll('#custDetailsTabs .segmented-tab').forEach(t => {
            t.classList.remove('active', 'bg-slate-900', 'text-white', 'shadow-xs');
            t.classList.add('text-slate-600', 'hover:text-slate-900', 'hover:bg-slate-100');
        });
        if (el) {
            el.classList.add('active', 'bg-slate-900', 'text-white', 'shadow-xs');
            el.classList.remove('text-slate-600', 'hover:text-slate-900', 'hover:bg-slate-100');
        }
    }

    function previewInvoicePhoto(imgUrl, merchant, amount) {
        document.getElementById('prev-img').src = imgUrl;
        document.getElementById('prev-merchant').textContent = `فاتورة: ${merchant}`;
        document.getElementById('prev-amount').textContent = `إجمالي القيمة: ${amount}`;
        openModal('modal-invoice-preview');
    }

    async function toggleCustomerSuspend(customerId) {
        const result = await Swal.fire({
            title: 'حالة الحساب',
            text: 'هل أنت متأكد من تغيير حالة تجميد هذا الحساب؟',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'نعم، تابع',
            cancelButtonText: 'إلغاء'
        });

        if (!result.isConfirmed) return;

        try {
            const res = await fetch(`/api/SuperAdmin/customers/${customerId}/toggle-suspend`, {
                method: 'POST'
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok) {
                showToast(data.message || 'تم تعديل حالة الحساب بنجاح!', 'success');
                setTimeout(() => window.location.reload(), 800);
            } else {
                showToast(data.message || 'فشل في تعديل حالة الحساب', 'error');
            }
        } catch (e) {
            showToast('حدث خطأ في الاتصال بالخادم', 'error');
        }
    }

    async function submitAdjustPoints(customerId) {
        const type = document.getElementById('adj-type').value;
        const pts = parseInt(document.getElementById('adj-points').value, 10);
        const reason = document.getElementById('adj-reason').value.trim();

        if (isNaN(pts) || pts <= 0) {
            showToast('يرجى إدخال عدد نقاط صحيح', 'warning');
            return;
        }

        const pointsDelta = type === 'deduct' ? -pts : pts;

        try {
            const res = await fetch(`/api/SuperAdmin/customers/${customerId}/adjust-points`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ pointsDelta, reason: reason || 'تعديل إداري' })
            });

            const data = await res.json().catch(() => ({}));
            if (res.ok) {
                closeModal('modal-adjust-points');
                showToast(`تم تعديل النقاط بنجاح (${pointsDelta > 0 ? '+' : ''}${pointsDelta})`, 'success');
                setTimeout(() => window.location.reload(), 800);
            } else {
                showToast(data.message || 'فشل في تعديل النقاط', 'error');
            }
        } catch (e) {
            showToast('حدث خطأ في الاتصال', 'error');
        }
    }
</script>
}
