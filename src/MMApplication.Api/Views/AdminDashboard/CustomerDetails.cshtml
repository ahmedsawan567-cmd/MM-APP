@model MMApplication.Api.ViewModels.CustomerProfileViewModel
@using MMApplication.Api.ViewModels
@using MMApplication.Domain.Enums
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.FullName;
    ViewData["ActiveTab"] = "customers";
    var m = Model;
    var initial = m.FullName.Trim().Length > 0 ? m.FullName.Trim()[..1] : "ع";
    var customerJson = System.Text.Json.JsonSerializer.Serialize(new
    {
        Id = m.CustomerId, m.MembershipNumber, m.FullName, m.PhoneNumber, m.Email,
        BirthDate = m.BirthDate?.ToString("yyyy-MM-dd"), m.Gender, Tier = m.Tier.ToUpperInvariant(),
        CurrentPoints = m.PointsBalance, IsSuspended = m.IsFrozen
    });
    string Money(decimal v) => v.ToString("N2");
    string Local(DateTime d) => d.ToLocalTime().ToString("yyyy/MM/dd HH:mm");
    string Day(DateTime d) => d.ToLocalTime().ToString("yyyy/MM/dd");
    var tabs = new[]
    {
        ("account", "الحساب والأمان", "shield-check", -1),
        ("invoices", "الفواتير", "receipt-text", m.Invoices.Count),
        ("ledger", "حركة النقاط", "coins", m.Ledger.Count),
        ("vouchers", "القسائم", "ticket", m.Vouchers.Count),
        ("stores", "المتاجر", "store", m.Stores.Count),
        ("notifications", "الإشعارات", "bell", m.Notifications.Count),
        ("devices", "الأجهزة", "smartphone", m.Devices.Count),
        ("audit", "السجل", "history", m.Audit.Count),
    };
}
@Html.AntiForgeryToken()

<div class="space-y-5">
    <nav class="flex items-center gap-1.5 text-sm text-slate-500 print:hidden">
        <a asp-action="Customers" class="hover:text-brand-700">العملاء</a>
        <i data-lucide="chevron-left" class="w-4 h-4"></i>
        <span class="text-slate-800 font-semibold">@m.FullName</span>
    </nav>

    <!-- بطاقة العميل -->
    <div class="card p-5 sm:p-6">
        <div class="flex flex-col lg:flex-row lg:items-center gap-5">
            <div class="flex items-center gap-4 min-w-0 flex-1">
                <div class="w-16 h-16 shrink-0 rounded-2xl bg-gradient-to-br from-brand-600 to-fuchsia-500 text-white text-2xl font-bold flex items-center justify-center">@initial</div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <h1 class="text-2xl font-bold text-slate-900">@m.FullName</h1>
                        <span class="badge @DisplayLabels.TierBadge(m.Tier)">@DisplayLabels.Tier(m.Tier)</span>
                        @if (m.IsArchived) { <span class="badge badge-slate">محذوف</span> }
                        else if (m.IsFrozen) { <span class="badge badge-rose"><i data-lucide="lock" class="w-3 h-3"></i> مجمّد</span> }
                        else { <span class="badge badge-emerald">نشط</span> }
                    </div>
                    <div class="mt-1.5 flex items-center gap-x-4 gap-y-1 flex-wrap text-sm text-slate-500">
                        <button type="button" onclick="copyText('@m.MembershipNumber')" class="inline-flex items-center gap-1 font-bold text-brand-700 num hover:underline" dir="ltr" title="نسخ رقم العضوية">
                            @(m.MembershipNumber ?? "—") <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                        </button>
                        <span class="inline-flex items-center gap-1"><i data-lucide="phone" class="w-3.5 h-3.5"></i><span class="num" dir="ltr">@m.PhoneNumber</span></span>
                        <span class="inline-flex items-center gap-1"><i data-lucide="calendar" class="w-3.5 h-3.5"></i>عضو منذ <span class="num">@Day(m.RegisteredAt)</span></span>
                    </div>
                </div>
            </div>
            @if (m.CanEdit && !m.IsArchived)
            {
                <div class="flex items-center gap-2 flex-wrap print:hidden">
                    <button type="button" onclick="MMCustomers.openForm(customer)" class="btn-secondary"><i data-lucide="pencil" class="w-4 h-4"></i> تعديل</button>
                    <button type="button" onclick="MMCustomers.openNotify(customer)" class="btn-secondary"><i data-lucide="send" class="w-4 h-4"></i> إشعار</button>
                    @if (m.IsSuperAdmin)
                    {
                        <button type="button" onclick="MMCustomers.openPoints(customer)" class="btn-primary"><i data-lucide="coins" class="w-4 h-4"></i> تعديل النقاط</button>
                    }
                    <div class="relative">
                        <button type="button" class="btn-icon" onclick="MM.dropdown('cust-more')" aria-haspopup="menu" aria-label="المزيد"><i data-lucide="ellipsis" class="w-5 h-5"></i></button>
                        <div id="cust-more" class="dropdown left-0 hidden" role="menu">
                            <button type="button" class="dropdown-item" onclick="MMCustomers.resetPassword(customer)"><i data-lucide="key-round" class="w-4 h-4"></i> كلمة مرور جديدة للتطبيق</button>
                            <button type="button" class="dropdown-item" onclick="MMCustomers.toggleSuspend(customer)"><i data-lucide="@(m.IsFrozen ? "lock-open" : "lock")" class="w-4 h-4"></i> @(m.IsFrozen ? "تنشيط الحساب" : "تجميد الحساب")</button>
                            <button type="button" class="dropdown-item" onclick="window.print()"><i data-lucide="printer" class="w-4 h-4"></i> طباعة كشف الحساب</button>
                            @if (m.CanDelete)
                            {
                                <div class="my-1 border-t border-line"></div>
                                <button type="button" class="dropdown-item !text-rose-600" onclick="MMCustomers.remove(customer, '/AdminDashboard/Customers')"><i data-lucide="trash-2" class="w-4 h-4"></i> حذف العميل</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <dl class="mt-5 pt-5 border-t border-line grid grid-cols-2 md:grid-cols-4 xl:grid-cols-7 gap-x-6 gap-y-4 text-sm">
            <div><dt class="text-slate-500">البريد</dt><dd class="mt-0.5 font-semibold num truncate" dir="ltr">@(m.Email ?? "—")</dd></div>
            <div><dt class="text-slate-500">تاريخ الميلاد</dt><dd class="mt-0.5 font-semibold num">@(m.BirthDate?.ToString("yyyy/MM/dd") ?? "—")</dd></div>
            <div><dt class="text-slate-500">الجنس</dt><dd class="mt-0.5 font-semibold">@(m.Gender == "F" ? "أنثى" : m.Gender == "M" ? "ذكر" : "—")</dd></div>
            <div><dt class="text-slate-500">دخول التطبيق</dt><dd class="mt-0.5 font-semibold @(m.HasAppPassword ? "text-emerald-600" : "text-slate-500")">@(m.HasAppPassword ? "مفعّل" : "غير مفعّل")</dd></div>
            <div><dt class="text-slate-500">آخر فاتورة</dt><dd class="mt-0.5 font-semibold num">@(m.LastInvoiceAt.HasValue ? Day(m.LastInvoiceAt.Value) : "—")</dd></div>
            <div><dt class="text-slate-500">آخر تعديل</dt><dd class="mt-0.5 font-semibold num">@(m.UpdatedAt.HasValue ? Day(m.UpdatedAt.Value) : "—")</dd></div>
            <div><dt class="text-slate-500">الأجهزة</dt><dd class="mt-0.5 font-semibold num">@m.Devices.Count</dd></div>
        </dl>

        @if (m.IsFrozen || m.SharedDeviceAccounts > 0 || m.PendingCount > 0 || !m.HasAppPassword)
        {
            <div class="mt-5 grid gap-2">
                @if (m.IsFrozen)
                {
                    <div class="rounded-xl bg-rose-50 text-rose-800 px-4 py-2.5 text-sm flex items-center gap-2"><i data-lucide="lock" class="w-4 h-4 shrink-0"></i> الحساب مجمّد: لا يستطيع العميل الدخول أو رفع الفواتير.</div>
                }
                @if (m.SharedDeviceAccounts > 0)
                {
                    <div class="rounded-xl bg-amber-50 text-amber-800 px-4 py-2.5 text-sm flex items-center gap-2"><i data-lucide="smartphone" class="w-4 h-4 shrink-0"></i> جهاز العميل مستخدم من <b class="num">@m.SharedDeviceAccounts</b> حساب آخر — راجع تبويب الأجهزة.</div>
                }
                @if (m.PendingCount > 0)
                {
                    <a asp-action="Review" class="rounded-xl bg-brand-50 text-brand-800 px-4 py-2.5 text-sm flex items-center gap-2 hover:bg-brand-100"><i data-lucide="scan-search" class="w-4 h-4 shrink-0"></i> <b class="num">@m.PendingCount</b> فاتورة بانتظار المراجعة <i data-lucide="chevron-left" class="w-4 h-4 mr-auto"></i></a>
                }
                @if (!m.HasAppPassword && !m.IsArchived)
                {
                    <div class="rounded-xl bg-slate-100 text-slate-700 px-4 py-2.5 text-sm flex items-center gap-2"><i data-lucide="key-round" class="w-4 h-4 shrink-0"></i> لا توجد كلمة مرور للتطبيق بعد — استخدم "كلمة مرور جديدة للتطبيق" من قائمة المزيد.</div>
                }
            </div>
        }
    </div>

    <!-- المؤشرات -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="stat-card">
            <div class="flex items-center justify-between"><span class="stat-label">رصيد النقاط</span><span class="stat-icon bg-amber-50 text-amber-600"><i data-lucide="coins" class="w-5 h-5"></i></span></div>
            <div class="stat-value text-gold-600 num">@m.PointsBalance.ToString("N0")</div>
            <div class="stat-meta">كسب <span class="num">@m.PointsEarned.ToString("N0")</span> • صرف <span class="num">@m.PointsRedeemed.ToString("N0")</span></div>
        </div>
        <div class="stat-card">
            <div class="flex items-center justify-between"><span class="stat-label">المشتريات المعتمدة</span><span class="stat-icon bg-emerald-50 text-emerald-600"><i data-lucide="wallet" class="w-5 h-5"></i></span></div>
            <div class="stat-value num">@Money(m.TotalSpent) <span class="text-base font-semibold text-slate-400">د.ل</span></div>
            <div class="stat-meta">متوسط الفاتورة <span class="num">@Money(m.AverageInvoice)</span> د.ل</div>
        </div>
        <div class="stat-card">
            <div class="flex items-center justify-between"><span class="stat-label">الفواتير</span><span class="stat-icon bg-brand-50 text-brand-600"><i data-lucide="receipt-text" class="w-5 h-5"></i></span></div>
            <div class="stat-value num">@m.InvoicesCount</div>
            <div class="stat-meta"><span class="text-emerald-600">معتمدة <span class="num">@m.ApprovedCount</span></span> • <span class="text-amber-600">معلّقة <span class="num">@m.PendingCount</span></span> • <span class="text-rose-600">مرفوضة <span class="num">@m.RejectedCount</span></span></div>
        </div>
        <div class="stat-card">
            <div class="flex items-center justify-between"><span class="stat-label">القسائم الصالحة</span><span class="stat-icon bg-purple-50 text-purple-600"><i data-lucide="ticket" class="w-5 h-5"></i></span></div>
            <div class="stat-value num">@m.VouchersActive</div>
            <div class="stat-meta">قسائم مستبدلة: <span class="num">@m.Vouchers.Count</span></div>
        </div>
    </div>

    <div class="space-y-4 min-w-0">
            <div class="tabs print:hidden" role="tablist">
                @foreach (var (key, label, icon, count) in tabs)
                {
                    <button type="button" class="tab @(key == "account" ? "tab-active" : "")" data-tab="@key" onclick="showTab('@key')" role="tab">
                        <i data-lucide="@icon" class="w-4 h-4"></i> @label @if (count >= 0) { <span class="text-xs text-slate-400 num">@count</span> }
                    </button>
                }
            </div>

            <!-- الفواتير -->
            <section data-panel="account" class="grid lg:grid-cols-2 gap-4">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">نشاط الحساب</h3></div>
                    <dl class="divide-y divide-line text-sm">
                        <div class="flex justify-between gap-3 px-5 py-3"><dt class="text-slate-500">تاريخ التسجيل</dt><dd class="font-semibold num">@Local(m.RegisteredAt)</dd></div>
                        <div class="flex justify-between gap-3 px-5 py-3"><dt class="text-slate-500">آخر فتح للتطبيق</dt><dd class="font-semibold num">@(m.LastSeenAt.HasValue ? Local(m.LastSeenAt.Value) : "لم يفتح التطبيق بعد")</dd></div>
                        <div class="flex justify-between gap-3 px-5 py-3"><dt class="text-slate-500">آخر تسجيل دخول</dt><dd class="font-semibold num">@(m.LastLoginAt.HasValue ? Local(m.LastLoginAt.Value) : "—")</dd></div>
                        <div class="flex justify-between gap-3 px-5 py-3"><dt class="text-slate-500">عدد مرات الدخول</dt><dd class="font-semibold num">@m.LoginCount</dd></div>
                        <div class="flex justify-between gap-3 px-5 py-3"><dt class="text-slate-500">الجهاز وإصدار التطبيق</dt><dd class="font-semibold num">@(m.LastPlatform ?? "—")@(m.LastAppVersion != null ? " • " + m.LastAppVersion : "")</dd></div>
                        <div class="flex justify-between gap-3 px-5 py-3"><dt class="text-slate-500">آخر فاتورة</dt><dd class="font-semibold num">@(m.LastInvoiceAt.HasValue ? Local(m.LastInvoiceAt.Value) : "—")</dd></div>
                        <div class="flex justify-between gap-3 px-5 py-3"><dt class="text-slate-500">آخر تعديل للبيانات</dt><dd class="font-semibold num">@(m.UpdatedAt.HasValue ? Local(m.UpdatedAt.Value) : "—")</dd></div>
                    </dl>
                </div>
                <div class="card">
                    <div class="card-header"><h3 class="card-title">كلمة المرور</h3></div>
                    <dl class="divide-y divide-line text-sm">
                        <div class="flex justify-between gap-3 px-5 py-3"><dt class="text-slate-500">دخول التطبيق</dt><dd class="font-semibold @(m.HasAppPassword ? "text-emerald-600" : "text-slate-500")">@(m.HasAppPassword ? "مفعّل" : "غير مفعّل — لا توجد كلمة مرور")</dd></div>
                        <div class="flex justify-between gap-3 px-5 py-3"><dt class="text-slate-500">آخر تغيير لكلمة المرور</dt><dd class="font-semibold num">@(m.PasswordChangedAt.HasValue ? Local(m.PasswordChangedAt.Value) : "—")</dd></div>
                        <div class="flex justify-between gap-3 px-5 py-3"><dt class="text-slate-500">غيّرها</dt><dd class="font-semibold">@(m.PasswordChangedBy ?? "—")</dd></div>
                    </dl>
                    <div class="px-5 py-4 border-t border-line text-sm text-slate-600 leading-relaxed flex gap-2">
                        <i data-lucide="lock" class="w-4 h-4 shrink-0 mt-0.5 text-slate-400"></i>
                        <span>كلمات المرور محفوظة مشفّرة ولا يمكن لأحد عرضها، حمايةً للعميل والمول. إذا نسيها العميل استخدم "كلمة مرور جديدة" وسلّمها له.</span>
                    </div>
                    @if (m.CanEdit && !m.IsArchived)
                    {
                        <div class="px-5 pb-5"><button type="button" onclick="MMCustomers.resetPassword(customer)" class="btn-secondary w-full"><i data-lucide="key-round" class="w-4 h-4"></i> كلمة مرور جديدة</button></div>
                    }
                </div>
                <div class="card lg:col-span-2 overflow-hidden">
                    <div class="card-header"><h3 class="card-title">سجل تغييرات كلمة المرور</h3></div>
                    @if (m.PasswordHistory.Count == 0)
                    {
                        <div class="px-5 py-6 text-sm text-slate-500">لا توجد تغييرات مسجلة.</div>
                    }
                    else
                    {
                        <table class="data-table">
                            <thead><tr><th>الوقت</th><th>العملية</th><th>المنفّذ</th></tr></thead>
                            <tbody>
                                @foreach (var a in m.PasswordHistory)
                                {
                                    <tr>
                                        <td class="num whitespace-nowrap">@Local(a.Date)</td>
                                        <td><span class="badge @DisplayLabels.ActionBadge(a.Action)">@DisplayLabels.Action(a.Action)</span></td>
                                        <td class="font-semibold">@a.By</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </section>

            <section data-panel="invoices" class="card overflow-hidden hidden">
                @if (m.Invoices.Count == 0)
                {
                    <div class="empty-state"><div class="empty-state-icon"><i data-lucide="receipt-text" class="w-6 h-6"></i></div><div class="font-bold text-slate-700">لا توجد فواتير بعد</div></div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="data-table">
                            <thead><tr><th>المتجر</th><th>رقم الفاتورة</th><th>التاريخ</th><th>المبلغ</th><th>النقاط</th><th>الحالة</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var i in m.Invoices)
                                {
                                    var (label, badge) = DisplayLabels.Invoice(i.Status);
                                    <tr>
                                        <td class="font-semibold text-slate-900">@i.Store</td>
                                        <td class="num" dir="ltr">@(string.IsNullOrEmpty(i.InvoiceNumber) ? "—" : i.InvoiceNumber)</td>
                                        <td class="num whitespace-nowrap">@Day(i.Date)<div class="text-xs text-slate-400">رُفعت @Local(i.UploadedAt)</div></td>
                                        <td class="num font-semibold whitespace-nowrap">@Money(i.Amount) <span class="text-xs text-slate-400">د.ل</span></td>
                                        <td class="num font-bold @(i.Points > 0 ? "text-gold-600" : "text-slate-400")">@(i.Points > 0 ? "+" + i.Points : "0")</td>
                                        <td>
                                            <span class="badge @badge">@label</span>
                                            @if (!string.IsNullOrEmpty(i.Reason) && i.Status != InvoiceStatus.APPROVED)
                                            {
                                                <div class="text-xs text-slate-500 mt-1 max-w-[14rem] truncate" title="@i.Reason">@i.Reason</div>
                                            }
                                        </td>
                                        <td class="text-left whitespace-nowrap">
                                            @if (!string.IsNullOrEmpty(i.ImageUrl))
                                            {
                                                <button type="button" class="btn-ghost btn-sm" onclick="previewImage('@i.ImageUrl', @Json.Serialize(i.Store))"><i data-lucide="image" class="w-4 h-4"></i> الصورة</button>
                                            }
                                            @if (i.Status == InvoiceStatus.REVIEW_REQUIRED)
                                            {
                                                <a asp-action="Review" class="btn-ghost btn-sm text-brand-700"><i data-lucide="scan-search" class="w-4 h-4"></i> مراجعة</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <!-- حركة النقاط -->
            <section data-panel="ledger" class="card overflow-hidden hidden">
                @if (m.Ledger.Count == 0)
                {
                    <div class="empty-state"><div class="empty-state-icon"><i data-lucide="coins" class="w-6 h-6"></i></div><div class="font-bold text-slate-700">لا توجد حركة نقاط</div></div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="data-table">
                            <thead><tr><th>التاريخ</th><th>النوع</th><th>البيان</th><th>النقاط</th><th>الرصيد بعدها</th></tr></thead>
                            <tbody>
                                @foreach (var l in m.Ledger)
                                {
                                    <tr>
                                        <td class="num whitespace-nowrap">@Local(l.Date)</td>
                                        <td><span class="badge @(l.Amount >= 0 ? "badge-emerald" : "badge-rose")">@DisplayLabels.LedgerType(l.Type)</span></td>
                                        <td class="text-slate-600 max-w-md">@(l.Remarks ?? "—")</td>
                                        <td class="num font-bold @(l.Amount >= 0 ? "text-emerald-600" : "text-rose-600")">@(l.Amount >= 0 ? "+" : "")@l.Amount.ToString("N0")</td>
                                        <td class="num font-semibold">@l.BalanceAfter.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <!-- القسائم -->
            <section data-panel="vouchers" class="card overflow-hidden hidden">
                @if (m.Vouchers.Count == 0)
                {
                    <div class="empty-state"><div class="empty-state-icon"><i data-lucide="ticket" class="w-6 h-6"></i></div><div class="font-bold text-slate-700">لم يستبدل العميل أي مكافأة بعد</div></div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="data-table">
                            <thead><tr><th>المكافأة</th><th>الكود</th><th>النقاط</th><th>الاستبدال</th><th>الصلاحية</th><th>الحالة</th></tr></thead>
                            <tbody>
                                @foreach (var v in m.Vouchers)
                                {
                                    var (label, badge) = DisplayLabels.Redemption(v.Status, v.ExpiresAt);
                                    <tr>
                                        <td class="font-semibold text-slate-900">@v.Title</td>
                                        <td class="num font-bold text-brand-700" dir="ltr">@v.Code</td>
                                        <td class="num">@v.Points.ToString("N0")</td>
                                        <td class="num whitespace-nowrap">@Local(v.RedeemedAt)</td>
                                        <td class="num whitespace-nowrap">@Day(v.ExpiresAt)</td>
                                        <td>
                                            <span class="badge @badge">@label</span>
                                            @if (v.UsedAt.HasValue)
                                            {
                                                <div class="text-xs text-slate-500 mt-1 num">@Local(v.UsedAt.Value)@(string.IsNullOrEmpty(v.UsedBy) ? "" : " • " + v.UsedBy)</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <!-- المتاجر -->
            <section data-panel="stores" class="card overflow-hidden hidden">
                @if (m.Stores.Count == 0)
                {
                    <div class="empty-state"><div class="empty-state-icon"><i data-lucide="store" class="w-6 h-6"></i></div><div class="font-bold text-slate-700">لا توجد زيارات بعد</div></div>
                }
                else
                {
                    var maxSpent = Math.Max(1m, m.Stores.Max(s => s.Spent));
                    <div class="overflow-x-auto">
                        <table class="data-table">
                            <thead><tr><th>المتجر</th><th>الفواتير</th><th>المشتريات المعتمدة</th><th>النقاط</th><th>آخر زيارة</th></tr></thead>
                            <tbody>
                                @foreach (var s in m.Stores)
                                {
                                    <tr>
                                        <td><div class="font-semibold text-slate-900">@s.Store</div><div class="text-xs text-slate-500">@s.Category</div></td>
                                        <td class="num">@s.Visits</td>
                                        <td style="min-width: 12rem">
                                            <div class="flex items-center gap-2">
                                                <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden"><div class="h-full rounded-full bg-brand-600" style="width: @((int)(100 * s.Spent / maxSpent))%"></div></div>
                                                <span class="num font-semibold text-sm whitespace-nowrap">@Money(s.Spent)</span>
                                            </div>
                                        </td>
                                        <td class="num text-gold-600 font-bold">@s.Points.ToString("N0")</td>
                                        <td class="num whitespace-nowrap">@Day(s.LastVisit)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <!-- الإشعارات -->
            <section data-panel="notifications" class="card overflow-hidden hidden">
                @if (m.Notifications.Count == 0)
                {
                    <div class="empty-state"><div class="empty-state-icon"><i data-lucide="bell" class="w-6 h-6"></i></div><div class="font-bold text-slate-700">لم تُرسل إشعارات لهذا العميل</div></div>
                }
                else
                {
                    <ul class="divide-y divide-line">
                        @foreach (var n in m.Notifications)
                        {
                            <li class="px-5 py-3.5 flex items-start gap-3">
                                <span class="mt-1.5 w-2 h-2 rounded-full shrink-0 @(n.IsRead ? "bg-slate-300" : "bg-brand-600")"></span>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center justify-between gap-3">
                                        <div class="font-semibold text-slate-900">@n.Title</div>
                                        <div class="text-xs text-slate-400 num whitespace-nowrap">@Local(n.CreatedAt)</div>
                                    </div>
                                    <div class="text-sm text-slate-600 mt-0.5">@n.Body</div>
                                    <div class="text-xs mt-1 @(n.IsRead ? "text-slate-400" : "text-brand-700")">@(n.IsRead ? "مقروء" : "لم يُقرأ بعد")</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>

            <!-- الأجهزة -->
            <section data-panel="devices" class="card overflow-hidden hidden">
                @if (m.Devices.Count == 0)
                {
                    <div class="empty-state"><div class="empty-state-icon"><i data-lucide="smartphone" class="w-6 h-6"></i></div><div class="font-bold text-slate-700">لا توجد أجهزة مسجلة</div><p class="text-sm text-slate-500">يُسجَّل الجهاز عند رفع أول فاتورة من التطبيق</p></div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="data-table">
                            <thead><tr><th>الجهاز</th><th>أول استخدام</th><th>آخر استخدام</th><th>حسابات أخرى عليه</th></tr></thead>
                            <tbody>
                                @foreach (var d in m.Devices)
                                {
                                    <tr>
                                        <td><div class="font-semibold text-slate-900">@(d.Model ?? "جهاز غير معروف")</div><div class="text-xs text-slate-500">@d.Os</div></td>
                                        <td class="num">@Day(d.FirstSeen)</td>
                                        <td class="num">@Local(d.LastSeen)</td>
                                        <td>@if (d.OtherAccounts > 0) { <span class="badge badge-amber num">@d.OtherAccounts حساب</span> } else { <span class="text-slate-400">لا يوجد</span> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <!-- السجل -->
            <section data-panel="audit" class="card overflow-hidden hidden">
                @if (m.Audit.Count == 0)
                {
                    <div class="empty-state"><div class="empty-state-icon"><i data-lucide="history" class="w-6 h-6"></i></div><div class="font-bold text-slate-700">لا توجد عمليات إدارية على هذا الحساب</div></div>
                }
                else
                {
                    <ul class="divide-y divide-line">
                        @foreach (var a in m.Audit)
                        {
                            <li class="px-5 py-3.5">
                                <div class="flex items-center justify-between gap-3 flex-wrap">
                                    <span class="badge @DisplayLabels.ActionBadge(a.Action)">@DisplayLabels.Action(a.Action)</span>
                                    <span class="text-xs text-slate-400 num">@Local(a.Date) • @a.By</span>
                                </div>
                                <div class="text-sm text-slate-600 mt-1.5">@a.Details</div>
                            </li>
                        }
                    </ul>
                }
            </section>
    </div>
</div>

<partial name="_CustomerModals" />

<div id="image-modal" class="hidden modal-overlay">
    <div class="modal-box max-w-2xl">
        <div class="modal-header">
            <h3 id="img-title" class="font-bold text-slate-900"></h3>
            <button type="button" onclick="MM.closeModal('image-modal')" class="btn-icon" aria-label="إغلاق"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>
        <div class="modal-body bg-slate-50 flex justify-center">
            <img id="img-src" alt="صورة الفاتورة" class="max-h-[70vh] rounded-xl object-contain" />
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/customers.js" asp-append-version="true"></script>
<script>
    const customer = @Html.Raw(customerJson);

    function showTab(key) {
        document.querySelectorAll('[data-tab]').forEach(b => b.classList.toggle('tab-active', b.dataset.tab === key));
        document.querySelectorAll('[data-panel]').forEach(p => p.classList.toggle('hidden', p.dataset.panel !== key));
        history.replaceState(null, '', '#' + key);
    }
    if (location.hash && document.querySelector(`[data-tab="${location.hash.slice(1)}"]`)) showTab(location.hash.slice(1));

    function previewImage(url, title) {
        document.getElementById('img-src').src = url;
        document.getElementById('img-title').textContent = 'فاتورة ' + title;
        MM.openModal('image-modal');
    }

    async function copyText(text) {
        if (!text) return;
        try { await navigator.clipboard.writeText(text); showToast('تم نسخ رقم العضوية.', 'success'); } catch { }
    }
</script>
}
