@model MMApplication.Api.ViewModels.StaffPageViewModel
@using MMApplication.Domain.Enums
@{
    Layout = "_Layout";
    ViewData["Title"] = "طاقم العمل";
    ViewData["ActiveTab"] = "staff";
    var totalStaff = Model.StaffMembers.Count;
    var adminCount = Model.StaffMembers.Count(s => s.StaffRole == StaffRole.SuperAdmin);
    var auditorCount = Model.StaffMembers.Count(s => s.StaffRole == StaffRole.Auditor);
    var merchantCount = Model.StaffMembers.Count(s => s.StaffRole == StaffRole.StoreManager || s.StaffRole == StaffRole.Cashier);
}

<div class="space-y-6">

    <!-- 1. Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">طاقم العمل</h1>
            <p class="page-subtitle">حسابات الموظفين وصلاحياتهم</p>
        </div>
        <div class="page-actions">
            <button onclick="exportStaffCsv()" class="btn-secondary" @(totalStaff == 0 ? "disabled" : "")>
                <i data-lucide="download" class="w-4 h-4 text-slate-500"></i>
                <span>تصدير القائمة</span>
            </button>
            <button onclick="openModal('modal-add-staff')" class="btn-primary">
                <i data-lucide="user-plus" class="w-4 h-4"></i>
                <span>إضافة مستخدم جديد</span>
            </button>
        </div>
    </div>

    <!-- 2. KPI Metrics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-sm font-medium text-slate-500">إجمالي الحسابات</span>
                <i data-lucide="users" class="w-4 h-4 text-slate-500"></i>
            </div>
            <div class="text-2xl font-bold text-slate-900 num">@totalStaff</div>
            <div class="text-xs text-emerald-700 mt-1 font-medium">@Model.StaffMembers.Count(x => x.IsActive) نشط</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-sm font-medium text-slate-500">مسؤولو النظام</span>
                <i data-lucide="shield" class="w-4 h-4 text-purple-600"></i>
            </div>
            <div class="text-2xl font-bold text-purple-600 num">@adminCount</div>
            <div class="text-xs text-purple-700 mt-1 font-medium">المدير العام</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-sm font-medium text-slate-500">مدققو الفواتير</span>
                <i data-lucide="check-square" class="w-4 h-4 text-brand-500"></i>
            </div>
            <div class="text-2xl font-bold text-brand-600 num">@auditorCount</div>
            <div class="text-xs text-slate-400 mt-1">مراجعة الفواتير</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-sm font-medium text-slate-500">موظفو المتاجر</span>
                <i data-lucide="store" class="w-4 h-4 text-amber-500"></i>
            </div>
            <div class="text-2xl font-bold text-amber-600 num">@merchantCount</div>
            <div class="text-xs text-slate-400 mt-1">مديرو المتاجر والكاشير</div>
        </div>
    </div>

    <!-- 3. Staff Directory Table -->
    <div class="card overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-white">
            <div>
                <h3 class="text-base font-bold text-slate-900">دليل مستخدمي النظام والموظفين</h3>
                <p class="text-sm text-slate-500 mt-0.5">توزيع صلاحيات المسؤولين، مدققي الفواتير، ومديري وكاشير المتاجر في المول</p>
            </div>

        </div>

        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>اسم الموظف</th>
                        <th>الهاتف المسجل</th>
                        <th>المسمى الوظيفي والدور</th>
                        <th>المتجر المرتبط</th>
                        <th>الحالة</th>
                        <th>تاريخ الإنشاء</th>
                        <th class="text-left">الإجراءات</th>
                    </tr>
                </thead>
                <tbody id="staff-tbody">
                    @if (Model.StaffMembers.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-12 text-slate-400">
                                <div class="w-12 h-12 rounded-full bg-slate-50 text-slate-400 flex items-center justify-center mx-auto mb-2">
                                    <i data-lucide="user-x" class="w-6 h-6"></i>
                                </div>
                                <div class="font-bold text-slate-700">لا يوجد موظفون مسجلون حالياً</div>
                                <p class="text-xs text-slate-400 mt-1">أضف حسابات جديدة لتوزيع الصلاحيات التشغيلية</p>
                            </td>
                        </tr>
                    }
                    @foreach (var s in Model.StaffMembers)
                    {
                        <tr data-name="@s.FullName" data-phone="@s.PhoneNumber" data-role="@s.StaffRoleLabel" data-store="@(s.StoreName ?? "إدارة المول المركزية")" data-active="@(s.IsActive ? "نشط" : "معطل")" data-created="@s.CreatedAt.ToString("yyyy-MM-dd")" class="@(s.IsActive ? "" : "opacity-60")">
                            <td>
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-700 border border-slate-200 flex items-center justify-center font-bold text-xs shrink-0">
                                        @(string.IsNullOrWhiteSpace(s.FullName) ? "م" : s.FullName.Substring(0, 1))
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-900">@s.FullName @if (s.IsCurrentUser) { <span class="badge badge-slate mr-1">أنت</span> }</div>
                                    </div>
                                </div>
                            </td>
                            <td class="num font-semibold text-slate-700" dir="ltr">@s.PhoneNumber</td>
                            <td>
                                @switch (s.StaffRole)
                                {
                                    case StaffRole.SuperAdmin:
                                        <span class="badge badge-purple">
                                            <i data-lucide="shield" class="w-3 h-3"></i> مسؤول نظام
                                        </span>
                                        break;
                                    case StaffRole.Auditor:
                                        <span class="badge badge-blue">
                                            <i data-lucide="check-square" class="w-3 h-3"></i> مدقق فواتير
                                        </span>
                                        break;
                                    case StaffRole.StoreManager:
                                        <span class="badge badge-amber">
                                            <i data-lucide="store" class="w-3 h-3"></i> مدير متجر
                                        </span>
                                        break;
                                    case StaffRole.Cashier:
                                        <span class="badge badge-slate">
                                            <i data-lucide="calculator" class="w-3 h-3"></i> كاشير
                                        </span>
                                        break;
                                    default:
                                        <span class="badge badge-slate">@(s.StaffRoleLabel ?? s.Role.ToString())</span>
                                        break;
                                }
                            </td>
                            <td>
                                <div class="flex items-center gap-1.5 text-slate-700 font-medium text-xs">
                                    <i data-lucide="@(string.IsNullOrEmpty(s.StoreName) ? "building-2" : "shopping-bag")" class="w-3.5 h-3.5 text-slate-400"></i>
                                    <span>@(s.StoreName ?? "إدارة المول المركزية")</span>
                                </div>
                            </td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge badge-emerald">نشط</span>
                                }
                                else
                                {
                                    <span class="badge badge-rose">معطل</span>
                                }
                            </td>
                            <td class="text-slate-500 text-xs num">@s.CreatedAt.ToString("yyyy/MM/dd")</td>
                            <td class="text-left">
                                <div class="flex items-center gap-1 justify-end">
                                    <button type="button" onclick="openEditStaffModal(this)"
                                            data-id="@s.Id" data-name="@s.FullName" data-phone="@s.PhoneNumber"
                                            data-role="@(s.StaffRole?.ToString() ?? "Auditor")" data-store="@(s.StoreTenantId ?? "")"
                                            title="تعديل البيانات أو كلمة المرور" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition">
                                        <i data-lucide="edit-3" class="w-4 h-4"></i>
                                    </button>
                                    @if (!s.IsCurrentUser)
                                    {
                                        <button type="button" onclick="toggleActiveStaff(this)" data-id="@s.Id" data-name="@s.FullName" data-active="@(s.IsActive ? "1" : "0")"
                                                title="@(s.IsActive ? "تعطيل الحساب" : "تفعيل الحساب")" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition">
                                            <i data-lucide="@(s.IsActive ? "power-off" : "power")" class="w-4 h-4"></i>
                                        </button>
                                        <button type="button" onclick="deleteStaff(this)" data-id="@s.Id" data-name="@s.FullName"
                                                title="حذف الحساب" class="p-1.5 rounded-lg text-rose-500 hover:text-rose-700 hover:bg-rose-50 transition">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- ======================================================== -->
<!-- MODALS -->
<!-- ======================================================== -->

<!-- Modal: Add Staff Member -->
<div id="modal-add-staff" class="hidden modal-overlay">
    <div class="modal-box max-w-md">
        <div class="modal-header">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                <i data-lucide="user-plus" class="w-4 h-4 text-purple-600"></i>
                <span>إضافة موظف وتحديد الدور والصلاحيات</span>
            </h3>
            <button onclick="closeModal('modal-add-staff')" class="text-slate-400 hover:text-slate-700"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>

        <div class="modal-body space-y-3.5">
            <div>
                <label class="form-label">الاسم الكامل:</label>
                <input type="text" id="staff-name" placeholder="مثال: سارة المنصوري" class="form-input">
            </div>
            <div>
                <label class="form-label">رقم الهاتف:</label>
                <input type="text" id="staff-phone" placeholder="مثال: 0910003344" class="form-input num">
            </div>
            <div>
                <label class="form-label">كلمة المرور:</label>
                <div class="flex gap-2">
                    <input type="text" id="staff-pass" dir="ltr" autocomplete="new-password" placeholder="8 أحرف على الأقل" class="form-input num flex-1">
                    <button type="button" onclick="fillPassword('staff-pass')" class="btn-secondary shrink-0" title="توليد كلمة مرور قوية">
                        <i data-lucide="wand-sparkles" class="w-4 h-4"></i><span>توليد</span>
                    </button>
                </div>
                <p class="text-sm text-slate-500 mt-1">انسخها وسلّمها للموظف؛ لن تظهر مرة أخرى.</p>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="form-label">الدور الوظيفي:</label>
                    <select id="staff-role" class="form-select" onchange="syncStoreField('staff')">
                        <option value="Auditor">مدقق فواتير</option>
                        <option value="StoreManager">مدير متجر</option>
                        <option value="Cashier">كاشير متجر</option>
                        <option value="SuperAdmin">مسؤول نظام</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">المتجر التابع له:</label>
                    <select id="staff-store" class="form-select">
                        <option value="">إدارة المول المركزية</option>
                        @foreach (var st in Model.Stores)
                        {
                            <option value="@st.Id">@st.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button onclick="closeModal('modal-add-staff')" class="btn-secondary">إلغاء</button>
            <button onclick="submitCreateStaff()" class="btn-primary">إنشاء وتفعيل الحساب</button>
        </div>
    </div>
</div>

<!-- Modal: Edit Staff Member -->
<div id="modal-edit-staff" class="hidden modal-overlay">
    <div class="modal-box max-w-md">
        <div class="modal-header">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                <i data-lucide="edit-3" class="w-4 h-4 text-purple-600"></i>
                <span>تعديل بيانات وصلاحيات الموظف</span>
            </h3>
            <button onclick="closeModal('modal-edit-staff')" class="text-slate-400 hover:text-slate-700"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>

        <input type="hidden" id="edit-staff-id" />

        <div class="modal-body space-y-3.5">
            <div>
                <label class="form-label">الاسم الكامل:</label>
                <input type="text" id="edit-staff-name" class="form-input">
            </div>
            <div>
                <label class="form-label">رقم الهاتف:</label>
                <input type="text" id="edit-staff-phone" class="form-input num">
            </div>
            <div>
                <label class="form-label">كلمة مرور جديدة:</label>
                <div class="flex gap-2">
                    <input type="text" id="edit-staff-pass" dir="ltr" autocomplete="new-password" placeholder="اتركه فارغاً للإبقاء على الحالية" class="form-input num flex-1">
                    <button type="button" onclick="fillPassword('edit-staff-pass')" class="btn-secondary shrink-0" title="توليد كلمة مرور قوية">
                        <i data-lucide="wand-sparkles" class="w-4 h-4"></i><span>توليد</span>
                    </button>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="form-label">الدور الوظيفي:</label>
                    <select id="edit-staff-role" class="form-select" onchange="syncStoreField('edit-staff')">
                        <option value="Auditor">مدقق فواتير</option>
                        <option value="StoreManager">مدير متجر</option>
                        <option value="Cashier">كاشير متجر</option>
                        <option value="SuperAdmin">مسؤول نظام</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">المتجر التابع له:</label>
                    <select id="edit-staff-store" class="form-select">
                        <option value="">إدارة المول المركزية</option>
                        @foreach (var st in Model.Stores)
                        {
                            <option value="@st.Id">@st.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button onclick="closeModal('modal-edit-staff')" class="btn-secondary">إلغاء</button>
            <button onclick="submitEditStaff()" class="btn-primary">حفظ التعديلات</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const NEEDS_STORE = ['StoreManager', 'Cashier'];
    const esc = v => String(v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    function syncStoreField(prefix) {
        const role = document.getElementById(prefix + '-role').value;
        const store = document.getElementById(prefix + '-store');
        const needs = NEEDS_STORE.includes(role);
        store.disabled = !needs;
        if (!needs) store.value = '';
    }

    function generatePassword() {
        const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';
        const bytes = crypto.getRandomValues(new Uint32Array(10));
        let out = '';
        bytes.forEach(b => out += chars[b % chars.length]);
        return out.slice(0, 5) + '-' + out.slice(5);
    }

    function fillPassword(inputId) {
        const input = document.getElementById(inputId);
        input.value = generatePassword();
        input.select();
        navigator.clipboard?.writeText(input.value).then(() => showToast('تم توليد كلمة المرور ونسخها.', 'success')).catch(() => {});
    }

    async function staffRequest(url, method, body) {
        const res = await fetch(url, {
            method,
            headers: body ? { 'Content-Type': 'application/json' } : {},
            body: body ? JSON.stringify(body) : undefined
        });
        let data = {};
        try { data = await res.json(); } catch { }
        if (res.status === 403) throw new Error('هذه العملية متاحة للمدير العام فقط.');
        if (!res.ok || data.success === false) throw new Error(data.message || 'تعذّر تنفيذ العملية.');
        return data;
    }

    function readForm(prefix) {
        return {
            fullName: document.getElementById(prefix + '-name').value.trim(),
            phoneNumber: document.getElementById(prefix + '-phone').value.trim(),
            password: document.getElementById(prefix + '-pass').value.trim(),
            staffRole: document.getElementById(prefix + '-role').value,
            storeTenantId: document.getElementById(prefix + '-store').value || null
        };
    }

    function validateForm(f, passwordRequired) {
        if (f.fullName.length < 3 || f.phoneNumber.length < 6) return 'أدخل الاسم الكامل ورقم الهاتف بشكل صحيح.';
        if ((passwordRequired || f.password) && f.password.length < 8) return 'كلمة المرور يجب ألا تقل عن 8 أحرف.';
        if (NEEDS_STORE.includes(f.staffRole) && !f.storeTenantId) return 'اختر المتجر الذي يتبع له الموظف.';
        return null;
    }

    async function submitCreateStaff() {
        const f = readForm('staff');
        const error = validateForm(f, true);
        if (error) { showToast(error, 'warning'); return; }
        try {
            await staffRequest('/api/superadmin/staff', 'POST', f);
            closeModal('modal-add-staff');
            await Swal.fire({
                icon: 'success',
                title: 'تم إنشاء الحساب',
                html: `سلّم الموظف بيانات الدخول:<br><br>رقم الهاتف: <b dir="ltr">${esc(f.phoneNumber)}</b><br>كلمة المرور: <b dir="ltr">${esc(f.password)}</b><br><br><small>رابط الدخول: ${location.origin}/AdminDashboard/Login</small>`,
                confirmButtonText: 'تم'
            });
            location.reload();
        } catch (err) {
            showToast(err.message, 'error');
        }
    }

    function openEditStaffModal(btn) {
        const d = btn.dataset;
        document.getElementById('edit-staff-id').value = d.id;
        document.getElementById('edit-staff-name').value = d.name;
        document.getElementById('edit-staff-phone').value = d.phone === '-' ? '' : d.phone;
        document.getElementById('edit-staff-role').value = d.role;
        document.getElementById('edit-staff-store').value = d.store || '';
        document.getElementById('edit-staff-pass').value = '';
        syncStoreField('edit-staff');
        openModal('modal-edit-staff');
    }

    async function submitEditStaff() {
        const id = document.getElementById('edit-staff-id').value;
        const f = readForm('edit-staff');
        const error = validateForm(f, false);
        if (error) { showToast(error, 'warning'); return; }
        try {
            await staffRequest(`/api/superadmin/staff/${encodeURIComponent(id)}`, 'PUT', { ...f, password: f.password || null });
            showToast('تم تحديث بيانات الموظف.', 'success');
            closeModal('modal-edit-staff');
            setTimeout(() => location.reload(), 600);
        } catch (err) {
            showToast(err.message, 'error');
        }
    }

    async function toggleActiveStaff(btn) {
        const { id, name, active } = btn.dataset;
        const disabling = active === '1';
        const result = await Swal.fire({
            title: disabling ? 'تعطيل الحساب' : 'تفعيل الحساب',
            text: disabling ? `لن يتمكن (${name}) من دخول المنصة حتى تعيد تفعيله.` : `سيتمكن (${name}) من دخول المنصة مجدداً.`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: disabling ? 'تعطيل' : 'تفعيل',
            cancelButtonText: 'إلغاء'
        });
        if (!result.isConfirmed) return;
        try {
            const data = await staffRequest(`/api/superadmin/staff/${encodeURIComponent(id)}/toggle-active`, 'POST');
            showToast(data.message, 'success');
            setTimeout(() => location.reload(), 600);
        } catch (err) {
            showToast(err.message, 'error');
        }
    }

    async function deleteStaff(btn) {
        const { id, name } = btn.dataset;
        const result = await Swal.fire({
            title: 'حذف الحساب',
            text: `حذف حساب (${name}) نهائياً؟ يمكنك تعطيله بدلاً من الحذف.`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'نعم، احذف',
            cancelButtonText: 'إلغاء',
            customClass: { confirmButton: 'btn-danger', cancelButton: 'btn-secondary' }
        });
        if (!result.isConfirmed) return;
        try {
            await staffRequest(`/api/superadmin/staff/${encodeURIComponent(id)}`, 'DELETE');
            showToast('تم حذف الحساب.', 'info');
            setTimeout(() => location.reload(), 600);
        } catch (err) {
            showToast(err.message, 'error');
        }
    }

    function exportStaffCsv() {
        const rows = [...document.querySelectorAll('#staff-tbody tr[data-name]')];
        const header = ['الاسم', 'الهاتف', 'الدور', 'المتجر', 'الحالة', 'تاريخ الإنشاء'];
        const cell = v => `"${String(v ?? '').replace(/"/g, '""')}"`;
        const lines = [header, ...rows.map(r => [r.dataset.name, r.dataset.phone, r.dataset.role, r.dataset.store, r.dataset.active, r.dataset.created])]
            .map(cols => cols.map(cell).join(','));
        const blob = new Blob(['﻿' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' });
        const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(blob), download: `staff-${new Date().toISOString().slice(0, 10)}.csv` });
        a.click();
        URL.revokeObjectURL(a.href);
    }

    syncStoreField('staff');
</script>
}
