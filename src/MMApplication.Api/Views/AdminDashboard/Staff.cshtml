@model MMApplication.Api.ViewModels.StaffPageViewModel
@using MMApplication.Domain.Enums
@{
    Layout = "_Layout";
    ViewData["Title"] = "طاقم العمل والصلاحيات";
    ViewData["ActiveTab"] = "staff";
    var staff = Model.StaffMembers;
    var now = DateTime.UtcNow;
    int CountRole(StaffRole r) => staff.Count(s => s.StaffRole == r);
    var activeCount = staff.Count(s => s.IsActive);
    var lockedCount = staff.Count(s => s.LockedUntil.HasValue);
    var neverLogged = staff.Count(s => s.IsActive && !s.LastLoginAt.HasValue);
    string Ago(DateTime? d)
    {
        if (!d.HasValue) return "لم يدخل بعد";
        var span = now - d.Value;
        if (span.TotalMinutes < 2) return "الآن";
        if (span.TotalHours < 1) return $"منذ {(int)span.TotalMinutes} دقيقة";
        if (span.TotalDays < 1) return $"منذ {(int)span.TotalHours} ساعة";
        if (span.TotalDays < 30) return $"منذ {(int)span.TotalDays} يوم";
        return d.Value.ToLocalTime().ToString("yyyy/MM/dd");
    }
    var roles = new[]
    {
        (StaffRole.SuperAdmin, "المدير العام", "shield", "badge-purple", "صلاحيات كاملة على المنظومة وإدارة الحسابات"),
        (StaffRole.Auditor, "مدقق الفواتير", "scan-search", "badge-brand", "مراجعة الفواتير ومكافحة الاحتيال وخدمة العملاء"),
        (StaffRole.StoreManager, "مدير متجر", "store", "badge-amber", "بيانات متجره ومبيعاته وقواعد نقاطه فقط"),
        (StaffRole.Cashier, "كاشير", "calculator", "badge-slate", "التحقق من قسائم العملاء وفواتير متجره"),
    };
    var rolePerms = ViewData["RolePermissions"] as Dictionary<string, HashSet<string>> ?? new();
    var actorIsSuper = ViewData["ActorIsSuperAdmin"] as bool? ?? false;
    var editableRoles = new[] { ("FRAUD_AUDITOR", "مدقق الفواتير"), ("STORE_MANAGER", "مدير متجر"), ("CASHIER", "كاشير") };
}
@Html.AntiForgeryToken()

<div class="space-y-5">

    <div class="page-header">
        <div>
            <h1 class="page-title">طاقم العمل والصلاحيات</h1>
            <p class="page-subtitle">حسابات الموظفين، أدوارهم، وما يستطيع كل دور فعله في المنظومة</p>
        </div>
        <div class="page-actions">
            <button onclick="exportStaffCsv()" class="btn-secondary" @(staff.Count == 0 ? "disabled" : "")><i data-lucide="download" class="w-4 h-4"></i> تصدير</button>
            <button onclick="openModal('modal-add-staff')" class="btn-primary"><i data-lucide="user-plus" class="w-4 h-4"></i> موظف جديد</button>
        </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="stat-card">
            <div class="flex items-center justify-between"><span class="stat-label">الحسابات</span><span class="stat-icon bg-brand-50 text-brand-600"><i data-lucide="users" class="w-5 h-5"></i></span></div>
            <div class="stat-value num">@staff.Count</div>
            <div class="stat-meta"><span class="num">@activeCount</span> نشط • <span class="num">@(staff.Count - activeCount)</span> معطل</div>
        </div>
        <div class="stat-card">
            <div class="flex items-center justify-between"><span class="stat-label">الإدارة</span><span class="stat-icon bg-purple-50 text-purple-600"><i data-lucide="shield" class="w-5 h-5"></i></span></div>
            <div class="stat-value num">@(CountRole(StaffRole.SuperAdmin) + CountRole(StaffRole.Auditor))</div>
            <div class="stat-meta">مدير عام <span class="num">@CountRole(StaffRole.SuperAdmin)</span> • مدقق <span class="num">@CountRole(StaffRole.Auditor)</span></div>
        </div>
        <div class="stat-card">
            <div class="flex items-center justify-between"><span class="stat-label">موظفو المتاجر</span><span class="stat-icon bg-amber-50 text-amber-600"><i data-lucide="store" class="w-5 h-5"></i></span></div>
            <div class="stat-value num">@(CountRole(StaffRole.StoreManager) + CountRole(StaffRole.Cashier))</div>
            <div class="stat-meta">مدير متجر <span class="num">@CountRole(StaffRole.StoreManager)</span> • كاشير <span class="num">@CountRole(StaffRole.Cashier)</span></div>
        </div>
        <div class="stat-card">
            <div class="flex items-center justify-between"><span class="stat-label">تنبيهات أمنية</span><span class="stat-icon bg-rose-50 text-rose-600"><i data-lucide="shield-alert" class="w-5 h-5"></i></span></div>
            <div class="stat-value num @(lockedCount > 0 ? "text-rose-600" : "")">@lockedCount</div>
            <div class="stat-meta">حساب مقفل مؤقتاً • <span class="num">@neverLogged</span> لم يدخل بعد</div>
        </div>
    </div>

    <div class="tabs w-fit max-w-full" role="tablist">
        <button type="button" class="tab tab-active" data-tab="staff" onclick="showTab('staff')"><i data-lucide="users" class="w-4 h-4"></i> الموظفون <span class="text-xs text-slate-400 num">@staff.Count</span></button>
        <button type="button" class="tab" data-tab="roles" onclick="showTab('roles')"><i data-lucide="key-square" class="w-4 h-4"></i> الأدوار والصلاحيات</button>
    </div>

    <!-- الموظفون -->
    <section data-panel="staff" class="card overflow-hidden">
        <div class="p-4 border-b border-line flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <input type="search" id="sq" oninput="filterStaff()" placeholder="ابحث بالاسم أو الهاتف أو المتجر" class="form-input pr-9">
                <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2"></i>
            </div>
            <select id="sr" onchange="filterStaff()" class="form-select sm:w-48">
                <option value="">كل الأدوار</option>
                @foreach (var r in roles) { <option value="@r.Item1">@r.Item2</option> }
            </select>
            <select id="ss" onchange="filterStaff()" class="form-select sm:w-40">
                <option value="">كل الحالات</option>
                <option value="active">نشط</option>
                <option value="inactive">معطل</option>
                <option value="locked">مقفل مؤقتاً</option>
            </select>
        </div>
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr><th>الموظف</th><th>الدور</th><th>المتجر</th><th>آخر دخول</th><th>الحالة</th><th class="text-left"></th></tr>
                </thead>
                <tbody id="staff-tbody">
                    @if (staff.Count == 0)
                    {
                        <tr><td colspan="6"><div class="empty-state"><div class="empty-state-icon"><i data-lucide="user-x" class="w-6 h-6"></i></div><div class="font-bold text-slate-700">لا يوجد موظفون بعد</div></div></td></tr>
                    }
                    @foreach (var s in staff)
                    {
                        var role = roles.FirstOrDefault(r => r.Item1 == s.StaffRole);
                        var statusKey = s.LockedUntil.HasValue ? "locked" : s.IsActive ? "active" : "inactive";
                        <tr data-name="@s.FullName" data-phone="@s.PhoneNumber" data-role="@(role.Item2 ?? s.StaffRoleLabel)" data-rolekey="@s.StaffRole" data-status="@statusKey"
                            data-store="@(s.StoreName ?? "إدارة المول")" data-active="@(s.IsActive ? "نشط" : "معطل")" data-created="@s.CreatedAt.ToString("yyyy-MM-dd")"
                            data-lastlogin="@(s.LastLoginAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "")"
                            data-text="@($"{s.FullName} {s.PhoneNumber} {s.StoreName}".ToLowerInvariant())" class="@(s.IsActive ? "" : "opacity-60")">
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-700 font-bold flex items-center justify-center shrink-0">@(string.IsNullOrWhiteSpace(s.FullName) ? "م" : s.FullName.Trim()[..1])</div>
                                    <div class="min-w-0">
                                        <div class="font-bold text-slate-900 flex items-center gap-1.5">@s.FullName @if (s.IsCurrentUser) { <span class="badge badge-slate !py-0.5">أنت</span> }</div>
                                        <div class="text-xs text-slate-500 num" dir="ltr">@s.PhoneNumber</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge @(role.Item4 ?? "badge-slate")"><i data-lucide="@(role.Item3 ?? "user")" class="w-3 h-3"></i> @(role.Item2 ?? s.StaffRoleLabel)</span></td>
                            <td class="text-sm text-slate-700">
                                <span class="inline-flex items-center gap-1.5"><i data-lucide="@(s.StoreTenantId == null ? "building-2" : "store")" class="w-3.5 h-3.5 text-slate-400"></i>@(s.StoreTenantId == null ? "إدارة المول" : s.StoreName)</span>
                            </td>
                            <td class="text-sm whitespace-nowrap @(s.LastLoginAt.HasValue ? "text-slate-700" : "text-slate-400")" title="@(s.LastLoginAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm"))">@Ago(s.LastLoginAt)</td>
                            <td>
                                @if (s.LockedUntil.HasValue) { <span class="badge badge-rose" title="حتى @s.LockedUntil.Value.ToLocalTime().ToString("HH:mm")"><i data-lucide="lock" class="w-3 h-3"></i> مقفل مؤقتاً</span> }
                                else if (s.IsActive) { <span class="badge badge-emerald">نشط</span> }
                                else { <span class="badge badge-slate">معطل</span> }
                            </td>
                            <td class="text-left">
                                <div class="relative inline-block">
                                    <button type="button" class="btn-icon !w-8 !h-8" onclick="MM.dropdown('s-@s.Id')" aria-haspopup="menu" aria-label="إجراءات"><i data-lucide="ellipsis" class="w-4 h-4"></i></button>
                                    <div id="s-@s.Id" class="dropdown left-0 hidden text-right" role="menu">
                                        <button type="button" class="dropdown-item" onclick="openEditStaffModal(this)"
                                                data-id="@s.Id" data-name="@s.FullName" data-phone="@s.PhoneNumber"
                                                data-role="@(s.StaffRole?.ToString() ?? "Auditor")" data-store="@(s.StoreTenantId ?? "")"><i data-lucide="pencil" class="w-4 h-4"></i> تعديل البيانات والدور</button>
                                        <button type="button" class="dropdown-item" onclick="resetStaffPassword(this)" data-id="@s.Id" data-name="@s.FullName" data-phone="@s.PhoneNumber"><i data-lucide="key-round" class="w-4 h-4"></i> كلمة مرور جديدة@(s.LockedUntil.HasValue ? " وفك القفل" : "")</button>
                                        <a class="dropdown-item" href="/AdminDashboard/Settings?tab=audit&amp;search=@Uri.EscapeDataString(s.FullName)"><i data-lucide="history" class="w-4 h-4"></i> سجل عملياته</a>
                                        @if (!s.IsCurrentUser)
                                        {
                                            <button type="button" class="dropdown-item" onclick="toggleActiveStaff(this)" data-id="@s.Id" data-name="@s.FullName" data-active="@(s.IsActive ? "1" : "0")"><i data-lucide="@(s.IsActive ? "power-off" : "power")" class="w-4 h-4"></i> @(s.IsActive ? "تعطيل الحساب" : "تفعيل الحساب")</button>
                                            <div class="my-1 border-t border-line"></div>
                                            <button type="button" class="dropdown-item !text-rose-600" onclick="deleteStaff(this)" data-id="@s.Id" data-name="@s.FullName"><i data-lucide="trash-2" class="w-4 h-4"></i> حذف الحساب</button>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="p-4 border-t border-line text-sm text-slate-500 flex items-center gap-2">
            <i data-lucide="info" class="w-4 h-4 shrink-0"></i>
            يُقفل حساب الموظف <span class="num">15</span> دقيقة تلقائياً بعد <span class="num">5</span> محاولات دخول خاطئة. كلمة المرور الجديدة تفك القفل فوراً.
        </div>
    </section>

    <!-- الأدوار والصلاحيات -->
    <section data-panel="roles" class="space-y-4 hidden">
        <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4">
            @foreach (var r in roles)
            {
                <div class="card p-5">
                    <div class="flex items-center justify-between">
                        <span class="badge @r.Item4"><i data-lucide="@r.Item3" class="w-3 h-3"></i> @r.Item2</span>
                        <span class="text-sm text-slate-500"><span class="num font-bold text-slate-900">@CountRole(r.Item1)</span> حساب</span>
                    </div>
                    <p class="mt-3 text-sm text-slate-600 leading-relaxed">@r.Item5</p>
                </div>
            }
        </div>

        <div class="card overflow-hidden" id="perm-card">
            <div class="card-header flex-wrap">
                <div>
                    <h3 class="card-title">مصفوفة الصلاحيات</h3>
                    <p class="card-subtitle">@(actorIsSuper ? "فعّل أو ألغِ أي صلاحية لأي دور ثم اضغط حفظ. التغيير يطبَّق فوراً على كل موظفي الدور." : "ما يستطيع كل دور فعله. التعديل للمدير العام فقط.")</p>
                </div>
                @if (actorIsSuper)
                {
                    <div class="flex items-center gap-2">
                        <span id="perm-dirty" class="hidden badge badge-amber">تغييرات غير محفوظة</span>
                        <button type="button" id="perm-save" onclick="savePermissions()" class="btn-primary" disabled><i data-lucide="save" class="w-4 h-4"></i> حفظ الصلاحيات</button>
                    </div>
                }
            </div>
            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>الصلاحية</th>
                            <th class="text-center whitespace-nowrap">المدير العام</th>
                            @foreach (var (key, label) in editableRoles)
                            {
                                <th class="text-center whitespace-nowrap">
                                    @label
                                    @if (actorIsSuper)
                                    {
                                        <button type="button" class="block mx-auto mt-1 text-xs font-normal text-brand-700 hover:underline" onclick="resetRole('@key', '@label')">الافتراضي</button>
                                    }
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in MMApplication.Infrastructure.Security.Permissions.All.GroupBy(p => p.Group))
                        {
                            <tr class="bg-slate-50"><td colspan="5" class="!py-2 text-xs font-bold text-slate-500">@group.Key</td></tr>
                            @foreach (var perm in group)
                            {
                                <tr>
                                    <td>
                                        <div class="font-semibold text-slate-800">@perm.Label</div>
                                        <div class="text-xs text-slate-500">@perm.Hint</div>
                                    </td>
                                    <td class="text-center"><span class="inline-flex w-7 h-7 rounded-full bg-emerald-50 text-emerald-600 items-center justify-center" title="المدير العام يملك كل الصلاحيات دائماً"><i data-lucide="check" class="w-4 h-4"></i></span></td>
                                    @foreach (var (key, _) in editableRoles)
                                    {
                                        var on = rolePerms.TryGetValue(key, out var set) && set.Contains(perm.Key);
                                        <td class="text-center">
                                            <input type="checkbox" class="perm-box form-check !w-5 !h-5 cursor-pointer disabled:cursor-default" data-role="@key" data-perm="@perm.Key"
                                                   @(on ? "checked" : "") @(actorIsSuper ? "" : "disabled") onchange="markDirty()" aria-label="@perm.Label" />
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-4 border-t border-line text-sm text-slate-500 space-y-1">
                <p>المدير العام يملك كل الصلاحيات دائماً حتى لا يُقفل النظام. موظفو المتاجر (مدير المتجر والكاشير) يرون بيانات متجرهم فقط مهما كانت صلاحياتهم.</p>
                <p>كل تعديل على الصلاحيات يُسجَّل في سجل العمليات باسم من نفّذه.</p>
            </div>
        </div>
    </section>
</div>

<!-- ======================================================== -->
<!-- MODALS -->
<!-- ======================================================== -->

<!-- Modal: Add Staff Member -->
<div id="modal-add-staff" class="hidden modal-overlay">
    <div class="modal-box max-w-md">
        <div class="modal-header">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                <i data-lucide="user-plus" class="w-4 h-4 text-purple-600"></i>
                <span>إضافة موظف وتحديد الدور والصلاحيات</span>
            </h3>
            <button onclick="closeModal('modal-add-staff')" class="text-slate-400 hover:text-slate-700"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>

        <div class="modal-body space-y-3.5">
            <div>
                <label class="form-label">الاسم الكامل:</label>
                <input type="text" id="staff-name" placeholder="مثال: سارة المنصوري" class="form-input">
            </div>
            <div>
                <label class="form-label">رقم الهاتف:</label>
                <input type="text" id="staff-phone" placeholder="مثال: 0910003344" class="form-input num">
            </div>
            <div>
                <label class="form-label">كلمة المرور:</label>
                <div class="flex gap-2">
                    <input type="text" id="staff-pass" dir="ltr" autocomplete="new-password" placeholder="8 أحرف على الأقل" class="form-input num flex-1">
                    <button type="button" onclick="fillPassword('staff-pass')" class="btn-secondary shrink-0" title="توليد كلمة مرور قوية">
                        <i data-lucide="wand-sparkles" class="w-4 h-4"></i><span>توليد</span>
                    </button>
                </div>
                <p class="text-sm text-slate-500 mt-1">انسخها وسلّمها للموظف؛ لن تظهر مرة أخرى.</p>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="form-label">الدور الوظيفي:</label>
                    <select id="staff-role" class="form-select" onchange="syncStoreField('staff')">
                        <option value="Auditor">مدقق فواتير</option>
                        <option value="StoreManager">مدير متجر</option>
                        <option value="Cashier">كاشير متجر</option>
                        <option value="SuperAdmin">مسؤول نظام</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">المتجر التابع له:</label>
                    <select id="staff-store" class="form-select">
                        <option value="">إدارة المول المركزية</option>
                        @foreach (var st in Model.Stores)
                        {
                            <option value="@st.Id">@st.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button onclick="closeModal('modal-add-staff')" class="btn-secondary">إلغاء</button>
            <button onclick="submitCreateStaff()" class="btn-primary">إنشاء وتفعيل الحساب</button>
        </div>
    </div>
</div>

<!-- Modal: Edit Staff Member -->
<div id="modal-edit-staff" class="hidden modal-overlay">
    <div class="modal-box max-w-md">
        <div class="modal-header">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                <i data-lucide="edit-3" class="w-4 h-4 text-purple-600"></i>
                <span>تعديل بيانات وصلاحيات الموظف</span>
            </h3>
            <button onclick="closeModal('modal-edit-staff')" class="text-slate-400 hover:text-slate-700"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>

        <input type="hidden" id="edit-staff-id" />

        <div class="modal-body space-y-3.5">
            <div>
                <label class="form-label">الاسم الكامل:</label>
                <input type="text" id="edit-staff-name" class="form-input">
            </div>
            <div>
                <label class="form-label">رقم الهاتف:</label>
                <input type="text" id="edit-staff-phone" class="form-input num">
            </div>
            <div>
                <label class="form-label">كلمة مرور جديدة:</label>
                <div class="flex gap-2">
                    <input type="text" id="edit-staff-pass" dir="ltr" autocomplete="new-password" placeholder="اتركه فارغاً للإبقاء على الحالية" class="form-input num flex-1">
                    <button type="button" onclick="fillPassword('edit-staff-pass')" class="btn-secondary shrink-0" title="توليد كلمة مرور قوية">
                        <i data-lucide="wand-sparkles" class="w-4 h-4"></i><span>توليد</span>
                    </button>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="form-label">الدور الوظيفي:</label>
                    <select id="edit-staff-role" class="form-select" onchange="syncStoreField('edit-staff')">
                        <option value="Auditor">مدقق فواتير</option>
                        <option value="StoreManager">مدير متجر</option>
                        <option value="Cashier">كاشير متجر</option>
                        <option value="SuperAdmin">مسؤول نظام</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">المتجر التابع له:</label>
                    <select id="edit-staff-store" class="form-select">
                        <option value="">إدارة المول المركزية</option>
                        @foreach (var st in Model.Stores)
                        {
                            <option value="@st.Id">@st.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button onclick="closeModal('modal-edit-staff')" class="btn-secondary">إلغاء</button>
            <button onclick="submitEditStaff()" class="btn-primary">حفظ التعديلات</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const NEEDS_STORE = ['StoreManager', 'Cashier'];
    const esc = v => String(v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    function syncStoreField(prefix) {
        const role = document.getElementById(prefix + '-role').value;
        const store = document.getElementById(prefix + '-store');
        const needs = NEEDS_STORE.includes(role);
        store.disabled = !needs;
        if (!needs) store.value = '';
    }

    function generatePassword() {
        const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';
        const bytes = crypto.getRandomValues(new Uint32Array(10));
        let out = '';
        bytes.forEach(b => out += chars[b % chars.length]);
        return out.slice(0, 5) + '-' + out.slice(5);
    }

    function fillPassword(inputId) {
        const input = document.getElementById(inputId);
        input.value = generatePassword();
        input.select();
        navigator.clipboard?.writeText(input.value).then(() => showToast('تم توليد كلمة المرور ونسخها.', 'success')).catch(() => {});
    }

    async function staffRequest(url, method, body) {
        const res = await fetch(url, {
            method,
            headers: body ? { 'Content-Type': 'application/json' } : {},
            body: body ? JSON.stringify(body) : undefined
        });
        let data = {};
        try { data = await res.json(); } catch { }
        if (res.status === 403) throw new Error('هذه العملية متاحة للمدير العام فقط.');
        if (!res.ok || data.success === false) throw new Error(data.message || 'تعذّر تنفيذ العملية.');
        return data;
    }

    function readForm(prefix) {
        return {
            fullName: document.getElementById(prefix + '-name').value.trim(),
            phoneNumber: document.getElementById(prefix + '-phone').value.trim(),
            password: document.getElementById(prefix + '-pass').value.trim(),
            staffRole: document.getElementById(prefix + '-role').value,
            storeTenantId: document.getElementById(prefix + '-store').value || null
        };
    }

    function validateForm(f, passwordRequired) {
        if (f.fullName.length < 3 || f.phoneNumber.length < 6) return 'أدخل الاسم الكامل ورقم الهاتف بشكل صحيح.';
        if ((passwordRequired || f.password) && f.password.length < 8) return 'كلمة المرور يجب ألا تقل عن 8 أحرف.';
        if (NEEDS_STORE.includes(f.staffRole) && !f.storeTenantId) return 'اختر المتجر الذي يتبع له الموظف.';
        return null;
    }

    async function submitCreateStaff() {
        const f = readForm('staff');
        const error = validateForm(f, true);
        if (error) { showToast(error, 'warning'); return; }
        try {
            await staffRequest('/api/superadmin/staff', 'POST', f);
            closeModal('modal-add-staff');
            await Swal.fire({
                icon: 'success',
                title: 'تم إنشاء الحساب',
                html: `سلّم الموظف بيانات الدخول:<br><br>رقم الهاتف: <b dir="ltr">${esc(f.phoneNumber)}</b><br>كلمة المرور: <b dir="ltr">${esc(f.password)}</b><br><br><small>رابط الدخول: ${location.origin}/AdminDashboard/Login</small>`,
                confirmButtonText: 'تم'
            });
            location.reload();
        } catch (err) {
            showToast(err.message, 'error');
        }
    }

    function openEditStaffModal(btn) {
        const d = btn.dataset;
        document.getElementById('edit-staff-id').value = d.id;
        document.getElementById('edit-staff-name').value = d.name;
        document.getElementById('edit-staff-phone').value = d.phone === '-' ? '' : d.phone;
        document.getElementById('edit-staff-role').value = d.role;
        document.getElementById('edit-staff-store').value = d.store || '';
        document.getElementById('edit-staff-pass').value = '';
        syncStoreField('edit-staff');
        openModal('modal-edit-staff');
    }

    async function submitEditStaff() {
        const id = document.getElementById('edit-staff-id').value;
        const f = readForm('edit-staff');
        const error = validateForm(f, false);
        if (error) { showToast(error, 'warning'); return; }
        try {
            await staffRequest(`/api/superadmin/staff/${encodeURIComponent(id)}`, 'PUT', { ...f, password: f.password || null });
            showToast('تم تحديث بيانات الموظف.', 'success');
            closeModal('modal-edit-staff');
            setTimeout(() => location.reload(), 600);
        } catch (err) {
            showToast(err.message, 'error');
        }
    }

    async function toggleActiveStaff(btn) {
        const { id, name, active } = btn.dataset;
        const disabling = active === '1';
        const result = await Swal.fire({
            title: disabling ? 'تعطيل الحساب' : 'تفعيل الحساب',
            text: disabling ? `لن يتمكن (${name}) من دخول المنصة حتى تعيد تفعيله.` : `سيتمكن (${name}) من دخول المنصة مجدداً.`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: disabling ? 'تعطيل' : 'تفعيل',
            cancelButtonText: 'إلغاء'
        });
        if (!result.isConfirmed) return;
        try {
            const data = await staffRequest(`/api/superadmin/staff/${encodeURIComponent(id)}/toggle-active`, 'POST');
            showToast(data.message, 'success');
            setTimeout(() => location.reload(), 600);
        } catch (err) {
            showToast(err.message, 'error');
        }
    }

    async function deleteStaff(btn) {
        const { id, name } = btn.dataset;
        const result = await Swal.fire({
            title: 'حذف الحساب',
            text: `حذف حساب (${name}) نهائياً؟ يمكنك تعطيله بدلاً من الحذف.`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'نعم، احذف',
            cancelButtonText: 'إلغاء',
            customClass: { confirmButton: 'btn-danger', cancelButton: 'btn-secondary' }
        });
        if (!result.isConfirmed) return;
        try {
            await staffRequest(`/api/superadmin/staff/${encodeURIComponent(id)}`, 'DELETE');
            showToast('تم حذف الحساب.', 'info');
            setTimeout(() => location.reload(), 600);
        } catch (err) {
            showToast(err.message, 'error');
        }
    }

    function exportStaffCsv() {
        const rows = [...document.querySelectorAll('#staff-tbody tr[data-name]')];
        const header = ['الاسم', 'الهاتف', 'الدور', 'المتجر', 'الحالة', 'آخر دخول', 'تاريخ الإنشاء'];
        const cell = v => `"${String(v ?? '').replace(/"/g, '""')}"`;
        const lines = [header, ...rows.map(r => [r.dataset.name, r.dataset.phone, r.dataset.role, r.dataset.store, r.dataset.active, r.dataset.lastlogin, r.dataset.created])]
            .map(cols => cols.map(cell).join(','));
        const blob = new Blob(['﻿' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' });
        const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(blob), download: `staff-${new Date().toISOString().slice(0, 10)}.csv` });
        a.click();
        URL.revokeObjectURL(a.href);
    }

    function showTab(key) {
        document.querySelectorAll('[data-tab]').forEach(b => b.classList.toggle('tab-active', b.dataset.tab === key));
        document.querySelectorAll('[data-panel]').forEach(p => p.classList.toggle('hidden', p.dataset.panel !== key));
        history.replaceState(null, '', '#' + key);
    }
    if (location.hash === '#roles') showTab('roles');

    function filterStaff() {
        const q = document.getElementById('sq').value.trim().toLowerCase();
        const role = document.getElementById('sr').value;
        const st = document.getElementById('ss').value;
        document.querySelectorAll('#staff-tbody tr[data-name]').forEach(r => {
            r.classList.toggle('hidden', (q && !r.dataset.text.includes(q)) || (role && r.dataset.rolekey !== role) || (st && r.dataset.status !== st));
        });
    }

    function markDirty() {
        document.getElementById('perm-dirty')?.classList.remove('hidden');
        const btn = document.getElementById('perm-save');
        if (btn) btn.disabled = false;
    }

    async function savePermissions() {
        const btn = document.getElementById('perm-save');
        btn.disabled = true;
        const roles = {};
        document.querySelectorAll('.perm-box').forEach(b => { (roles[b.dataset.role] ||= []); if (b.checked) roles[b.dataset.role].push(b.dataset.perm); });
        try {
            for (const [role, permissions] of Object.entries(roles)) {
                await staffRequest(`/api/superadmin/roles/${role}/permissions`, 'PUT', { permissions });
            }
            document.getElementById('perm-dirty').classList.add('hidden');
            showToast('تم حفظ الصلاحيات. تطبَّق فوراً على الموظفين.', 'success');
        } catch (err) {
            btn.disabled = false;
            showToast(err.message, 'error');
        }
    }

    async function resetRole(role, label) {
        const ok = await Swal.fire({ title: `إرجاع صلاحيات ${label} للوضع الافتراضي؟`, icon: 'question', showCancelButton: true, confirmButtonText: 'إرجاع', cancelButtonText: 'إلغاء' });
        if (!ok.isConfirmed) return;
        try {
            await staffRequest(`/api/superadmin/roles/${role}/permissions/reset`, 'POST');
            location.href = location.pathname + '#roles';
            location.reload();
        } catch (err) {
            showToast(err.message, 'error');
        }
    }

    async function resetStaffPassword(btn) {
        const { id, name, phone } = btn.dataset;
        const ok = await Swal.fire({
            title: 'كلمة مرور جديدة؟', text: `ستُلغى كلمة مرور (${name}) الحالية ويُفك قفل الحساب إن كان مقفلاً.`,
            icon: 'question', showCancelButton: true, confirmButtonText: 'توليد كلمة مرور', cancelButtonText: 'إلغاء'
        });
        if (!ok.isConfirmed) return;
        try {
            const d = await staffRequest(`/api/superadmin/staff/${encodeURIComponent(id)}/reset-password`, 'POST');
            await Swal.fire({
                icon: 'success', title: 'تم ضبط كلمة المرور', confirmButtonText: 'تم',
                html: `الدخول برقم الهاتف <b dir="ltr">${esc(phone)}</b> وكلمة المرور:<br><br><b dir="ltr" style="font-size:1.25rem">${esc(d.password)}</b><br><br><small>سلّمها للموظف؛ لن تظهر مرة أخرى.</small>`
            });
            location.reload();
        } catch (err) {
            showToast(err.message, 'error');
        }
    }

    syncStoreField('staff');
</script>
}
