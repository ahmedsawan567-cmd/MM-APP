@model MMApplication.Api.ViewModels.StaffPageViewModel
@using MMApplication.Domain.Enums
@{
    Layout = "_Layout";
    ViewData["Title"] = "إدارة طاقم العمل والصلاحيات (RBAC)";
    ViewData["ActiveTab"] = "staff";
    var totalStaff = Model.StaffMembers.Count;
    var adminCount = Model.StaffMembers.Count(s => s.StaffRole == StaffRole.SuperAdmin || s.Role == CustomerRole.Admin);
    var auditorCount = Model.StaffMembers.Count(s => s.StaffRole == StaffRole.Auditor);
    var merchantCount = Model.StaffMembers.Count(s => s.StaffRole == StaffRole.StoreManager || s.StaffRole == StaffRole.Cashier);
}

<div class="space-y-6">

    <!-- 1. Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
        <div>
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold">
                    <i data-lucide="shield-check" class="w-5 h-5"></i>
                </div>
                <div>
                    <h1 class="text-base font-bold text-slate-900">طاقم العمل وإدارة الصلاحيات (RBAC)</h1>
                    <p class="text-xs text-slate-500">توزيع الأدوار الإدارية، التحكم بصلاحيات تدقيق الفواتير، ومتابعة مديري وموظفي المتاجر</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <button onclick="showToast('جاري تصدير قائمة طاقم العمل بصيغة CSV...', 'info')" class="btn-secondary">
                <i data-lucide="download" class="w-4 h-4 text-slate-500"></i>
                <span>تصدير القائمة</span>
            </button>
            <button onclick="openModal('modal-add-staff')" class="btn-primary">
                <i data-lucide="user-plus" class="w-4 h-4"></i>
                <span>إضافة مستخدم جديد</span>
            </button>
        </div>
    </div>

    <!-- 2. KPI Metrics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">إجمالي الحسابات</span>
                <i data-lucide="users" class="w-4 h-4 text-slate-500"></i>
            </div>
            <div class="text-xl font-bold text-slate-900 num">@totalStaff</div>
            <div class="text-[11px] text-emerald-700 mt-1 font-medium">حسابات نشطة ومسجلة</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">مسؤولو النظام</span>
                <i data-lucide="shield" class="w-4 h-4 text-purple-600"></i>
            </div>
            <div class="text-xl font-bold text-purple-600 num">@adminCount</div>
            <div class="text-[11px] text-purple-700 mt-1 font-medium">Super Admin</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">مدققو الفواتير</span>
                <i data-lucide="check-square" class="w-4 h-4 text-blue-500"></i>
            </div>
            <div class="text-xl font-bold text-blue-600 num">@auditorCount</div>
            <div class="text-[11px] text-slate-400 mt-1">Auditors</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">موظفو المتاجر</span>
                <i data-lucide="store" class="w-4 h-4 text-amber-500"></i>
            </div>
            <div class="text-xl font-bold text-amber-600 num">@merchantCount</div>
            <div class="text-[11px] text-slate-400 mt-1">Store Managers & Cashiers</div>
        </div>
    </div>

    <!-- 3. Staff Directory Table -->
    <div class="card overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-white">
            <div>
                <h3 class="text-sm font-bold text-slate-900">دليل مستخدمي النظام والموظفين</h3>
                <p class="text-xs text-slate-500 mt-0.5">توزيع صلاحيات المسؤولين، مدققي الفواتير، ومديري وكاشير المتاجر في المول</p>
            </div>

            <button onclick="openModal('modal-add-staff')" class="btn-primary">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                <span>إضافة موظف</span>
            </button>
        </div>

        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>اسم الموظف</th>
                        <th>الهاتف المسجل</th>
                        <th>المسمى الوظيفي والدور</th>
                        <th>المتجر المرتبط</th>
                        <th>تاريخ الإنشاء</th>
                        <th class="text-left">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.StaffMembers.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-12 text-slate-400">
                                <div class="w-12 h-12 rounded-full bg-slate-50 text-slate-400 flex items-center justify-center mx-auto mb-2">
                                    <i data-lucide="user-x" class="w-6 h-6"></i>
                                </div>
                                <div class="font-bold text-slate-700">لا يوجد موظفون مسجلون حالياً</div>
                                <p class="text-xs text-slate-400 mt-1">أضف حسابات جديدة لتوزيع الصلاحيات التشغيلية</p>
                            </td>
                        </tr>
                    }
                    @foreach (var s in Model.StaffMembers)
                    {
                        <tr>
                            <td>
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-700 border border-slate-200 flex items-center justify-center font-bold text-xs shrink-0">
                                        @(string.IsNullOrWhiteSpace(s.FullName) ? "م" : s.FullName.Substring(0, 1))
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-900">@s.FullName</div>
                                        <div class="text-[11px] text-slate-400 num">#@s.Id.Substring(0, Math.Min(8, s.Id.Length))</div>
                                    </div>
                                </div>
                            </td>
                            <td class="num font-semibold text-slate-700" dir="ltr">@s.PhoneNumber</td>
                            <td>
                                @switch (s.StaffRole)
                                {
                                    case StaffRole.SuperAdmin:
                                        <span class="badge badge-purple">
                                            <i data-lucide="shield" class="w-3 h-3"></i> مسؤول نظام (Super Admin)
                                        </span>
                                        break;
                                    case StaffRole.Auditor:
                                        <span class="badge badge-blue">
                                            <i data-lucide="check-square" class="w-3 h-3"></i> مدقق فواتير (Auditor)
                                        </span>
                                        break;
                                    case StaffRole.StoreManager:
                                        <span class="badge badge-amber">
                                            <i data-lucide="store" class="w-3 h-3"></i> مدير متجر (Store Manager)
                                        </span>
                                        break;
                                    case StaffRole.Cashier:
                                        <span class="badge badge-slate">
                                            <i data-lucide="calculator" class="w-3 h-3"></i> كاشير (Cashier)
                                        </span>
                                        break;
                                    default:
                                        <span class="badge badge-slate">@(s.StaffRoleLabel ?? s.Role.ToString())</span>
                                        break;
                                }
                            </td>
                            <td>
                                <div class="flex items-center gap-1.5 text-slate-700 font-medium text-xs">
                                    <i data-lucide="@(string.IsNullOrEmpty(s.StoreName) ? "building-2" : "shopping-bag")" class="w-3.5 h-3.5 text-slate-400"></i>
                                    <span>@(s.StoreName ?? "إدارة المول المركزية")</span>
                                </div>
                            </td>
                            <td class="text-slate-500 text-xs num">@s.CreatedAt.ToString("yyyy/MM/dd")</td>
                            <td class="text-left">
                                <div class="flex items-center gap-1 justify-end">
                                    <button onclick="openEditStaffModal('@s.Id', '@s.FullName', '@s.PhoneNumber', '@(s.StaffRole.HasValue ? s.StaffRole.Value.ToString() : "Auditor")', '@(s.StoreTenantId ?? "")')" title="تعديل بيانات الموظف" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition">
                                        <i data-lucide="edit-3" class="w-4 h-4"></i>
                                    </button>
                                    <button onclick="toggleActiveStaff('@s.Id', '@s.FullName')" title="تفعيل/تعطيل الحساب" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition">
                                        <i data-lucide="power" class="w-4 h-4"></i>
                                    </button>
                                    @if (s.StaffRole != StaffRole.SuperAdmin)
                                    {
                                        <button onclick="deleteStaff('@s.Id', '@s.FullName')" title="حذف الحساب" class="p-1.5 rounded-lg text-rose-500 hover:text-rose-700 hover:bg-rose-50 transition">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- ======================================================== -->
<!-- MODALS -->
<!-- ======================================================== -->

<!-- Modal: Add Staff Member -->
<div id="modal-add-staff" class="hidden modal-overlay">
    <div class="modal-box max-w-md">
        <div class="modal-header">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                <i data-lucide="user-plus" class="w-4 h-4 text-purple-600"></i>
                <span>إضافة موظف وتحديد الدور والصلاحيات</span>
            </h3>
            <button onclick="closeModal('modal-add-staff')" class="text-slate-400 hover:text-slate-700"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>

        <div class="modal-body space-y-3.5">
            <div>
                <label class="form-label">الاسم الكامل:</label>
                <input type="text" id="staff-name" placeholder="مثال: سارة المنصوري" class="form-input">
            </div>
            <div>
                <label class="form-label">رقم الهاتف:</label>
                <input type="text" id="staff-phone" placeholder="مثال: 0910003344" class="form-input num">
            </div>
            <div>
                <label class="form-label">كلمة المرور:</label>
                <input type="password" id="staff-pass" value="Staff123!" class="form-input">
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="form-label">الدور الوظيفي:</label>
                    <select id="staff-role" class="form-select">
                        <option value="Auditor">مدقق فواتير (Auditor)</option>
                        <option value="StoreManager">مدير متجر (Store Manager)</option>
                        <option value="Cashier">كاشير متجر (Cashier)</option>
                        <option value="SuperAdmin">مسؤول نظام (Super Admin)</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">المتجر التابع له:</label>
                    <select id="staff-store" class="form-select">
                        <option value="">إدارة المول المركزية</option>
                        @foreach (var st in Model.Stores)
                        {
                            <option value="@st.Id">@st.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button onclick="closeModal('modal-add-staff')" class="btn-secondary">إلغاء</button>
            <button onclick="submitCreateStaff()" class="btn-primary">إنشاء وتفعيل الحساب</button>
        </div>
    </div>
</div>

<!-- Modal: Edit Staff Member -->
<div id="modal-edit-staff" class="hidden modal-overlay">
    <div class="modal-box max-w-md">
        <div class="modal-header">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                <i data-lucide="edit-3" class="w-4 h-4 text-purple-600"></i>
                <span>تعديل بيانات وصلاحيات الموظف</span>
            </h3>
            <button onclick="closeModal('modal-edit-staff')" class="text-slate-400 hover:text-slate-700"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>

        <input type="hidden" id="edit-staff-id" />

        <div class="modal-body space-y-3.5">
            <div>
                <label class="form-label">الاسم الكامل:</label>
                <input type="text" id="edit-staff-name" class="form-input">
            </div>
            <div>
                <label class="form-label">رقم الهاتف:</label>
                <input type="text" id="edit-staff-phone" class="form-input num">
            </div>
            <div>
                <label class="form-label">كلمة مرور جديدة (اتركه فارغاً للإبقاء على الحالية):</label>
                <input type="password" id="edit-staff-pass" placeholder="••••••••" class="form-input">
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="form-label">الدور الوظيفي:</label>
                    <select id="edit-staff-role" class="form-select">
                        <option value="Auditor">مدقق فواتير (Auditor)</option>
                        <option value="StoreManager">مدير متجر (Store Manager)</option>
                        <option value="Cashier">كاشير متجر (Cashier)</option>
                        <option value="SuperAdmin">مسؤول نظام (Super Admin)</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">المتجر التابع له:</label>
                    <select id="edit-staff-store" class="form-select">
                        <option value="">إدارة المول المركزية</option>
                        @foreach (var st in Model.Stores)
                        {
                            <option value="@st.Id">@st.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button onclick="closeModal('modal-edit-staff')" class="btn-secondary">إلغاء</button>
            <button onclick="submitEditStaff()" class="btn-primary">حفظ التعديلات</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function submitCreateStaff() {
        const fullName = document.getElementById('staff-name').value.trim();
        const phoneNumber = document.getElementById('staff-phone').value.trim();
        const password = document.getElementById('staff-pass').value.trim() || 'Staff123!';
        const staffRole = document.getElementById('staff-role').value;
        const storeTenantId = document.getElementById('staff-store').value || null;

        const role = (staffRole === 'StoreManager' || staffRole === 'Cashier') ? 'Merchant' : 'Admin';

        if (!fullName || !phoneNumber) {
            showToast('يرجى ملء كافة بيانات الموظف.', 'warning');
            return;
        }

        try {
            const res = await fetch('/api/superadmin/staff', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ fullName, phoneNumber, password, role, staffRole, storeTenantId })
            });

            if (!res.ok) throw new Error('فشل إنشاء حساب الموظف');
            showToast(`تم إنشاء حساب (${fullName}) بنجاح!`, 'success');
            closeModal('modal-add-staff');
            setTimeout(() => location.reload(), 600);
        } catch (err) {
            showToast(err.message, 'error');
        }
    }

    function openEditStaffModal(id, name, phone, role, storeId) {
        document.getElementById('edit-staff-id').value = id;
        document.getElementById('edit-staff-name').value = name;
        document.getElementById('edit-staff-phone').value = phone;
        document.getElementById('edit-staff-role').value = role;
        document.getElementById('edit-staff-store').value = storeId || '';
        document.getElementById('edit-staff-pass').value = '';
        openModal('modal-edit-staff');
    }

    async function submitEditStaff() {
        const id = document.getElementById('edit-staff-id').value;
        const fullName = document.getElementById('edit-staff-name').value.trim();
        const phoneNumber = document.getElementById('edit-staff-phone').value.trim();
        const staffRole = document.getElementById('edit-staff-role').value;
        const storeTenantId = document.getElementById('edit-staff-store').value || null;
        const password = document.getElementById('edit-staff-pass').value.trim() || null;

        try {
            const res = await fetch(`/api/superadmin/staff/${encodeURIComponent(id)}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ fullName, phoneNumber, staffRole, storeTenantId, password })
            });

            const data = await res.json();
            if (res.ok) {
                showToast('تم تحديث بيانات الموظف بنجاح!', 'success');
                closeModal('modal-edit-staff');
                setTimeout(() => location.reload(), 600);
            } else {
                showToast(data.message || 'فشل التعديل.', 'error');
            }
        } catch (err) {
            showToast('حدث خطأ أثناء الاتصال.', 'error');
        }
    }

    async function toggleActiveStaff(id, name) {
        const result = await Swal.fire({
            title: 'حالة الحساب',
            text: `هل تريد تغيير حالة تفعيل/تعطيل حساب (${name})؟`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'نعم، تابع',
            cancelButtonText: 'إلغاء'
        });

        if (!result.isConfirmed) return;

        try {
            const res = await fetch(`/api/superadmin/staff/${encodeURIComponent(id)}/toggle-active`, { method: 'POST' });
            const data = await res.json();
            if (res.ok) {
                showToast(data.message || 'تم تحديث حالة الحساب.', 'success');
                setTimeout(() => location.reload(), 600);
            } else {
                showToast('فشل تعديل الحالة.', 'error');
            }
        } catch (err) {
            showToast('حدث خطأ أثناء الاتصال.', 'error');
        }
    }

    async function deleteStaff(id, name) {
        const result = await Swal.fire({
            title: 'حذف الحساب',
            text: `هل تريد حذف حساب الموظف (${name}) نهائياً؟`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'نعم، احذف',
            cancelButtonText: 'إلغاء',
            customClass: { confirmButton: 'btn-danger', cancelButton: 'btn-secondary' }
        });

        if (!result.isConfirmed) return;

        try {
            const res = await fetch(`/api/superadmin/staff/${encodeURIComponent(id)}`, { method: 'DELETE' });
            if (!res.ok) throw new Error('فشل حذف الحساب');
            showToast('تم حذف الحساب بنجاح.', 'info');
            setTimeout(() => location.reload(), 600);
        } catch (err) {
            showToast(err.message, 'error');
        }
    }
</script>
}
