@model List<MMApplication.Api.Controllers.AdminDashboardController.ClaimRow>
@using MMApplication.Api.ViewModels
@using MMApplication.Domain.Enums
@{
    Layout = "_Layout";
    var page = (int)ViewData["Page"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
    var total = (int)ViewData["Total"]!;
    var stores = (List<(string Id, string Name)>)ViewData["Stores"]!;
    var storeId = ViewData["StoreId"] as string;
    string Ago(DateTime d)
    {
        var span = DateTime.UtcNow - d;
        if (span.TotalMinutes < 1) return "الآن";
        if (span.TotalHours < 1) return $"منذ {(int)span.TotalMinutes} دقيقة";
        if (span.TotalDays < 1) return $"منذ {(int)span.TotalHours} ساعة";
        return d.ToLocalTime().ToString("yyyy/MM/dd HH:mm");
    }
    string PageUrl(int p) => $"/AdminDashboard/StoreClaims?page={p}" + (string.IsNullOrEmpty(storeId) ? "" : $"&storeId={Uri.EscapeDataString(storeId)}");
}
@Html.AntiForgeryToken()

<div class="space-y-5">
    <div class="page-header">
        <div>
            <h1 class="page-title">مسح الباركود وNFC</h1>
            <p class="page-subtitle">العميل يمسح باركود المتجر أو يقرّب بطاقة NFC فيأخذ نقاط المتجر فوراً. حدد نقاط كل متجر وعدد المرات اليومية من صفحة المتاجر.</p>
        </div>
        <div class="page-actions">
            <a href="/AdminDashboard/StoreCodePrint" target="_blank" class="btn-secondary"><i data-lucide="qr-code" class="w-4 h-4"></i> طباعة الباركود</a>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="stat-card">
            <div class="flex items-center justify-between"><span class="stat-label">عمليات مسح اليوم</span><span class="stat-icon bg-brand-50 text-brand-600"><i data-lucide="scan-qr-code" class="w-5 h-5"></i></span></div>
            <div class="stat-value num">@ViewData["ScansToday"]</div>
            <div class="stat-meta">باركود وبطاقات NFC</div>
        </div>
        <div class="stat-card">
            <div class="flex items-center justify-between"><span class="stat-label">نقاط اليوم</span><span class="stat-icon bg-amber-50 text-amber-600"><i data-lucide="coins" class="w-5 h-5"></i></span></div>
            <div class="stat-value text-gold-600 num">@(((int)ViewData["PointsToday"]!).ToString("N0"))</div>
            <div class="stat-meta">أُضيفت للعملاء فوراً</div>
        </div>
        <div class="stat-card">
            <div class="flex items-center justify-between"><span class="stat-label">عملاء اليوم</span><span class="stat-icon bg-emerald-50 text-emerald-600"><i data-lucide="users" class="w-5 h-5"></i></span></div>
            <div class="stat-value num">@ViewData["CustomersToday"]</div>
            <div class="stat-meta">عميل مختلف</div>
        </div>
    </div>

    <div class="card overflow-hidden">
        @if (stores.Count > 0)
        {
            <form method="get" class="p-4 border-b border-line flex items-center gap-3">
                <select name="storeId" onchange="this.form.submit()" class="form-select sm:w-72" aria-label="المتجر">
                    <option value="">كل المتاجر</option>
                    @foreach (var s in stores) { <option value="@s.Id" selected="@(storeId == s.Id)">@s.Name</option> }
                </select>
            </form>
        }
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i data-lucide="scan-qr-code" class="w-6 h-6"></i></div>
                <div class="font-bold text-slate-700">لا توجد عمليات مسح بعد</div>
                <p class="text-sm text-slate-500">اطبع باركود المتجر وضعه عند الكاشير ليبدأ العملاء بالمسح</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead><tr><th>العميل</th><th>المتجر</th><th>الطريقة</th><th>النقاط</th><th>الوقت</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr class="@(c.Status == InvoiceStatus.APPROVED ? "" : "opacity-60")">
                                <td>
                                    <div class="font-semibold text-slate-900">@c.CustomerName</div>
                                    <div class="text-xs text-slate-500"><span class="num" dir="ltr">@c.MembershipNumber</span> • <span class="num" dir="ltr">@c.Phone</span></div>
                                </td>
                                <td class="text-sm">@c.Store</td>
                                <td><span class="badge @(c.Source == "NFC" ? "badge-indigo" : "badge-brand")"><i data-lucide="@(c.Source == "NFC" ? "nfc" : "qr-code")" class="w-3 h-3"></i> @(c.Source == "NFC" ? "بطاقة NFC" : "باركود")</span></td>
                                <td class="num font-bold @(c.Status == InvoiceStatus.APPROVED ? "text-gold-600" : "text-slate-400 line-through")">+@c.Points</td>
                                <td class="text-sm text-slate-600 whitespace-nowrap">@Ago(c.CreatedAt)</td>
                                <td class="text-left whitespace-nowrap">
                                    @if (c.Status == InvoiceStatus.APPROVED)
                                    {
                                        <button type="button" class="btn-ghost btn-sm text-rose-600" onclick="voidScan('@c.Id', @Json.Serialize(c.CustomerName), @c.Points)"><i data-lucide="undo-2" class="w-4 h-4"></i> إلغاء</button>
                                    }
                                    else
                                    {
                                        <span class="badge badge-slate" title="@c.Reason">ملغاة</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="p-4 border-t border-line flex items-center justify-between text-sm">
            <span class="text-slate-500"><span class="num">@total</span> عملية @(totalPages > 1 ? $"• صفحة {page} من {totalPages}" : "")</span>
            @if (totalPages > 1)
            {
                <div class="flex gap-2">
                    <a href="@PageUrl(page - 1)" class="btn-secondary btn-sm @(page <= 1 ? "pointer-events-none opacity-50" : "")">السابق</a>
                    <a href="@PageUrl(page + 1)" class="btn-secondary btn-sm @(page >= totalPages ? "pointer-events-none opacity-50" : "")">التالي</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function voidScan(id, name, points) {
        const r = await Swal.fire({
            title: `إلغاء مسح ${name}؟`, text: `تُسترجع ${points} نقطة من رصيد العميل ويصله إشعار.`, input: 'text',
            inputPlaceholder: 'السبب (يظهر للعميل) — مثال: لم يكن في المحل', icon: 'warning',
            showCancelButton: true, confirmButtonText: 'إلغاء المسح', cancelButtonText: 'رجوع',
            customClass: { confirmButton: 'btn-danger', cancelButton: 'btn-secondary' }
        });
        if (!r.isConfirmed) return;
        try {
            const res = await fetch(`/AdminDashboard/ClaimVoid?id=${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                body: JSON.stringify({ reason: r.value || null })
            });
            const d = await res.json().catch(() => ({}));
            if (!res.ok || d.success === false) throw new Error(d.message || 'تعذّر الإلغاء.');
            showToast(d.message, 'success');
            setTimeout(() => location.reload(), 700);
        } catch (e) { showToast(e.message, 'error'); }
    }
</script>
}
