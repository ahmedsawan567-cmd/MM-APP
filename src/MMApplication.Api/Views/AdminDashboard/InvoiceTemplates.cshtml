@model MMApplication.Api.ViewModels.InvoiceTemplatesPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "نماذج الفواتير";
    var total = Model.Stores.Count;
}
@Html.AntiForgeryToken()

<div class="space-y-5">

    <!-- الترويسة -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center">
                <i data-lucide="scan-text" class="w-5 h-5"></i>
            </div>
            <div>
                <h1 class="text-base font-bold text-slate-900">نماذج الفواتير</h1>
                <p class="text-xs text-slate-500">صوّر فاتورة من كل متجر مرة واحدة، فيتعلّم الذكاء الاصطناعي ما يميزها (الاسم، الرقم الضريبي، مكان رقم الفاتورة ونمطه) ويستخدمه مع كل فاتورة يصورها العملاء</p>
            </div>
        </div>
        <button type="button" onclick="MM.openModal('test-modal')" class="btn-secondary shrink-0">
            <i data-lucide="flask-conical" class="w-4 h-4"></i> اختبار فاتورة
        </button>
    </div>

    <!-- مؤشرات -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="stat-card">
            <div class="text-xs font-semibold text-slate-500">متاجر لها نموذج فاتورة</div>
            <div class="mt-2 text-xl font-bold text-slate-900"><span class="num">@Model.WithProfile</span> <span class="text-sm font-medium text-slate-400">من <span class="num">@total</span></span></div>
            <div class="mt-3 h-1.5 rounded-full bg-slate-100 overflow-hidden"><div class="h-full rounded-full bg-brand-600" style="width:@(total == 0 ? 0 : Model.WithProfile * 100 / total)%"></div></div>
        </div>
        <div class="stat-card">
            <div class="text-xs font-semibold text-slate-500">محاولات فواتير مكررة مُنعت (30 يوماً)</div>
            <div class="mt-2 text-xl font-bold @(Model.DuplicatesBlocked30d > 0 ? "text-rose-600" : "text-slate-900") num">@Model.DuplicatesBlocked30d</div>
            <div class="text-[11px] text-slate-400 mt-1">رقم الفاتورة يُحتسب مرة واحدة فقط لكل متجر</div>
        </div>
        <div class="stat-card">
            <div class="text-xs font-semibold text-slate-500">التحليل بالذكاء الاصطناعي</div>
            @if (Model.AiEnabled)
            {
                <div class="mt-2 inline-flex items-center gap-1.5 text-sm font-bold text-emerald-700"><span class="dot bg-emerald-500"></span> مفعّل (Claude)</div>
                <div class="text-[11px] text-slate-400 mt-1">يستخرج بصمة الفاتورة من الصورة تلقائياً</div>
            }
            else
            {
                <div class="mt-2 inline-flex items-center gap-1.5 text-sm font-bold text-amber-700"><span class="dot bg-amber-500"></span> غير مفعّل</div>
                <div class="text-[11px] text-slate-400 mt-1">أضف مفتاح Claude، أو أدخل الحقول يدوياً</div>
            }
        </div>
    </div>

    <!-- البحث -->
    <div class="relative">
        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2"></i>
        <input id="store-search" oninput="filterStores(this.value)" placeholder="ابحث عن متجر..." class="form-input pr-10" />
    </div>

    <!-- المتاجر -->
    @if (total == 0)
    {
        <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center text-slate-500">لا توجد متاجر بعد. أضف المتاجر من صفحة المتاجر أولاً.</div>
    }
    else
    {
        <div id="store-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            @foreach (var s in Model.Stores)
            {
                <div class="store-card bg-white rounded-2xl border border-slate-200 overflow-hidden flex flex-col @(s.StoreActive ? "" : "opacity-60")"
                     data-search="@($"{s.StoreName} {s.StoreNameEn} {s.UnitNumber} {string.Join(' ', s.Aliases)}".ToLowerInvariant())">
                    <div class="flex items-start gap-3 p-4">
                        <div class="w-16 h-16 shrink-0 rounded-xl bg-slate-100 overflow-hidden flex items-center justify-center text-slate-400">
                            @if (!string.IsNullOrEmpty(s.SampleImageUrl))
                            {
                                <img src="@s.SampleImageUrl" alt="" class="w-full h-full object-cover" onerror="this.replaceWith(document.createTextNode(''))" />
                            }
                            else
                            {
                                <i data-lucide="receipt" class="w-6 h-6"></i>
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-2">
                                <h3 class="font-bold text-slate-900 truncate">@s.StoreName</h3>
                                @if (!s.HasProfile)
                                {
                                    <span class="badge badge-amber shrink-0">بدون نموذج</span>
                                }
                                else if (s.ProfileActive)
                                {
                                    <span class="badge badge-emerald shrink-0">مفعّل</span>
                                }
                                else
                                {
                                    <span class="badge badge-slate shrink-0">موقوف</span>
                                }
                            </div>
                            <div class="text-[11px] text-slate-500 mt-0.5">@s.Category @(string.IsNullOrEmpty(s.UnitNumber) ? "" : $"• {s.UnitNumber}") • <span class="num">@s.InvoicesCount</span> فاتورة</div>
                        </div>
                    </div>

                    <div class="px-4 pb-4 flex-1 space-y-1.5 text-xs">
                        @if (s.HasProfile)
                        {
                            <div class="flex justify-between gap-2"><span class="text-slate-500">رقم الفاتورة</span><span class="font-semibold text-slate-800 truncate" dir="auto">@(s.InvoiceNumberLabel ?? "—") <span class="num text-brand-700" dir="ltr">@s.InvoiceNumberExample</span></span></div>
                            <div class="flex justify-between gap-2"><span class="text-slate-500">الرقم الضريبي</span><span class="font-semibold text-slate-800 num" dir="ltr">@(s.TaxNumber ?? "—")</span></div>
                            <div class="flex justify-between gap-2"><span class="text-slate-500">آخر تحديث</span><span class="text-slate-600">@s.UpdatedAt?.ToString("yyyy/MM/dd") @(s.UpdatedBy is null ? "" : $"— {s.UpdatedBy}")</span></div>
                        }
                        else
                        {
                            <p class="text-slate-500 leading-relaxed">صوّر فاتورة حقيقية من هذا المتجر ليتعرف عليها النظام بدقة ويقرأ رقمها من المكان الصحيح.</p>
                        }
                    </div>

                    <div class="border-t border-slate-100 p-3 flex gap-2">
                        <button type="button" onclick="openEditor('@s.StoreId')" class="flex-1 @(s.HasProfile ? "btn-secondary" : "btn-primary") justify-center">
                            <i data-lucide="@(s.HasProfile ? "pencil" : "sparkles")" class="w-4 h-4"></i> @(s.HasProfile ? "تعديل النموذج" : "تعليم النموذج")
                        </button>
                        @if (s.HasProfile)
                        {
                            <button type="button" onclick="deleteProfile('@s.StoreId')" class="btn-icon text-rose-600 hover:bg-rose-50" title="حذف النموذج" aria-label="حذف النموذج">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
        <p id="no-match" class="hidden text-center text-sm text-slate-500 py-8">لا يوجد متجر بهذا الاسم.</p>
    }
</div>

<!-- محرر نموذج الفاتورة -->
<div id="editor-modal" class="hidden modal-overlay">
    <div class="modal-box max-w-4xl">
        <div class="modal-header">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2"><i data-lucide="scan-text" class="w-4 h-4 text-brand-600"></i> نموذج فاتورة: <span id="ed-store"></span></h3>
            <button type="button" onclick="MM.closeModal('editor-modal')" class="btn-icon" aria-label="إغلاق"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>
        <div class="modal-body">
            <div class="grid lg:grid-cols-5 gap-5">
                <!-- الصورة -->
                <div class="lg:col-span-2 space-y-3">
                    <label for="ed-file" class="block cursor-pointer rounded-2xl border-2 border-dashed border-slate-300 hover:border-brand-600 bg-slate-50 transition overflow-hidden">
                        <div id="ed-preview-empty" class="p-6 text-center">
                            <i data-lucide="image-up" class="w-8 h-8 mx-auto text-slate-400"></i>
                            <div class="mt-2 text-sm font-bold text-slate-700">ارفع صورة فاتورة من المتجر</div>
                            <div class="text-[11px] text-slate-500 mt-1">صورة واضحة لفاتورة كاملة (JPG / PNG / PDF)</div>
                        </div>
                        <img id="ed-preview" alt="" class="hidden w-full max-h-[420px] object-contain bg-[#0b1220]" />
                    </label>
                    <input id="ed-file" type="file" accept="image/*,application/pdf" class="hidden" onchange="analyzeSample(this)" />
                    <div id="ed-status" class="hidden rounded-xl p-3 text-xs"></div>
                </div>

                <!-- الحقول -->
                <div class="lg:col-span-3 grid sm:grid-cols-2 gap-3 content-start">
                    <div class="sm:col-span-2">
                        <label class="form-label">اسم المتجر كما يُطبع على الفاتورة</label>
                        <input id="f-printed" class="form-input" dir="auto" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="form-label">أسماء أخرى تظهر على الفواتير <span class="text-slate-400 font-normal">(افصل بفاصلة)</span></label>
                        <input id="f-names" class="form-input" dir="auto" />
                    </div>
                    <div>
                        <label class="form-label">تسمية رقم الفاتورة المطبوعة</label>
                        <input id="f-label" class="form-input" dir="auto" placeholder="رقم الفاتورة / Bill No" />
                    </div>
                    <div>
                        <label class="form-label">مثال رقم فاتورة حقيقي</label>
                        <input id="f-example" class="form-input num" dir="ltr" oninput="document.getElementById('f-pattern').placeholder = 'يُولَّد تلقائياً من المثال'" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="form-label">نمط رقم الفاتورة <span class="text-slate-400 font-normal">(اتركه فارغاً ليُولَّد من المثال)</span></label>
                        <input id="f-pattern" class="form-input num text-xs" dir="ltr" placeholder="يُولَّد تلقائياً من المثال" />
                    </div>
                    <div>
                        <label class="form-label">الرقم الضريبي / السجل التجاري</label>
                        <input id="f-tax" class="form-input num" dir="ltr" />
                    </div>
                    <div>
                        <label class="form-label">هاتف المتجر على الفاتورة</label>
                        <input id="f-phone" class="form-input num" dir="ltr" />
                    </div>
                    <div>
                        <label class="form-label">تسمية الإجمالي</label>
                        <input id="f-total" class="form-input" dir="auto" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="form-label">صيغة التاريخ</label>
                            <input id="f-date" class="form-input num" dir="ltr" placeholder="DD/MM/YYYY" />
                        </div>
                        <div>
                            <label class="form-label">العملة</label>
                            <input id="f-currency" class="form-input num" dir="ltr" placeholder="LYD" />
                        </div>
                    </div>
                    <div class="sm:col-span-2">
                        <label class="form-label">ما يميز شكل الفاتورة</label>
                        <textarea id="f-notes" rows="2" class="form-input" dir="auto"></textarea>
                    </div>
                    <label class="sm:col-span-2 flex items-center gap-2 text-sm text-slate-700">
                        <input id="f-active" type="checkbox" class="form-check" checked /> استخدام هذا النموذج عند قراءة فواتير العملاء
                    </label>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" onclick="MM.closeModal('editor-modal')" class="btn-secondary">إلغاء</button>
            <button type="button" id="ed-save" onclick="saveProfile()" class="btn-primary">حفظ النموذج</button>
        </div>
    </div>
</div>

<!-- اختبار فاتورة -->
<div id="test-modal" class="hidden modal-overlay">
    <div class="modal-box max-w-xl">
        <div class="modal-header">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2"><i data-lucide="flask-conical" class="w-4 h-4 text-brand-600"></i> اختبار قراءة فاتورة</h3>
            <button type="button" onclick="MM.closeModal('test-modal')" class="btn-icon" aria-label="إغلاق"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>
        <div class="modal-body space-y-4">
            <p class="text-xs text-slate-500">تُقرأ الفاتورة كما لو صوّرها عميل، بدون حفظ أو نقاط، لتتأكد أن المنظومة تتعرف على المتجر وتقرأ رقم الفاتورة صحيحاً.</p>
            <label class="flex items-center justify-center gap-2 cursor-pointer rounded-xl border-2 border-dashed border-slate-300 hover:border-brand-600 p-5 text-sm font-bold text-slate-700">
                <i data-lucide="upload" class="w-4 h-4"></i> اختر صورة فاتورة
                <input type="file" accept="image/*,application/pdf" class="hidden" onchange="testReceipt(this)" />
            </label>
            <div id="test-result"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const stores = @Json.Serialize(Model.Stores);
    let current = null, sampleUrl = null, learned = false;

    function filterStores(q) {
        q = q.trim().toLowerCase();
        let shown = 0;
        document.querySelectorAll('.store-card').forEach(c => {
            const ok = !q || c.dataset.search.includes(q);
            c.classList.toggle('hidden', !ok);
            if (ok) shown++;
        });
        document.getElementById('no-match')?.classList.toggle('hidden', shown > 0);
    }

    const fields = {
        printedName: 'f-printed', taxNumber: 'f-tax', phoneOnReceipt: 'f-phone', invoiceNumberLabel: 'f-label',
        invoiceNumberExample: 'f-example', invoiceNumberPattern: 'f-pattern', totalLabel: 'f-total',
        dateFormat: 'f-date', currency: 'f-currency', layoutNotes: 'f-notes'
    };

    function setStatus(kind, html) {
        const el = document.getElementById('ed-status');
        const tone = { info: 'bg-brand-50 text-brand-800', ok: 'bg-emerald-50 text-emerald-800', warn: 'bg-amber-50 text-amber-800', error: 'bg-rose-50 text-rose-700' }[kind];
        el.className = `rounded-xl p-3 text-xs leading-relaxed ${tone}`;
        el.innerHTML = html;
        el.classList.toggle('hidden', !html);
    }

    function showPreview(url) {
        const img = document.getElementById('ed-preview');
        document.getElementById('ed-preview-empty').classList.toggle('hidden', !!url);
        img.classList.toggle('hidden', !url);
        if (url) img.src = url;
    }

    function openEditor(id) {
        current = stores.find(s => s.storeId === id);
        if (!current) return;
        sampleUrl = current.sampleImageUrl || null;
        learned = false;
        document.getElementById('ed-store').textContent = current.storeName;
        for (const [k, el] of Object.entries(fields)) document.getElementById(el).value = current[k] || '';
        document.getElementById('f-names').value = (current.aliases || []).filter(a => a !== current.storeName).join('، ');
        if (!current.hasProfile) document.getElementById('f-printed').value = current.storeName;
        document.getElementById('f-active').checked = current.hasProfile ? current.profileActive : true;
        document.getElementById('ed-file').value = '';
        showPreview(sampleUrl);
        setStatus('', '');
        MM.openModal('editor-modal');
    }

    async function analyzeSample(input) {
        const file = input.files[0];
        if (!file || !current) return;
        if (file.type.startsWith('image/')) showPreview(URL.createObjectURL(file));
        setStatus('info', '<span class="inline-flex items-center gap-2"><i data-lucide="loader-circle" class="w-4 h-4 animate-spin"></i> جارٍ تحليل الفاتورة بالذكاء الاصطناعي...</span>');
        lucide.createIcons();

        const form = new FormData();
        form.append('storeId', current.storeId);
        form.append('file', file);
        try {
            const res = await fetch('/AdminDashboard/AnalyzeInvoiceSample', { method: 'POST', headers: { 'RequestVerificationToken': token }, body: form });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.success) { setStatus('error', MM.esc(data.message || 'تعذّر تحليل الصورة.')); return; }

            sampleUrl = data.sampleImageUrl;
            const s = data.suggestion;
            if (s.warning) { setStatus('warn', MM.esc(s.warning)); return; }

            learned = true;
            for (const [k, el] of Object.entries(fields)) if (s[k]) document.getElementById(el).value = s[k];
            if (s.otherNames?.length) document.getElementById('f-names').value = s.otherNames.join('، ');
            setStatus('ok', 'تم استخراج بصمة الفاتورة. <b>راجع الحقول</b> (خصوصاً مثال رقم الفاتورة والرقم الضريبي) ثم احفظ.');
        } catch {
            setStatus('error', 'تعذّر الاتصال بالخادم.');
        }
    }

    async function saveProfile() {
        const body = { storeId: current.storeId, sampleImageUrl: sampleUrl, otherNames: document.getElementById('f-names').value, isActive: document.getElementById('f-active').checked, learned };
        for (const [k, el] of Object.entries(fields)) body[k] = document.getElementById(el).value;
        const btn = document.getElementById('ed-save');
        btn.disabled = true;
        try {
            const res = await fetch('/AdminDashboard/SaveInvoiceProfile', {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }, body: JSON.stringify(body)
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.success) { showToast(data.message || 'تعذّر الحفظ.', 'error'); return; }
            showToast(data.message, 'success');
            setTimeout(() => location.reload(), 500);
        } finally {
            btn.disabled = false;
        }
    }

    async function deleteProfile(id) {
        const s = stores.find(x => x.storeId === id);
        const c = await Swal.fire({
            title: 'حذف نموذج الفاتورة؟', text: `ستُقرأ فواتير ${s.storeName} بدون بصمة المتجر حتى تعلّمه من جديد.`, icon: 'warning',
            showCancelButton: true, confirmButtonText: 'حذف', cancelButtonText: 'إلغاء'
        });
        if (!c.isConfirmed) return;
        const res = await fetch('/AdminDashboard/DeleteInvoiceProfile', {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }, body: JSON.stringify({ storeId: id })
        });
        const data = await res.json().catch(() => ({}));
        showToast(data.message || (res.ok ? 'تم الحذف.' : 'تعذّر الحذف.'), res.ok ? 'success' : 'error');
        if (res.ok) setTimeout(() => location.reload(), 500);
    }

    async function testReceipt(input) {
        const file = input.files[0];
        if (!file) return;
        const out = document.getElementById('test-result');
        out.innerHTML = '<div class="flex items-center gap-2 text-sm text-slate-500"><i data-lucide="loader-circle" class="w-4 h-4 animate-spin"></i> جارٍ القراءة...</div>';
        lucide.createIcons();
        const form = new FormData();
        form.append('file', file);
        input.value = '';
        const res = await fetch('/AdminDashboard/TestInvoiceProfile', { method: 'POST', headers: { 'RequestVerificationToken': token }, body: form });
        const d = await res.json().catch(() => ({}));
        if (!res.ok || !d.success) { out.innerHTML = `<div class="rounded-xl bg-rose-50 text-rose-700 p-3 text-sm">${MM.esc(d.message || 'تعذّرت القراءة.')}</div>`; return; }

        const row = (k, v) => `<div class="flex justify-between gap-3 py-1.5 border-b border-slate-100 text-sm"><span class="text-slate-500">${k}</span><span class="font-semibold text-slate-900" dir="auto">${MM.esc(v ?? '—')}</span></div>`;
        out.innerHTML = `
            <div class="space-y-1">
                ${d.checks.map(c => `<div class="flex items-center gap-2 text-sm ${c.ok ? 'text-emerald-700' : 'text-rose-700'}"><i data-lucide="${c.ok ? 'circle-check' : 'circle-alert'}" class="w-4 h-4 shrink-0"></i>${MM.esc(c.label)}</div>`).join('')}
            </div>
            <div class="mt-4">
                ${row('المتجر كما قُرئ', d.merchantName)}
                ${row('رقم الفاتورة', d.invoiceNumber)}
                ${row('الرقم الضريبي', d.taxNumber)}
                ${row('التاريخ', d.invoiceDate)}
                ${row('الإجمالي', d.totalAmount != null ? d.totalAmount + ' د.ل' : null)}
                ${row('ثقة القراءة', Math.round(d.confidence * 100) + '%')}
            </div>
            ${d.concerns?.length ? `<div class="mt-3 rounded-xl bg-amber-50 text-amber-800 p-3 text-xs">${d.concerns.map(MM.esc).join('<br>')}</div>` : ''}`;
        lucide.createIcons();
    }
</script>
}
