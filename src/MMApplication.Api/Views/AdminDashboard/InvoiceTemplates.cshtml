    function loadSampleText(type) {
        if (samples[type]) {
            document.getElementById('sandboxReceiptText').value = samples[type];
            if (type === 'kadi') document.getElementById('sandboxStoreSelect').value = 'TEN-KADI-CAFE';
            else if (type === 'zara') document.getElementById('sandboxStoreSelect').value = 'TEN-EVENING-DRESS';
            else if (type === 'supermarket') document.getElementById('sandboxStoreSelect').value = 'TEN-FOOD-MARKET';
        }
    }

    function scrollToSandbox() {
        document.getElementById('ai-sandbox-section').scrollIntoView({ behavior: 'smooth' });
    }

    function testWithStore(storeId, storeName) {
        document.getElementById('sandboxStoreSelect').value = storeId;
        scrollToSandbox();
        if (!document.getElementById('sandboxReceiptText').value) {
            loadSampleText('kadi');
        }
    }

    function filterTemplates(selectedStoreId) {
        const cards = document.querySelectorAll('.store-template-card');
        cards.forEach(card => {
            if (selectedStoreId === 'ALL' || card.getAttribute('data-store-id') === selectedStoreId) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function openTemplateModal(storeId = null) {
        document.getElementById('modal-template').classList.remove('hidden');
        if (storeId) {
            editTemplate(storeId);
        } else {
            document.getElementById('templateForm').reset();
            document.getElementById('modalTitle').textContent = 'إضافة نموذج فاتورة جديد لمتجر';
        }
    }

    function closeTemplateModal() {
        document.getElementById('modal-template').classList.add('hidden');
    }

    function editTemplate(storeId) {
        const card = document.querySelector(`.store-template-card[data-store-id="${storeId}"]`);
        if (!card) return;

        document.getElementById('modalStoreId').value = storeId;
        document.getElementById('modalTemplateType').value = card.getAttribute('data-template-type') || 'إيصال كافيه ومطعم حراري (POS Slip)';
        document.getElementById('modalAliases').value = card.getAttribute('data-aliases') || '';
        document.getElementById('modalTotalKeyword').value = card.getAttribute('data-total-keyword') || 'المجموع الكلي';
        document.getElementById('modalPrefix').value = card.getAttribute('data-prefix') || 'INV-';
        document.getElementById('modalIsActive').checked = card.getAttribute('data-active') === 'true';
        document.getElementById('modalTitle').textContent = `تعديل نموذج: ${card.getAttribute('data-store-name')}`;

        document.getElementById('modal-template').classList.remove('hidden');
    }

    async function handleSaveTemplate(e) {
        e.preventDefault();
        const btn = document.getElementById('btnSubmitTemplate');
        btn.disabled = true;
        btn.innerText = 'جاري الحفظ...';

        const storeId = document.getElementById('modalStoreId').value;
        const templateType = document.getElementById('modalTemplateType').value;
        const aliases = document.getElementById('modalAliases').value;
        const totalKeyword = document.getElementById('modalTotalKeyword').value;
        const prefix = document.getElementById('modalPrefix').value;
        const notes = document.getElementById('modalNotes').value;
        const isActive = document.getElementById('modalIsActive').checked;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const resp = await fetch('/AdminDashboard/SaveInvoiceTemplate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify({
                    storeId: storeId,
                    templateType: templateType,
                    headerAliases: aliases,
                    totalAmountKeyword: totalKeyword,
                    invoiceNumberPrefix: prefix,
                    notes: notes,
                    isActive: isActive
                })
            });

            const result = await resp.json();
            if (resp.ok && result.success) {
                confetti({ particleCount: 50, spread: 60, origin: { y: 0.7 } });
                Swal.fire({
                    icon: 'success',
                    title: 'تم الحفظ',
                    text: result.message || 'تم حفظ نموذج الفاتورة بنجاح.',
                    confirmButtonColor: '#047857'
                }).then(() => window.location.reload());
            } else {
                Swal.fire({ icon: 'error', title: 'خطأ', text: result.message || 'حدث خطأ أثناء الحفظ.' });
            }
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'خطأ', text: 'تعذر الاتصال بالسيرفر.' });
        } finally {
            btn.disabled = false;
            btn.innerText = 'حفظ النموذج';
        }
    }

    async function runAiScanTest() {
        const btn = document.getElementById('btnRunAiScan');
        const storeId = document.getElementById('sandboxStoreSelect').value;
        const text = document.getElementById('sandboxReceiptText').value;

        btn.disabled = true;
        btn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i><span>جاري تحليل الفاتورة ومطابقة القوالب...</span>';
        if (window.lucide) lucide.createIcons();

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const resp = await fetch('/AdminDashboard/TestAiInvoiceScan', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify({
                    storeId: storeId,
                    receiptText: text
                })
            });

            const result = await resp.json();

            document.getElementById('emptyResultPlaceholder').classList.add('hidden');
            document.getElementById('liveResultData').classList.remove('hidden');
            document.getElementById('liveResultFooter').classList.remove('hidden');

            if (resp.ok && result.success) {
                document.getElementById('scanStatusBadge').className = 'badge badge-emerald font-mono';
                document.getElementById('scanStatusBadge').textContent = 'مطابق ومعتمد 100%';

                document.getElementById('resStoreName').textContent = result.recognizedStoreName;
                document.getElementById('resInvoiceNum').textContent = result.extractedInvoiceNumber;
                document.getElementById('resTotalAmount').textContent = result.extractedTotalAmount.toFixed(2) + ' د.ل';
                document.getElementById('resConfidence').textContent = result.confidencePercentage + '%';
                document.getElementById('resLoyaltyPoints').textContent = `+${result.calculatedPoints} نقطة (وكاش باك ${result.calculatedCashback.toFixed(2)} د.ل)`;
                document.getElementById('resSuccessMessage').textContent = result.message;

                const tbody = document.getElementById('resLineItemsBody');
                tbody.innerHTML = '';
                if (result.lineItems && result.lineItems.length > 0) {
                    result.lineItems.forEach(item => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td class="p-2 font-sans text-slate-800">${item.description}</td>
                            <td class="p-2 text-center text-slate-600">${item.quantity}</td>
                            <td class="p-2 text-slate-600">${item.unitPrice.toFixed(2)}</td>
                            <td class="p-2 font-bold text-slate-900">${item.totalPrice.toFixed(2)} د.ل</td>
                        `;
                        tbody.appendChild(tr);
                    });
                } else {
                    tbody.innerHTML = '<tr><td colspan="4" class="p-2 text-center text-slate-400">لا توجد بنود تفصيلية</td></tr>';
                }

                confetti({ particleCount: 40, spread: 50, origin: { y: 0.8 } });
            } else {
                document.getElementById('scanStatusBadge').className = 'badge badge-rose font-mono';
                document.getElementById('scanStatusBadge').textContent = 'فشل المطابقة';
                Swal.fire({ icon: 'warning', title: 'تنبيه', text: result.message || 'فشل الفحص.' });
            }
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'خطأ', text: 'حدث خطأ في الاتصال بالخادم.' });
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i data-lucide="play" class="w-4 h-4"></i><span>تشغيل الفحص والتعرف الذكي</span>';
            if (window.lucide) lucide.createIcons();
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        loadSampleText('kadi');
        if (window.lucide) lucide.createIcons();
    });
</script>
