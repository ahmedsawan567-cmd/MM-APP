@model MMApplication.Api.ViewModels.InvoicesPageViewModel
@using MMApplication.Domain.Enums
@{
    Layout = "_Layout";
    ViewData["Title"] = "سجل الفواتير والمعاملات";
    ViewData["ActiveTab"] = "invoices";
}
@Html.AntiForgeryToken()

<div class="space-y-6">

    <!-- 1. Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
        <div>
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold">
                    <i data-lucide="receipt" class="w-5 h-5"></i>
                </div>
                <div>
                    <h1 class="text-base font-bold text-slate-900">سجل الفواتير والمعاملات اليومية</h1>
                    <p class="text-xs text-slate-500">متابعة الفواتير الممسوحة ضوئياً، حالات الاعتماد، مبالغ الشراء، والنقاط الممنوحة للعملاء</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <a asp-controller="AdminDashboard" asp-action="InvoiceTemplates" class="btn-secondary">
                <i data-lucide="scan-line" class="w-4 h-4 text-brand-600"></i>
                <span>قوالب الفواتير والـ AI</span>
            </a>
            <a asp-controller="AdminDashboard" asp-action="Fraud" class="btn-primary">
                <i data-lucide="shield-alert" class="w-4 h-4"></i>
                <span>مركز تدقيق الاحتيال</span>
            </a>
        </div>
    </div>

    <!-- 2. Summary KPI Metrics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">إجمالي الفواتير</span>
                <i data-lucide="files" class="w-4 h-4 text-slate-500"></i>
            </div>
            <div class="text-xl font-bold text-slate-900 num">@Model.TotalCount</div>
            <div class="text-[11px] text-slate-400 mt-1">معاملة شراء مسجلة</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">المبيعات المعتمدة</span>
                <i data-lucide="wallet" class="w-4 h-4 text-emerald-500"></i>
            </div>
            <div class="text-xl font-bold text-emerald-600 num">@Model.TotalApprovedAmount.ToString("N2") <span class="text-xs font-sans font-normal text-slate-500">د.ل</span></div>
            <div class="text-[11px] text-emerald-700 mt-1">مبيعات محققة بالمول</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">النقاط المكتسبة</span>
                <i data-lucide="coins" class="w-4 h-4 text-amber-500"></i>
            </div>
            <div class="text-xl font-bold text-amber-600 num">+@Model.TotalApprovedPoints.ToString("N0")</div>
            <div class="text-[11px] text-amber-700 mt-1">نقطة ممنوحة للمتسوقين</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">قيد المراجعة</span>
                <i data-lucide="clock" class="w-4 h-4 text-brand-500"></i>
            </div>
            <div class="text-xl font-bold text-brand-600 num">@Model.PendingReviewsCount</div>
            <div class="text-[11px] text-brand-700 mt-1">تتطلب فحصاً بشرياً</div>
        </div>
    </div>

    <!-- 3. Filter Bar & Table View -->
    <div class="card p-5 space-y-4">
        
        <form method="get" asp-controller="AdminDashboard" asp-action="Invoices" class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
            
            <div class="flex flex-wrap items-center gap-2.5">
                <!-- Store Filter -->
                <select name="storeId" onchange="this.form.submit()" class="text-xs px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-700 focus:outline-none focus:border-brand-600">
                    <option value="ALL">كافة المتاجر</option>
                    @foreach (var s in Model.Stores)
                    {
                        <!option value="@s.Id" @(Model.SelectedStoreId == s.Id ? "selected" : "")>@s.Name</!option>
                    }
                </select>

                <!-- Status Filter -->
                <select name="status" onchange="this.form.submit()" class="text-xs px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-700 focus:outline-none focus:border-brand-600">
                    <!option value="ALL" @(Model.StatusFilter == "ALL" ? "selected" : "")>كافة الحالات</!option>
                    <!option value="APPROVED" @(Model.StatusFilter == "APPROVED" ? "selected" : "")>معتمدة (APPROVED)</!option>
                    <!option value="PENDING" @(Model.StatusFilter == "PENDING" ? "selected" : "")>قيد الفحص (PENDING)</!option>
                    <!option value="REVIEW_REQUIRED" @(Model.StatusFilter == "REVIEW_REQUIRED" ? "selected" : "")>تتطلب تدقيق (REVIEW)</!option>
                    <!option value="REJECTED" @(Model.StatusFilter == "REJECTED" ? "selected" : "")>مرفوضة (REJECTED)</!option>
                    <!option value="DISPUTED" @(Model.StatusFilter == "DISPUTED" ? "selected" : "")>نزاع مفتوح (DISPUTED)</!option>
                </select>
            </div>

            <!-- Search box -->
            <div class="relative w-full sm:w-72">
                <input type="text" name="search" value="@Model.SearchQuery" placeholder="بحث برقم الفاتورة أو العميل..." class="w-full pl-8 pr-8 py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-xs text-slate-800 placeholder-slate-400 outline-none focus:border-brand-600 focus:bg-white transition">
                <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400 absolute right-2.5 top-2.5"></i>
            </div>
        </form>

        <!-- Invoices Table -->
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>المتجر</th>
                        <th>العميل</th>
                        <th>تاريخ الفاتورة</th>
                        <th>المبلغ</th>
                        <th>النقاط</th>
                        <th>دقة الـ AI</th>
                        <th>الحالة</th>
                        <th class="text-center">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Invoices.Any())
                    {
                        <tr>
                            <td colspan="9" class="p-8 text-center text-slate-400">
                                <i data-lucide="inbox" class="w-8 h-8 mx-auto text-slate-300 mb-2"></i>
                                <span>لا توجد فواتير مطابقة لمعايير البحث الحالية.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var inv in Model.Invoices)
                        {
                            <tr>
                                <td>
                                    <div class="font-mono font-bold text-slate-900 text-xs">@inv.InvoiceNumber</div>
                                    <div class="text-[10px] text-slate-400 num">@inv.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                                </td>

                                <td>
                                    <div class="font-bold text-slate-800 text-xs">@inv.StoreName</div>
                                    <div class="text-[10px] text-slate-400">@inv.StoreCategory</div>
                                </td>

                                <td>
                                    <div class="font-semibold text-slate-900 text-xs">@inv.CustomerName</div>
                                    <div class="num text-[10px] text-slate-400">@inv.CustomerPhone</div>
                                </td>

                                <td>
                                    <span class="num text-xs text-slate-600">@inv.InvoiceDate.ToString("yyyy/MM/dd")</span>
                                </td>

                                <td>
                                    <span class="num font-bold text-slate-900 text-xs">@inv.Amount.ToString("N2")</span> <span class="text-[10px] text-slate-500">د.ل</span>
                                </td>

                                <td>
                                    <span class="num font-bold text-emerald-600 text-xs">+@inv.PointsEarned</span>
                                </td>

                                <td>
                                    <span class="badge @(inv.ConfidenceScore >= 90 ? "badge-emerald" : (inv.ConfidenceScore >= 70 ? "badge-amber" : "badge-rose")) num">
                                        @inv.ConfidenceScore%
                                    </span>
                                </td>

                                <td>
                                    @if (inv.Status == InvoiceStatus.APPROVED)
                                    {
                                        <span class="badge badge-emerald">معتمدة</span>
                                    }
                                    else if (inv.Status == InvoiceStatus.PENDING || inv.Status == InvoiceStatus.REVIEW_REQUIRED)
                                    {
                                        <span class="badge badge-amber">قيد الفحص</span>
                                    }
                                    else if (inv.Status == InvoiceStatus.REJECTED || inv.Status == InvoiceStatus.VOIDED)
                                    {
                                        <span class="badge badge-rose">مرفوضة</span>
                                    }
                                    else if (inv.Status == InvoiceStatus.DISPUTED)
                                    {
                                        <span class="badge badge-blue">نزاع مفتوح</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-slate">@inv.Status</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <button onclick="viewInvoiceDetails('@inv.Id')" class="px-2.5 py-1 rounded text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
                                        عرض التفاصيل
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

<!-- 4. Quick Invoice Details Modal -->
<div id="modal-invoice-details" class="fixed inset-0 z-50 modal-overlay hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-2xl w-full border border-slate-200 shadow-2xl p-6 space-y-4 max-h-[90vh] overflow-y-auto">
        
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div class="flex items-center gap-2">
                <i data-lucide="receipt" class="w-5 h-5 text-brand-600"></i>
                <h3 class="text-sm font-bold text-slate-900">تفاصيل الفاتورة ومطابقة الـ OCR</h3>
            </div>
            <button onclick="closeInvoiceModal()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <div id="invoiceModalContent" class="space-y-4">
            <div class="text-center py-8 text-slate-400">
                <i data-lucide="loader-2" class="w-6 h-6 mx-auto animate-spin mb-2"></i>
                <span>جاري تحميل تفاصيل الفاتورة...</span>
            </div>
        </div>

        <div class="flex items-center justify-between pt-3 border-t border-slate-100">
            <div id="modalActionButtons" class="flex items-center gap-2">
            </div>
            <button type="button" onclick="closeInvoiceModal()" class="btn-secondary">
                إغلاق
            </button>
        </div>

    </div>
</div>

<script>
    const invToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const invStores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stores.Select(x => new { id = x.Id, name = x.Name })));
    let currentInvoice = null;
    const e = v => MM.esc(v);
    const STATUS_AR = { APPROVED: 'معتمدة', REJECTED: 'مرفوضة', VOIDED: 'ملغاة', PENDING: 'قيد المعالجة', PROCESSING: 'قيد المعالجة', REVIEW_REQUIRED: 'بانتظار المراجعة', DISPUTED: 'اعتراض', RESUBMISSION_REQUESTED: 'طُلبت إعادة التصوير' };

    async function viewInvoiceDetails(id) {
        MM.openModal('modal-invoice-details');
        const container = document.getElementById('invoiceModalContent');
        const actions = document.getElementById('modalActionButtons');
        actions.innerHTML = '';
        container.innerHTML = '<div class="text-center py-8 text-slate-400 text-sm">جارٍ التحميل...</div>';
        try {
            const resp = await fetch(`/AdminDashboard/GetInvoiceDetailsJson?id=${encodeURIComponent(id)}`);
            if (!resp.ok) throw new Error();
            const d = currentInvoice = await resp.json();
            const card = (label, value, tone = 'bg-slate-50 border-slate-200') =>
                `<div class="p-3 rounded-xl border ${tone}"><span class="text-[11px] text-slate-500 block">${label}</span><span class="font-bold text-slate-900" dir="auto">${value}</span></div>`;
            const items = (d.lineItems || []).length === 0 ? '' : `
                <div class="overflow-x-auto"><table class="w-full text-xs border border-line rounded-xl overflow-hidden">
                    <thead class="bg-slate-50 text-slate-500"><tr><th class="p-2 text-right">الصنف</th><th class="p-2">الكمية</th><th class="p-2">السعر</th><th class="p-2">الإجمالي</th></tr></thead>
                    <tbody class="divide-y divide-slate-100">${d.lineItems.map(i => `<tr><td class="p-2">${e(i.description)}</td><td class="p-2 text-center num">${Number(i.quantity)}</td><td class="p-2 num">${Number(i.unitPrice).toFixed(2)}</td><td class="p-2 num font-bold">${Number(i.totalPrice).toFixed(2)}</td></tr>`).join('')}</tbody>
                </table></div>`;
            container.innerHTML = `
                <div class="grid sm:grid-cols-2 gap-3 text-sm">
                    ${card('المتجر', `${e(d.storeName)} <span class="text-xs text-slate-500">(${e(d.storeCategory)})</span>`)}
                    ${card('رقم الفاتورة', `<span class="num" dir="ltr">${e(d.invoiceNumber || '—')}</span>`)}
                    ${card('العميل', `${e(d.customerName)} <span class="text-xs text-slate-500 num" dir="ltr">${e(d.customerPhone)}</span>`)}
                    ${card('تاريخ الشراء', `<span class="num">${e(d.invoiceDate)}</span>`)}
                    ${card('المبلغ', `<span class="num">${Number(d.amount).toFixed(2)}</span> د.ل`, 'bg-emerald-50 border-emerald-200')}
                    ${card('النقاط', `<span class="num">+${Number(d.points)}</span> نقطة`, 'bg-brand-50 border-brand-200')}
                </div>
                ${items}
                <div class="flex flex-wrap items-center justify-between gap-2 p-3 rounded-xl bg-slate-100 text-xs">
                    <span>الحالة: <b>${e(STATUS_AR[d.status] || d.status)}</b> — ثقة القراءة <b class="num">${Number(d.confidence)}%</b></span>
                    ${d.rejectionReason ? `<span class="text-rose-600 font-semibold">${e(d.rejectionReason)}</span>` : ''}
                </div>
                <div id="inv-edit" class="hidden grid sm:grid-cols-2 gap-3 p-4 rounded-xl border border-brand-200 bg-brand-50/40">
                    <div class="sm:col-span-2 text-xs font-bold text-brand-800">تعديل بيانات الفاتورة</div>
                    <div><label class="form-label">المتجر</label><select id="ie-store" class="form-select">${invStores.map(s => `<option value="${e(s.id)}" ${s.id === d.tenantId ? 'selected' : ''}>${e(s.name)}</option>`).join('')}</select></div>
                    <div><label class="form-label">رقم الفاتورة</label><input id="ie-number" class="form-input num" dir="ltr" value="${e(d.invoiceNumber || '')}"></div>
                    <div><label class="form-label">التاريخ</label><input id="ie-date" type="date" class="form-input num" value="${e(d.invoiceDateIso || '')}"></div>
                    <div><label class="form-label">المبلغ (د.ل)</label><input id="ie-amount" type="number" step="0.01" min="0" class="form-input num" value="${Number(d.amount)}"></div>
                    <div class="sm:col-span-2 flex justify-end gap-2"><button type="button" class="btn-secondary" onclick="toggleEdit(false)">إلغاء</button><button type="button" class="btn-primary" onclick="saveInvoiceEdit()">حفظ التعديلات</button></div>
                </div>`;

            if (!d.canReview) return;
            const editable = !['APPROVED', 'VOIDED'].includes(d.status);
            actions.innerHTML = [
                editable ? `<button type="button" onclick="changeStatus('APPROVED')" class="btn-success">اعتماد</button>` : '',
                editable && d.status !== 'REJECTED' ? `<button type="button" onclick="changeStatus('REJECTED')" class="btn-danger">رفض</button>` : '',
                editable ? `<button type="button" onclick="toggleEdit(true)" class="btn-secondary"><i data-lucide="pencil" class="w-4 h-4"></i> تعديل</button>` : '',
                d.status !== 'VOIDED' ? `<button type="button" onclick="changeStatus('VOIDED')" class="btn-secondary text-rose-700"><i data-lucide="ban" class="w-4 h-4"></i> إلغاء الفاتورة</button>` : ''
            ].join('');
            lucide.createIcons();
        } catch {
            container.innerHTML = '<div class="text-center py-6 text-rose-600 text-sm">تعذّر جلب تفاصيل الفاتورة.</div>';
        }
    }

    function closeInvoiceModal() { MM.closeModal('modal-invoice-details'); }
    function toggleEdit(show) { document.getElementById('inv-edit').classList.toggle('hidden', !show); }

    async function saveInvoiceEdit() {
        const body = {
            tenantId: document.getElementById('ie-store').value || null,
            invoiceNumber: document.getElementById('ie-number').value.trim() || null,
            invoiceDate: document.getElementById('ie-date').value || null,
            totalAmount: parseFloat(document.getElementById('ie-amount').value) || null
        };
        const resp = await fetch(`/AdminDashboard/InvoiceEdit?id=${encodeURIComponent(currentInvoice.id)}`, {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': invToken }, body: JSON.stringify(body)
        });
        const res = await resp.json().catch(() => ({}));
        if (!resp.ok || !res.success) return showToast(res.message || 'تعذّر الحفظ.', 'error');
        showToast(res.message, 'success');
        viewInvoiceDetails(currentInvoice.id);
    }

    async function changeStatus(newStatus) {
        let reason = '';
        if (newStatus !== 'APPROVED') {
            const voiding = newStatus === 'VOIDED';
            const { value } = await Swal.fire({
                title: voiding ? 'إلغاء الفاتورة' : 'رفض الفاتورة',
                text: voiding ? 'تُسترجع نقاط الفاتورة من العميل ويبقى رقمها محجوزاً فلا يُستخدم مرة أخرى.' : undefined,
                input: 'textarea', inputLabel: voiding ? 'سبب الإلغاء' : 'سبب الرفض (يظهر للعميل)',
                inputPlaceholder: voiding ? 'مثال: استرجاع المشتريات' : 'مثال: الصورة غير واضحة',
                showCancelButton: true, confirmButtonText: 'تأكيد', cancelButtonText: 'رجوع',
                inputValidator: v => (!v || v.trim().length < 3) ? 'اكتب السبب' : undefined
            });
            if (!value) return;
            reason = value.trim();
        }
        try {
            const resp = await fetch(`/AdminDashboard/UpdateInvoiceStatus?id=${encodeURIComponent(currentInvoice.id)}&status=${newStatus}&reason=${encodeURIComponent(reason)}`, {
                method: 'POST', headers: { 'RequestVerificationToken': invToken }
            });
            const res = await resp.json().catch(() => ({}));
            if (resp.status === 403) return showToast('ليست لديك صلاحية لهذه العملية.', 'error');
            if (!resp.ok || !res.success) return showToast(res.message || 'حدث خطأ.', 'error');
            showToast(res.message, 'success');
            setTimeout(() => location.reload(), 600);
        } catch {
            showToast('تعذّر الاتصال بالخادم.', 'error');
        }
    }
</script>
