@model List<MMApplication.Application.DTOs.StoreTenantDto>
@{
    Layout = "_Layout";
    ViewData["ActiveTab"] = "stores";
    var isSuperAdmin = ViewData["IsSuperAdmin"] as bool? ?? false;
    var profiled = ViewData["ProfiledStores"] as HashSet<string> ?? new();
    var categories = ViewData["Categories"] as List<string> ?? new();
    var categoryFilter = ViewData["LoyaltyFilter"]?.ToString() ?? "";
    var searchQuery = ViewData["SearchQuery"]?.ToString() ?? "";
}
@Html.AntiForgeryToken()

<div class="space-y-5">

    <!-- الترويسة -->
    <div class="page-header">
        <div>
            <h1 class="page-title">@ViewData["Title"]</h1>
            <p class="page-subtitle">المحلات المشاركة في برنامج الولاء</p>
        </div>
        <div class="page-actions">
            <a href="/AdminDashboard/StoreCodePrint" target="_blank" class="btn-secondary"><i data-lucide="qr-code" class="w-4 h-4"></i> طباعة باركود كل المتاجر</a>
            <a asp-action="InvoiceTemplates" class="btn-secondary"><i data-lucide="scan-text" class="w-4 h-4"></i> نماذج الفواتير</a>
            @if (isSuperAdmin)
            {
                <button type="button" onclick="openStoreForm()" class="btn-primary"><i data-lucide="plus" class="w-4 h-4"></i> متجر جديد</button>
            }
        </div>
    </div>

    <!-- مؤشرات -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="stat-card">
            <div class="text-sm font-medium text-slate-500">المتاجر</div>
            <div class="mt-2 text-2xl font-bold text-slate-900 num">@Model.Count</div>
        </div>
        <div class="stat-card">
            <div class="text-sm font-medium text-slate-500">نشطة</div>
            <div class="mt-2 text-2xl font-bold text-emerald-700 num">@Model.Count(s => s.IsActive)</div>
        </div>
        <div class="stat-card">
            <div class="text-sm font-medium text-slate-500">لها نموذج فاتورة</div>
            <div class="mt-2 text-2xl font-bold text-brand-700 num">@Model.Count(s => profiled.Contains(s.Id))</div>
        </div>
        <div class="stat-card">
            <div class="text-sm font-medium text-slate-500">المبيعات المعتمدة</div>
            <div class="mt-2 text-2xl font-bold text-slate-900"><span class="num">@Model.Sum(s => s.TotalSales).ToString("N0")</span> <span class="text-xs text-slate-400">د.ل</span></div>
        </div>
    </div>

    <!-- القائمة -->
    <div class="card overflow-hidden">
        <div class="p-4 border-b border-line flex flex-col md:flex-row md:items-center md:justify-between gap-3">
            <div class="flex flex-wrap items-center gap-1.5">
                <a asp-action="Stores" asp-route-search="@searchQuery" class="px-3 py-1.5 rounded-xl text-xs font-bold transition @(string.IsNullOrEmpty(categoryFilter) ? "bg-brand-700 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">الكل</a>
                @foreach (var c in categories)
                {
                    <a asp-action="Stores" asp-route-category="@c" asp-route-search="@searchQuery" class="px-3 py-1.5 rounded-xl text-xs font-bold transition @(categoryFilter == c ? "bg-brand-700 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">@c</a>
                }
            </div>
            <form method="get" asp-action="Stores" class="relative w-full md:w-72">
                <input type="hidden" name="category" value="@categoryFilter" />
                <input type="text" name="search" value="@searchQuery" placeholder="ابحث باسم المتجر أو الوحدة" class="form-input pr-9 text-sm">
                <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2"></i>
            </form>
        </div>

        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>المتجر</th>
                        <th>النشاط</th>
                        <th>الموقع</th>
                        <th>نقاط الباركود</th>
                        <th>العمولة</th>
                        <th>مسؤول التواصل</th>
                        <th>نموذج الفاتورة</th>
                        <th>الحالة</th>
                        <th class="text-left">إجراءات</th>
                    </tr>
                </thead>
                <tbody data-paginate="12">
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="9" class="py-12 text-center text-slate-500">لا توجد متاجر مطابقة.</td></tr>
                    }
                    @foreach (var s in Model)
                    {
                        <tr data-store="@System.Text.Json.JsonSerializer.Serialize(new { s.Id, s.Name, s.NameEn, s.Category, s.FloorNumber, s.UnitNumber, s.CommissionRate, s.ContactPerson, s.ContactPhone, s.IsActive, s.LogoUrl, s.CoverImageUrl, s.ScanPoints, s.ScanDailyLimit })"
                            class="@(s.IsActive ? "" : "opacity-60")">
                            <td>
                                <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-slate-100 overflow-hidden flex items-center justify-center shrink-0">
                                    @if (!string.IsNullOrEmpty(s.LogoUrl)) { <img src="@s.LogoUrl" alt="" class="w-full h-full object-cover" onerror="this.remove()" /> }
                                    else { <span class="font-bold text-slate-400">@(s.Name.Length > 0 ? s.Name[..1] : "م")</span> }
                                </div>
                                <div>
                                <div class="font-bold text-slate-900">@s.Name</div>
                                @if (!string.IsNullOrEmpty(s.NameEn) && s.NameEn != s.Name)
                                {
                                    <div class="text-xs text-slate-500" dir="ltr">@s.NameEn</div>
                                }
                                <div class="text-xs text-slate-400">المبيعات: <span class="num">@s.TotalSales.ToString("N0")</span> د.ل</div>
                                </div>
                                </div>
                            </td>
                            <td><span class="badge badge-slate">@s.Category</span></td>
                            <td class="text-xs text-slate-700">@(string.IsNullOrEmpty(s.FloorNumber) ? "" : s.FloorNumber + " • ")<span class="num" dir="ltr">@(string.IsNullOrEmpty(s.UnitNumber) ? "—" : s.UnitNumber)</span></td>
                            <td>@if ((s.ScanPoints ?? 0) > 0) { <span class="badge badge-amber num">@s.ScanPoints نقطة</span><div class="text-xs text-slate-500 mt-1">@(s.ScanDailyLimit ?? 1) مرة يومياً</div> } else { <span class="text-slate-400 text-sm">متوقف</span> }</td>
                            <td class="num font-bold text-slate-900">@s.CommissionRate.ToString("0.##")%</td>
                            <td>
                                <div class="text-xs font-semibold text-slate-800">@(s.ContactPerson ?? "—")</div>
                                <div class="text-xs text-slate-500 num" dir="ltr">@s.ContactPhone</div>
                            </td>
                            <td>
                                @if (profiled.Contains(s.Id))
                                {
                                    <span class="badge badge-emerald">موجود</span>
                                }
                                else
                                {
                                    <a asp-action="InvoiceTemplates" class="badge badge-amber hover:underline">علّمه الآن</a>
                                }
                            </td>
                            <td><span class="badge @(s.IsActive ? "badge-emerald" : "badge-rose")">@(s.IsActive ? "نشط" : "موقوف")</span></td>
                            <td class="text-left">
                                <div class="flex items-center gap-0.5 justify-end">
                                    <a href="/AdminDashboard/StoreCodePrint/@Uri.EscapeDataString(s.Id)" target="_blank" title="باركود المتجر وبطاقة NFC" class="btn-icon !w-8 !h-8"><i data-lucide="qr-code" class="w-4 h-4"></i></a>
                                @if (isSuperAdmin)
                                {
                                        <button type="button" onclick="openStoreForm(this)" title="تعديل" class="btn-icon !w-8 !h-8"><i data-lucide="pencil" class="w-4 h-4"></i></button>
                                        <button type="button" onclick="deleteStore(this)" title="حذف" class="btn-icon !w-8 !h-8 text-rose-600 hover:bg-rose-50"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                                }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- إضافة / تعديل متجر -->
<div id="store-modal" class="hidden modal-overlay">
    <div class="modal-box max-w-lg">
        <div class="modal-header">
            <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2"><i data-lucide="store" class="w-4 h-4 text-brand-600"></i> <span id="sf-title">متجر جديد</span></h3>
            <button type="button" onclick="MM.closeModal('store-modal')" class="btn-icon" aria-label="إغلاق"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>
        <div class="modal-body grid sm:grid-cols-2 gap-3">
            <div>
                <label class="form-label">اسم المتجر (عربي)</label>
                <input id="sf-name" class="form-input" />
            </div>
            <div>
                <label class="form-label">الاسم بالإنجليزية</label>
                <input id="sf-name-en" class="form-input" dir="ltr" />
            </div>
            <div class="sm:col-span-2">
                <label class="form-label">النشاط التجاري</label>
                <input id="sf-category" class="form-input" list="sf-categories" placeholder="مثال: أزياء وملابس" />
                <datalist id="sf-categories">
                    @foreach (var c in categories)
                    {
                        <option value="@c"></option>
                    }
                </datalist>
            </div>
            <div>
                <label class="form-label">الطابق</label>
                <input id="sf-floor" class="form-input" placeholder="الطابق الأرضي" />
            </div>
            <div>
                <label class="form-label">رقم الوحدة</label>
                <input id="sf-unit" class="form-input num" dir="ltr" placeholder="G-12" />
            </div>
            <div>
                <label class="form-label">مسؤول التواصل</label>
                <input id="sf-contact" class="form-input" />
            </div>
            <div>
                <label class="form-label">هاتف التواصل</label>
                <input id="sf-phone" class="form-input num" dir="ltr" placeholder="09XXXXXXXX" />
            </div>
            <div>
                <label class="form-label">عمولة المول (%)</label>
                <input id="sf-commission" type="number" min="0" max="100" step="0.5" class="form-input num" value="5" />
            </div>
            <div class="sm:col-span-2 rounded-xl border border-line p-3 grid grid-cols-2 gap-3">
                <div class="col-span-2 font-semibold text-sm text-slate-800 flex items-center gap-2"><i data-lucide="qr-code" class="w-4 h-4 text-brand-600"></i> نقاط الباركود وبطاقة NFC</div>
                <div>
                    <label class="form-label" for="sf-scan-points">النقاط لكل مسح</label>
                    <input id="sf-scan-points" type="number" min="0" max="10000" class="form-input num" value="10" />
                    <p class="form-hint">0 = الباركود متوقف لهذا المتجر</p>
                </div>
                <div>
                    <label class="form-label" for="sf-scan-limit">المرات المسموحة يومياً لكل عميل</label>
                    <input id="sf-scan-limit" type="number" min="1" max="20" class="form-input num" value="1" />
                </div>
            </div>
            <div class="sm:col-span-2 grid grid-cols-2 gap-3">
                <div>
                    <span class="form-label">شعار المتجر</span>
                    <div class="flex items-center gap-3">
                        <div class="w-16 h-16 rounded-2xl bg-slate-100 overflow-hidden flex items-center justify-center shrink-0"><img id="sf-logo-img" class="hidden w-full h-full object-cover" alt="" /><i id="sf-logo-ph" data-lucide="image" class="w-6 h-6 text-slate-300"></i></div>
                        <div class="space-y-1">
                            <label class="btn-secondary btn-sm cursor-pointer"><i data-lucide="upload" class="w-4 h-4"></i> رفع<input type="file" accept="image/jpeg,image/png,image/webp" class="hidden" onchange="uploadStoreImage(this, 'logo')" /></label>
                            <button type="button" class="block text-xs text-rose-600" onclick="setStoreImage('logo', null)">إزالة</button>
                        </div>
                    </div>
                    <input type="hidden" id="sf-logo" />
                </div>
                <div>
                    <span class="form-label">صورة الغلاف (واجهة المحل)</span>
                    <div class="flex items-center gap-3">
                        <div class="w-24 h-16 rounded-2xl bg-slate-100 overflow-hidden flex items-center justify-center shrink-0"><img id="sf-cover-img" class="hidden w-full h-full object-cover" alt="" /><i id="sf-cover-ph" data-lucide="image" class="w-6 h-6 text-slate-300"></i></div>
                        <div class="space-y-1">
                            <label class="btn-secondary btn-sm cursor-pointer"><i data-lucide="upload" class="w-4 h-4"></i> رفع<input type="file" accept="image/jpeg,image/png,image/webp" class="hidden" onchange="uploadStoreImage(this, 'cover')" /></label>
                            <button type="button" class="block text-xs text-rose-600" onclick="setStoreImage('cover', null)">إزالة</button>
                        </div>
                    </div>
                    <input type="hidden" id="sf-cover" />
                </div>
                <p class="col-span-2 form-hint">الشعار يظهر في قائمة المتاجر بالتطبيق، والغلاف أعلى صفحة المتجر. يفضّل صورة مربعة للشعار وعريضة للغلاف.</p>
            </div>
            <label id="sf-active-row" class="flex items-center gap-2 text-sm text-slate-700 self-end pb-2">
                <input id="sf-active" type="checkbox" class="form-check" checked /> المتجر نشط (يظهر للعملاء)
            </label>
        </div>
        <div class="modal-footer">
            <button type="button" onclick="MM.closeModal('store-modal')" class="btn-secondary">إلغاء</button>
            <button type="button" id="sf-save" onclick="saveStore()" class="btn-primary">حفظ</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const storeOf = btn => JSON.parse(btn.closest('tr').dataset.store);
    let editingStore = null;

    async function api(url, method, body) {
        const res = await fetch(url, {
            method, headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: body === undefined ? undefined : JSON.stringify(body)
        });
        const data = await res.json().catch(() => ({}));
        if (res.status === 403) throw new Error('هذه العملية للمدير العام فقط.');
        if (!res.ok || data.success === false) throw new Error(data.message || 'تعذّر تنفيذ العملية.');
        return data;
    }

    function openStoreForm(btn) {
        editingStore = btn ? storeOf(btn) : null;
        const s = editingStore || { CommissionRate: 5, IsActive: true };
        document.getElementById('sf-title').textContent = editingStore ? `تعديل: ${s.Name}` : 'متجر جديد';
        document.getElementById('sf-name').value = s.Name || '';
        document.getElementById('sf-name-en').value = s.NameEn && s.NameEn !== s.Name ? s.NameEn : '';
        document.getElementById('sf-category').value = s.Category || '';
        document.getElementById('sf-floor').value = s.FloorNumber || '';
        document.getElementById('sf-unit').value = s.UnitNumber || '';
        document.getElementById('sf-contact').value = s.ContactPerson || '';
        document.getElementById('sf-phone').value = s.ContactPhone || '';
        document.getElementById('sf-commission').value = s.CommissionRate;
        document.getElementById('sf-active').checked = s.IsActive;
        document.getElementById('sf-active-row').classList.toggle('hidden', !editingStore);
        document.getElementById('sf-scan-points').value = s.ScanPoints ?? 10;
        document.getElementById('sf-scan-limit').value = s.ScanDailyLimit ?? 1;
        setStoreImage('logo', s.LogoUrl || null);
        setStoreImage('cover', s.CoverImageUrl || null);
        MM.openModal('store-modal');
    }

    function setStoreImage(kind, url) {
        document.getElementById(`sf-${kind}`).value = url || '';
        const img = document.getElementById(`sf-${kind}-img`);
        img.classList.toggle('hidden', !url);
        document.getElementById(`sf-${kind}-ph`)?.classList.toggle('hidden', !!url);
        img.onerror = () => { img.classList.add('hidden'); document.getElementById(`sf-${kind}-ph`)?.classList.remove('hidden'); };
        if (url) img.src = url;
    }

    async function uploadStoreImage(input, kind) {
        const file = input.files[0];
        if (!file) return;
        const form = new FormData();
        form.append('file', file);
        try {
            const res = await fetch('/AdminDashboard/StoreImage', { method: 'POST', headers: { 'RequestVerificationToken': token }, body: form });
            const d = await res.json().catch(() => ({}));
            if (!res.ok || d.success === false) throw new Error(d.message || 'تعذّر رفع الصورة.');
            setStoreImage(kind, d.url);
        } catch (e) { showToast(e.message, 'error'); }
        input.value = '';
    }

    async function saveStore() {
        const v = id => document.getElementById(id).value.trim();
        const body = {
            name: v('sf-name'), nameEn: v('sf-name-en') || null, category: v('sf-category'),
            floorNumber: v('sf-floor'), unitNumber: v('sf-unit'), contactPerson: v('sf-contact') || null,
            contactPhone: v('sf-phone') || null, commissionRate: parseFloat(v('sf-commission')) || 0,
            isActive: document.getElementById('sf-active').checked,
            logoUrl: document.getElementById('sf-logo').value || null,
            scanPoints: parseInt(document.getElementById('sf-scan-points').value, 10) || 0,
            scanDailyLimit: parseInt(document.getElementById('sf-scan-limit').value, 10) || 1,
            coverImageUrl: document.getElementById('sf-cover').value || null
        };
        if (!body.name || !body.category) return showToast('أدخل اسم المتجر ونشاطه.', 'warning');
        const btn = document.getElementById('sf-save');
        btn.disabled = true;
        try {
            const d = editingStore
                ? await api(`/api/superadmin/stores/${encodeURIComponent(editingStore.Id)}`, 'PUT', body)
                : await api('/api/superadmin/stores', 'POST', body);
            showToast(d.message || 'تمت إضافة المتجر.', 'success');
            setTimeout(() => location.reload(), 500);
        } catch (e) {
            showToast(e.message, 'error');
        } finally {
            btn.disabled = false;
        }
    }

    async function deleteStore(btn) {
        const s = storeOf(btn);
        const ok = await Swal.fire({
            title: `حذف ${s.Name}؟`,
            text: 'إن كانت للمتجر فواتير أو موظفون يُوقَف فقط ولا يظهر للعملاء، مع الحفاظ على سجلاته.',
            icon: 'warning', showCancelButton: true, confirmButtonText: 'حذف', cancelButtonText: 'إلغاء',
            customClass: { confirmButton: 'btn-danger', cancelButton: 'btn-secondary' }
        });
        if (!ok.isConfirmed) return;
        try {
            const d = await api(`/api/superadmin/stores/${encodeURIComponent(s.Id)}`, 'DELETE');
            showToast(d.message, 'success');
            setTimeout(() => location.reload(), 700);
        } catch (e) {
            showToast(e.message, 'error');
        }
    }
</script>
}
