@model MMApplication.Api.ViewModels.FraudPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "مركز التدقيق ومكافحة الاحتيال";
    ViewData["ActiveTab"] = "fraud";
}

<div class="space-y-6">

    <!-- 1. Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
        <div>
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
                    <i data-lucide="shield-alert" class="w-5 h-5"></i>
                </div>
                <div>
                    <h1 class="text-base font-bold text-slate-900">مركز التدقيق ومكافحة الاحتيال المالي</h1>
                    <p class="text-xs text-slate-500">كشف تكرار الفواتير، فحص الحسابات المتعددة على جهاز واحد، ومراجعة اعتراضات المتسوقين</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <button onclick="openModal('modal-add-invoice')" class="btn-secondary">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>إدخال فاتورة يدوية</span>
            </button>
            <button onclick="window.location.reload()" class="btn-primary">
                <i data-lucide="rotate-cw" class="w-4 h-4"></i>
                <span>تحديث الطابور</span>
            </button>
        </div>
    </div>

    <!-- 2. KPI Summary Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">بانتظار المراجعة</span>
                <i data-lucide="hourglass" class="w-4 h-4 text-amber-500"></i>
            </div>
            <div class="text-xl font-bold text-amber-600 num">@Model.QueueItems.Count</div>
            <div class="text-[11px] text-amber-700 mt-1">تتطلب قرار مدقق مالي</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">خطر مرتفع (>70%)</span>
                <i data-lucide="flame" class="w-4 h-4 text-rose-500"></i>
            </div>
            <div class="text-xl font-bold text-rose-600 num">@Model.HighRiskCount</div>
            <div class="text-[11px] text-rose-700 mt-1">احتمالية تكرار أو تلاعب</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">اعتراضات المتسوقين</span>
                <i data-lucide="scale" class="w-4 h-4 text-purple-500"></i>
            </div>
            <div class="text-xl font-bold text-purple-600 num">@Model.DisputedCount</div>
            <div class="text-[11px] text-purple-700 mt-1">مرفوعة عبر التطبيق</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">بانتظار إعادة التصوير</span>
                <i data-lucide="camera" class="w-4 h-4 text-blue-500"></i>
            </div>
            <div class="text-xl font-bold text-blue-600 num">@Model.ResubmitCount</div>
            <div class="text-[11px] text-blue-700 mt-1">صورة غير واضحة</div>
        </div>
    </div>

    <!-- 3. Audit Queue Container -->
    <div class="card p-5 space-y-4">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
            <!-- Filter Pills -->
            <div class="flex flex-wrap items-center gap-2">
                <a asp-action="Fraud" asp-route-statusFilter="ALL" class="px-3 py-1.5 rounded-lg text-xs font-semibold @(Model.StatusFilter == "ALL" ? "bg-blue-600 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200") transition">
                    الكل (@Model.QueueItems.Count)
                </a>
                <a asp-action="Fraud" asp-route-statusFilter="SUSPECT" class="px-3 py-1.5 rounded-lg text-xs font-semibold @(Model.StatusFilter == "SUSPECT" ? "bg-blue-600 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200") transition">
                    مشتبه بها (30-70%)
                </a>
                <a asp-action="Fraud" asp-route-statusFilter="FLAGGED" class="px-3 py-1.5 rounded-lg text-xs font-semibold @(Model.StatusFilter == "FLAGGED" ? "bg-blue-600 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200") transition">
                    عالية الخطورة (>70%)
                </a>
                <a asp-action="Fraud" asp-route-statusFilter="DISPUTED" class="px-3 py-1.5 rounded-lg text-xs font-semibold @(Model.StatusFilter == "DISPUTED" ? "bg-blue-600 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200") transition">
                    اعتراضات (@Model.DisputedCount)
                </a>
                <a asp-action="Fraud" asp-route-statusFilter="RESUBMIT" class="px-3 py-1.5 rounded-lg text-xs font-semibold @(Model.StatusFilter == "RESUBMIT" ? "bg-blue-600 text-white" : "bg-slate-100 text-slate-700 hover:bg-slate-200") transition">
                    إعادة تصوير (@Model.ResubmitCount)
                </a>
            </div>

            <!-- Health Status -->
            <div class="flex items-center gap-2 text-xs text-slate-500">
                <span>دقة المنظومة:</span>
                <span class="badge badge-emerald num font-bold">@Model.SystemAccuracyPercentage%</span>
            </div>
        </div>

        <!-- Invoices List -->
        <div class="space-y-3">
            @if (Model.QueueItems.Count == 0)
            {
                <div class="py-12 text-center text-slate-400">
                    <i data-lucide="check-circle-2" class="w-10 h-10 mx-auto mb-2 text-emerald-500"></i>
                    <div class="font-bold text-slate-800 text-sm">طابور التدقيق فارغ حالياً</div>
                    <p class="text-xs text-slate-400 mt-0.5">تم تدقيق ومراجعة كافة الفواتير والاعتراضات بنجاح.</p>
                </div>
            }
            @foreach (var item in Model.QueueItems)
            {
                var isHighRisk = item.RiskScore > 70;
                var isMediumRisk = item.RiskScore >= 30;

                <div class="p-4 rounded-xl border @(isHighRisk ? "border-rose-200 bg-rose-50/20" : (isMediumRisk ? "border-amber-200 bg-amber-50/20" : "border-slate-200 bg-white")) space-y-3 hover:border-slate-300 transition">
                    
                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                        <div class="space-y-1.5 flex-1">
                            
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="badge badge-slate font-mono font-bold">
                                    #@(string.IsNullOrWhiteSpace(item.InvoiceNumber) ? item.Id.ToString()[..8] : item.InvoiceNumber)
                                </span>
                                <span class="text-xs text-slate-400 num">@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</span>

                                @if (item.HasHashMatch)
                                {
                                    <span class="badge badge-rose">تطابق بصمة رقمية pHash</span>
                                }

                                @if (item.SharedAccountsCount > 1)
                                {
                                    <span class="badge badge-amber flex items-center gap-1">
                                        <i data-lucide="smartphone" class="w-3 h-3"></i>
                                        <span>أجهزة متعددة (@item.SharedAccountsCount حسابات)</span>
                                    </span>
                                }

                                @if (item.Status == MMApplication.Domain.Enums.InvoiceStatus.DISPUTED)
                                {
                                    <span class="badge badge-blue">⚖️ اعتراض متسوق</span>
                                }
                                else if (item.Status == MMApplication.Domain.Enums.InvoiceStatus.RESUBMISSION_REQUESTED)
                                {
                                    <span class="badge badge-slate">🔄 بانتظار إعادة التصوير</span>
                                }
                            </div>

                            <div class="text-xs text-slate-800 font-medium">
                                المتجر: <span class="font-bold text-slate-900">@item.MerchantName</span> &bull; 
                                المتسوق: <span class="font-semibold text-slate-900">@item.CustomerName</span> 
                                <span class="text-slate-400 num">(@item.CustomerPhone)</span>
                            </div>

                            <p class="text-xs text-slate-500">
                                @(string.IsNullOrWhiteSpace(item.FraudFlagReason) ? "اشتباه تلقائي بناءً على معايير الفحص المالي." : item.FraudFlagReason)
                            </p>

                            @if (!string.IsNullOrWhiteSpace(item.DisputeReason))
                            {
                                <div class="text-xs bg-purple-50 text-purple-900 p-2.5 rounded-lg border border-purple-200">
                                    <span class="font-bold">ملاحظات اعتراض المتسوق:</span> @item.DisputeReason
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.ResubmissionNotes))
                            {
                                <div class="text-xs bg-blue-50 text-blue-900 p-2.5 rounded-lg border border-blue-200">
                                    <span class="font-bold">ملاحظات إعادة التصوير:</span> @item.ResubmissionNotes
                                </div>
                            }
                        </div>

                        <!-- Risk Score Badge -->
                        <div class="text-center shrink-0">
                            <span class="badge @(isHighRisk ? "badge-rose" : (isMediumRisk ? "badge-amber" : "badge-emerald")) num text-xs px-3 py-1 font-bold">
                                نسبة الخطورة: @item.RiskScore%
                            </span>
                        </div>
                    </div>

                    <!-- Footer Row: Amount & Actions -->
                    <div class="pt-2.5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
                        <div class="flex items-center gap-4">
                            <div>
                                <span class="text-slate-400">القيمة:</span>
                                <span class="font-bold text-slate-900 num">@item.TotalAmount.ToString("N2") د.ل</span>
                            </div>
                            <div>
                                <span class="text-slate-400">النقاط:</span>
                                <span class="font-bold text-emerald-600 num">+@item.PointsEarned</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <button onclick="openFraudInspectModal('@item.Id', '@item.MerchantName', '@(item.InvoiceNumber ?? item.Id.ToString()[..8])', '@item.TotalAmount', '@item.CustomerName', '@item.CustomerPhone', @item.RiskScore, '@(item.FraudFlagReason ?? "")', '@(item.ImageUrl ?? "")', '@item.Status', '@(item.DisputeReason ?? "")', '@(item.ResubmissionNotes ?? "")', @item.SharedAccountsCount)" class="btn-primary py-1.5 px-3 text-xs">
                                <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                                <span>غرفة التدقيق</span>
                            </button>
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>

</div>

<!-- Modal: Fraud Inspection -->
<div id="modal-fraud-inspect" class="fixed inset-0 z-50 modal-overlay hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-2xl w-full border border-slate-200 shadow-2xl p-6 space-y-4 max-h-[90vh] overflow-y-auto">
        
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div class="flex items-center gap-2">
                <i data-lucide="shield-alert" class="w-5 h-5 text-amber-600"></i>
                <h3 class="text-sm font-bold text-slate-900">غرفة تدقيق الفاتورة ومكافحة الاحتيال</h3>
            </div>
            <button onclick="closeModal('modal-fraud-inspect')" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <input type="hidden" id="fraud-modal-invoice-id">

        <div class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                    <div class="flex justify-between items-center text-xs">
                        <span class="font-bold text-slate-900">صورة الفاتورة</span>
                        <span id="fraud-modal-risk-badge" class="badge badge-amber num font-bold">Risk: 82%</span>
                    </div>
                    <img id="fraud-modal-img" src="" alt="الفاتورة" class="w-full h-44 object-cover rounded-lg bg-white border border-slate-200">
                    <div class="text-xs space-y-1">
                        <div>المتجر: <b id="fraud-modal-merchant" class="text-slate-900">-</b></div>
                        <div>رقم الفاتورة: <b id="fraud-modal-num" class="font-mono text-slate-900">-</b></div>
                        <div>المبلغ: <b id="fraud-modal-amount" class="text-emerald-700 font-mono">-</b></div>
                        <div>المتسوق: <b id="fraud-modal-customer" class="text-slate-900">-</b></div>
                    </div>
                </div>

                <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 flex flex-col justify-between space-y-2">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">توجيهات وملاحظات المدقق:</label>
                        <textarea id="fraud-decision-reason" rows="5" placeholder="سبب الرفض أو توجيهات إعادة التصوير للعميل..." class="w-full text-xs p-2.5 rounded-lg border border-slate-300 bg-white text-slate-800 focus:outline-none focus:border-blue-600"></textarea>
                    </div>
                    <p class="text-[11px] text-slate-400 leading-relaxed">
                        * يتم توثيق أي قرار تلقائياً في سجل الرقابة والأمان (Audit Log).
                    </p>
                </div>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2 pt-3 border-t border-slate-100">
            <button onclick="executeFraudAction('APPROVE')" class="btn-primary bg-emerald-600 hover:bg-emerald-700">
                <i data-lucide="check" class="w-4 h-4"></i>
                <span>اعتماد الفاتورة</span>
            </button>
            <button onclick="executeFraudAction('REQUEST_RESCAN')" class="btn-secondary">
                <i data-lucide="camera" class="w-4 h-4"></i>
                <span>طلب إعادة التصوير</span>
            </button>
            <button onclick="executeFraudAction('REJECT')" class="btn-danger">
                <i data-lucide="x" class="w-4 h-4"></i>
                <span>رفض الفاتورة</span>
            </button>
            <button onclick="closeModal('modal-fraud-inspect')" class="btn-secondary mr-auto">
                إلغاء
            </button>
        </div>

    </div>
</div>

<script>
    function openModal(id) {
        document.getElementById(id).classList.remove('hidden');
    }

    function closeModal(id) {
        document.getElementById(id).classList.add('hidden');
    }

    function openFraudInspectModal(id, merchant, num, amount, customer, phone, risk, reason, img, status, disputeReason, resubmissionNotes, sharedCount) {
        document.getElementById('fraud-modal-invoice-id').value = id;
        document.getElementById('fraud-modal-merchant').textContent = merchant;
        document.getElementById('fraud-modal-num').textContent = num;
        document.getElementById('fraud-modal-amount').textContent = `${parseFloat(amount).toFixed(2)} د.ل`;
        document.getElementById('fraud-modal-customer').textContent = `${customer} (${phone})`;
        document.getElementById('fraud-modal-risk-badge').textContent = `الخطورة: ${risk}%`;
        document.getElementById('fraud-modal-img').src = img || '/images/receipt-placeholder.png';
        document.getElementById('fraud-decision-reason').value = '';

        openModal('modal-fraud-inspect');
    }

    async function executeFraudAction(action) {
        const invoiceId = document.getElementById('fraud-modal-invoice-id').value;
        const reason = document.getElementById('fraud-decision-reason').value.trim();

        try {
            const res = await fetch(`/api/SuperAdmin/fraud/invoices/${invoiceId}/review`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action, reason: reason || null })
            });

            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.message || 'فشل تنفيذ الإجراء');

            closeModal('modal-fraud-inspect');
            Swal.fire({ icon: 'success', title: 'تم اتخاذ القرار', text: data.message || 'تم بنجاح.' })
                .then(() => location.reload());
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'خطأ', text: err.message });
        }
    }
</script>
