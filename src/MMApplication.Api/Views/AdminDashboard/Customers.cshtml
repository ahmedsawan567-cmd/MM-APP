@model List<MMApplication.Application.DTOs.SuperAdminCustomerDto>
@using MMApplication.Api.ViewModels
@{
    Layout = "_Layout";
    ViewData["Title"] = "العملاء";
    ViewData["ActiveTab"] = "customers";
    var canEdit = ViewData["CanEditCustomers"] as bool? ?? false;
    var canOpen = ViewData["CanOpenProfile"] as bool? ?? false;
    var isSuperAdmin = ViewData["IsSuperAdmin"] as bool? ?? false;
    var canDelete = ViewData["CanDelete"] as bool? ?? false;
    var canExport = ViewData["CanExport"] as bool? ?? false;
    var tierFilter = (ViewData["TierFilter"]?.ToString() ?? "ALL").ToUpperInvariant();
    var statusFilter = ViewData["StatusFilter"]?.ToString() ?? "ALL";
    var sort = ViewData["Sort"]?.ToString() ?? "new";
    var search = ViewData["SearchQuery"]?.ToString() ?? "";
    var page = (int)(ViewData["Page"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalFiltered = (int)(ViewData["TotalFiltered"] ?? 0);
    var statTotal = (int)(ViewData["StatTotal"] ?? 0);
    var statFrozen = (int)(ViewData["StatFrozen"] ?? 0);
    var statApp = (int)(ViewData["StatApp"] ?? 0);
    var statPoints = (int)(ViewData["StatPoints"] ?? 0);
    var statNew30 = (int)(ViewData["StatNew30"] ?? 0);
    var statShared = (int)(ViewData["StatShared"] ?? 0);
    var tiers = new[] { ("ALL", "كل الفئات"), ("VIP", "VIP"), ("GOLD", "ذهبي"), ("SILVER", "فضي"), ("BRONZE", "برونزي") };
    var statuses = new[] { ("ALL", "الكل"), ("ACTIVE", "نشط"), ("FROZEN", "مجمّد"), ("NOAPP", "بدون تطبيق"), ("SHARED", "جهاز مشترك"), ("DELETED", "محذوف") };
    var sorts = new[] { ("new", "الأحدث تسجيلاً"), ("old", "الأقدم تسجيلاً"), ("points", "الأعلى نقاطاً"), ("spent", "الأعلى إنفاقاً"), ("invoices", "الأكثر فواتير"), ("name", "الاسم") };
    string Url(string? tier = null, string? status = null, string? sortBy = null, int? pg = null, string? export = null) =>
        Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/AdminDashboard/Customers", new Dictionary<string, string?>
        {
            ["tier"] = tier ?? tierFilter, ["status"] = status ?? statusFilter, ["sort"] = sortBy ?? sort,
            ["search"] = string.IsNullOrEmpty(search) ? null : search, ["page"] = (pg ?? 1) > 1 ? pg.ToString() : null, ["export"] = export,
        }.Where(kv => kv.Value != null).ToDictionary(kv => kv.Key, kv => kv.Value));
}
@Html.AntiForgeryToken()

<div class="space-y-5">

    <div class="page-header">
        <div>
            <h1 class="page-title">العملاء</h1>
            <p class="page-subtitle">كل عميل له رقم عضوية مميز، ورقم الهاتف لا يتكرر. اضغط على أي عميل لفتح ملفه الكامل.</p>
        </div>
        <div class="page-actions">
            @if (canExport)
            {
            <a href="@Url(export: "csv")" class="btn-secondary @(totalFiltered == 0 ? "pointer-events-none opacity-50" : "")">
                <i data-lucide="download" class="w-4 h-4"></i> تصدير Excel
            </a>
            }
            @if (canEdit)
            {
                <button type="button" onclick="MMCustomers.openForm()" class="btn-primary">
                    <i data-lucide="user-plus" class="w-4 h-4"></i> عميل جديد
                </button>
            }
        </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="stat-card">
            <div class="flex items-center justify-between"><span class="stat-label">إجمالي العملاء</span><span class="stat-icon bg-brand-50 text-brand-600"><i data-lucide="users" class="w-5 h-5"></i></span></div>
            <div class="stat-value num">@statTotal.ToString("N0")</div>
            <div class="stat-meta"><span class="num">+@statNew30</span> خلال آخر 30 يوماً</div>
        </div>
        <div class="stat-card">
            <div class="flex items-center justify-between"><span class="stat-label">يستخدمون التطبيق</span><span class="stat-icon bg-emerald-50 text-emerald-600"><i data-lucide="smartphone" class="w-5 h-5"></i></span></div>
            <div class="stat-value num">@statApp.ToString("N0")</div>
            <div class="stat-meta"><span class="num">@(statTotal == 0 ? 0 : Math.Round(100.0 * statApp / statTotal))%</span> من العملاء</div>
        </div>
        <div class="stat-card">
            <div class="flex items-center justify-between"><span class="stat-label">نقاط في أرصدة العملاء</span><span class="stat-icon bg-amber-50 text-amber-600"><i data-lucide="coins" class="w-5 h-5"></i></span></div>
            <div class="stat-value text-gold-600 num">@statPoints.ToString("N0")</div>
            <div class="stat-meta">نقاط لم تُستبدل بعد</div>
        </div>
        <a href="@Url(status: statShared > 0 ? "SHARED" : "FROZEN")" class="stat-card hover:border-amber-300 transition">
            <div class="flex items-center justify-between"><span class="stat-label">تحتاج انتباه</span><span class="stat-icon bg-rose-50 text-rose-600"><i data-lucide="shield-alert" class="w-5 h-5"></i></span></div>
            <div class="stat-value num @(statShared + statFrozen > 0 ? "text-rose-600" : "")">@(statShared + statFrozen)</div>
            <div class="stat-meta">جهاز مشترك <span class="num">@statShared</span> • مجمّد <span class="num">@statFrozen</span></div>
        </a>
    </div>

    <div class="grid lg:grid-cols-3 gap-4">
        <div class="card p-5 space-y-3 lg:col-span-2">
            <div>
                <h3 class="card-title">العملاء الجدد شهرياً</h3>
                <p class="card-subtitle">عدد الحسابات المسجّلة في آخر 6 أشهر</p>
            </div>
            <div id="customerGrowthChart" class="w-full h-44"></div>
        </div>
        <div class="card p-5 space-y-3">
            <div>
                <h3 class="card-title">توزيع الفئات</h3>
                <p class="card-subtitle">العملاء حسب فئة العضوية</p>
            </div>
            <div id="tierChart" class="w-full h-44"></div>
        </div>
    </div>

    <div class="card overflow-hidden">
        <div class="p-4 border-b border-line space-y-3">
            <div class="flex flex-col lg:flex-row lg:items-center gap-3">
                <form method="get" action="/AdminDashboard/Customers" class="relative flex-1">
                    <input type="hidden" name="tier" value="@tierFilter">
                    <input type="hidden" name="status" value="@statusFilter">
                    <input type="hidden" name="sort" value="@sort">
                    <input type="search" name="search" value="@search" placeholder="ابحث بالاسم، الهاتف، رقم العضوية أو البريد" class="form-input pr-9">
                    <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2"></i>
                </form>
                <div class="flex gap-2">
                    <select class="form-select w-auto" onchange="location.href=this.value" aria-label="الفئة">
                        @foreach (var (value, label) in tiers)
                        {
                            <option value="@Url(tier: value)" selected="@(tierFilter == value)">@label</option>
                        }
                    </select>
                    <select class="form-select w-auto" onchange="location.href=this.value" aria-label="الترتيب">
                        @foreach (var (value, label) in sorts)
                        {
                            <option value="@Url(sortBy: value)" selected="@(sort == value)">@label</option>
                        }
                    </select>
                </div>
            </div>
            <div class="tabs w-fit max-w-full">
                @foreach (var (value, label) in statuses)
                {
                    <a href="@Url(status: value)" class="tab @(statusFilter == value ? "tab-active" : "")">@label</a>
                }
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>العميل</th>
                        <th>رقم العضوية</th>
                        <th>الفئة</th>
                        <th>النقاط</th>
                        <th>الفواتير</th>
                        <th>الإنفاق المعتمد</th>
                        <th>الحالة</th>
                        <th class="text-left"></th>
                    </tr>
                </thead>
                <tbody id="customers-body">
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <div class="empty-state-icon"><i data-lucide="users-round" class="w-6 h-6"></i></div>
                                    <div class="font-bold text-slate-700">لا يوجد عملاء مطابقون</div>
                                    <p class="text-sm text-slate-500">جرّب البحث برقم العضوية أو رقم الهاتف، أو غيّر التصفية</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var c in Model)
                    {
                        var profile = $"/AdminDashboard/CustomerDetails/{Uri.EscapeDataString(c.Id)}";
                        var initial = c.FullName.Trim().Length > 0 ? c.FullName.Trim()[..1] : "ع";
                        <tr data-customer="@System.Text.Json.JsonSerializer.Serialize(new { c.Id, c.MembershipNumber, c.FullName, c.PhoneNumber, c.Email, BirthDate = c.BirthDate?.ToString("yyyy-MM-dd"), c.Gender, Tier = c.Tier.ToUpperInvariant(), c.CurrentPoints, c.IsSuspended })"
                            class="@(c.IsArchived ? "opacity-60" : "") @(canOpen ? "cursor-pointer hover:bg-slate-50" : "")" @if (canOpen) { <text>onclick="openRow(event, '@profile')"</text> }>
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-xl bg-brand-50 text-brand-700 font-bold flex items-center justify-center shrink-0">@initial</div>
                                    <div class="min-w-0">
                                        <div class="font-bold text-slate-900 flex items-center gap-1.5 flex-wrap">
                                            @c.FullName
                                            @if (c.IsMultiAccountDevice)
                                            {
                                                <span class="badge badge-amber !py-0.5" title="الجهاز مستخدم من @c.SharedDevicesCount حسابات"><i data-lucide="smartphone" class="w-3 h-3"></i> مشترك</span>
                                            }
                                        </div>
                                        <div class="text-xs text-slate-500 num" dir="ltr">@c.PhoneNumber</div>
                                    </div>
                                </div>
                            </td>
                            <td class="font-bold text-brand-700 num whitespace-nowrap" dir="ltr">@(c.MembershipNumber ?? "—")</td>
                            <td><span class="badge @DisplayLabels.TierBadge(c.Tier)">@DisplayLabels.Tier(c.Tier)</span></td>
                            <td class="num font-bold text-slate-900">@c.CurrentPoints.ToString("N0")</td>
                            <td class="num text-slate-700">@c.TotalInvoicesScanned</td>
                            <td class="num font-semibold text-slate-700 whitespace-nowrap">@c.TotalSpent.ToString("N2") <span class="text-xs text-slate-400">د.ل</span></td>
                            <td>
                                @if (c.IsArchived) { <span class="badge badge-slate">محذوف</span> }
                                else if (c.IsSuspended) { <span class="badge badge-rose">مجمّد</span> }
                                else if (!c.HasAppAccess) { <span class="badge badge-slate">بدون تطبيق</span> }
                                else { <span class="badge badge-emerald">نشط</span> }
                            </td>
                            <td class="text-left" data-no-row>
                                @if (canEdit && !c.IsArchived)
                                {
                                    <div class="relative inline-block">
                                        <button type="button" class="btn-icon !w-8 !h-8" onclick="MM.dropdown('m-@c.Id')" aria-haspopup="menu" aria-label="إجراءات"><i data-lucide="ellipsis" class="w-4 h-4"></i></button>
                                        <div id="m-@c.Id" class="dropdown left-0 hidden text-right" role="menu">
                                            <a class="dropdown-item" href="@profile"><i data-lucide="user-round" class="w-4 h-4"></i> الملف الكامل</a>
                                            <button type="button" class="dropdown-item" onclick="act('openForm', this)"><i data-lucide="pencil" class="w-4 h-4"></i> تعديل البيانات</button>
                                            <button type="button" class="dropdown-item" onclick="act('openNotify', this)"><i data-lucide="send" class="w-4 h-4"></i> إرسال إشعار</button>
                                            @if (isSuperAdmin)
                                            {
                                                <button type="button" class="dropdown-item" onclick="act('openPoints', this)"><i data-lucide="coins" class="w-4 h-4"></i> تعديل النقاط</button>
                                            }
                                            <button type="button" class="dropdown-item" onclick="act('resetPassword', this)"><i data-lucide="key-round" class="w-4 h-4"></i> كلمة مرور جديدة</button>
                                            <button type="button" class="dropdown-item" onclick="act('toggleSuspend', this)"><i data-lucide="@(c.IsSuspended ? "lock-open" : "lock")" class="w-4 h-4"></i> @(c.IsSuspended ? "تنشيط الحساب" : "تجميد الحساب")</button>
                                            @if (canDelete)
                                            {
                                                <div class="my-1 border-t border-line"></div>
                                                <button type="button" class="dropdown-item !text-rose-600" onclick="act('remove', this)"><i data-lucide="trash-2" class="w-4 h-4"></i> حذف العميل</button>
                                            }
                                        </div>
                                    </div>
                                }
                                else if (canOpen)
                                {
                                    <a href="@profile" class="btn-icon !w-8 !h-8" title="الملف الكامل"><i data-lucide="chevron-left" class="w-4 h-4"></i></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="p-4 border-t border-line flex items-center justify-between gap-3 text-sm">
            <span class="text-slate-500"><span class="num">@totalFiltered.ToString("N0")</span> عميل @(totalPages > 1 ? $"• صفحة {page} من {totalPages}" : "")</span>
            @if (totalPages > 1)
            {
                <div class="flex gap-2">
                    <a href="@Url(pg: page - 1)" class="btn-secondary btn-sm @(page <= 1 ? "pointer-events-none opacity-50" : "")"><i data-lucide="chevron-right" class="w-4 h-4"></i> السابق</a>
                    <a href="@Url(pg: page + 1)" class="btn-secondary btn-sm @(page >= totalPages ? "pointer-events-none opacity-50" : "")">التالي <i data-lucide="chevron-left" class="w-4 h-4"></i></a>
                </div>
            }
        </div>
    </div>
</div>

<partial name="_CustomerModals" />

@section Scripts {
<script src="~/js/customers.js" asp-append-version="true"></script>
<script>
    const rowData = el => JSON.parse(el.closest('tr').dataset.customer);
    function act(fn, el) { MMCustomers[fn](rowData(el)); }
    function openRow(e, url) {
        if (e.target.closest('[data-no-row], a, button, .dropdown')) return;
        location.href = url;
    }

    document.addEventListener('DOMContentLoaded', () => {
        const monthly = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["MonthlyRegistrations"]));
        const tiers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["TierCounts"]));
        const growth = document.getElementById('customerGrowthChart');
        if (growth && window.ApexCharts) {
            MM.chart(growth, () => ({
                series: [{ name: 'عملاء جدد', data: monthly.map(m => m.count) }],
                chart: { type: 'bar', height: 170, animations: { enabled: false } },
                colors: [MM.color('chart-primary')],
                plotOptions: { bar: { borderRadius: 4, borderRadiusApplication: 'end', columnWidth: '45%' } },
                dataLabels: { enabled: false },
                xaxis: { categories: monthly.map(m => m.label) },
                yaxis: { forceNiceScale: true, labels: { formatter: v => Math.round(v) } },
                tooltip: { y: { formatter: v => v + ' عميل' } }
            }));
        }
        const tierEl = document.getElementById('tierChart');
        const order = [['VIP', 'VIP'], ['GOLD', 'ذهبي'], ['SILVER', 'فضي'], ['BRONZE', 'برونزي']];
        const tierData = order.map(([k]) => (tiers.find(t => t.tier === k) || {}).count || 0);
        if (tierEl && window.ApexCharts) {
            MM.chart(tierEl, () => ({
                series: [{ name: 'عملاء', data: tierData }],
                chart: { type: 'bar', height: 170, animations: { enabled: false } },
                colors: [MM.color('chart-primary', 0.65)],
                plotOptions: { bar: { horizontal: true, borderRadius: 4, borderRadiusApplication: 'end', barHeight: '55%' } },
                xaxis: { categories: order.map(([, l]) => l), tickAmount: Math.max(1, Math.min(5, Math.max(...tierData))), labels: { formatter: v => Math.round(v) } },
                dataLabels: { enabled: true, style: { fontSize: '12px' } },
                tooltip: { y: { formatter: v => v + ' عميل' } }
            }));
        }
    });
</script>
}
