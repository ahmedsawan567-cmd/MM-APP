@model MMApplication.Api.Services.ReportData
@{
    Layout = "_Layout";
    ViewData["Title"] = "التقارير والإحصائيات";
    var range = ViewData["Range"] as string ?? "30d";
    var stores = ViewData["Stores"] as List<MMApplication.Api.ViewModels.ReviewStoreOption> ?? new();
    var f = Model.Filter;
    var query = $"range={range}&from={f.From:yyyy-MM-dd}&to={f.To:yyyy-MM-dd}&storeId={f.TenantId}";
    var presets = new[] { ("7d", "7 أيام"), ("30d", "30 يوماً"), ("month", "هذا الشهر"), ("90d", "90 يوماً") };
    string Money(decimal v) => v.ToString("N2");
}

<div class="space-y-5">

    <!-- الترويسة والفلاتر (صف واحد فوق كل المخططات) -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200 space-y-4">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center">
                    <i data-lucide="chart-no-axes-combined" class="w-5 h-5"></i>
                </div>
                <div>
                    <h1 class="text-base font-bold text-slate-900">التقارير والإحصائيات</h1>
                    <p class="text-xs text-slate-500">
                        من <span dir="ltr">@f.From.ToString("yyyy/MM/dd")</span> إلى <span dir="ltr">@f.To.ToString("yyyy/MM/dd")</span>
                        @if (Model.TenantName != null) { <span>— @Model.TenantName</span> }
                    </p>
                </div>
            </div>
            <a href="/AdminDashboard/ReportsExport?@query" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-brand-700 hover:bg-brand-800 text-white text-sm font-bold">
                <i data-lucide="file-spreadsheet" class="w-4 h-4"></i> تصدير Excel
            </a>
        </div>

        <form method="get" class="flex flex-wrap items-end gap-2">
            <div class="flex flex-wrap gap-1.5">
                @foreach (var (key, label) in presets)
                {
                    <a href="?range=@key&storeId=@f.TenantId" class="px-3 py-2 rounded-xl text-xs font-semibold border @(range == key ? "bg-ink text-surface border-slate-900" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50")">@label</a>
                }
            </div>
            <input type="hidden" name="range" value="custom" />
            <label class="text-xs text-slate-500">من
                <input type="date" name="from" value="@f.From.ToString("yyyy-MM-dd")" dir="ltr" class="block mt-1 rounded-xl border border-slate-200 px-2 py-1.5 text-sm" />
            </label>
            <label class="text-xs text-slate-500">إلى
                <input type="date" name="to" value="@f.To.ToString("yyyy-MM-dd")" dir="ltr" class="block mt-1 rounded-xl border border-slate-200 px-2 py-1.5 text-sm" />
            </label>
            @if (stores.Count > 0)
            {
                <label class="text-xs text-slate-500">المتجر
                    <select name="storeId" class="block mt-1 rounded-xl border border-slate-200 px-2 py-1.5 text-sm min-w-40">
                        <option value="">كل المتاجر</option>
                        @foreach (var s in stores)
                        {
                            <option value="@s.Id" selected="@(s.Id == f.TenantId)">@s.Name</option>
                        }
                    </select>
                </label>
            }
            <button type="submit" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-sm font-semibold">تطبيق</button>
        </form>
    </div>

    <!-- المؤشرات -->
    @{
        var kpis = new List<(string Label, string Value, string Sub, string Icon)>
        {
            ("المبيعات المعتمدة", Money(Model.ApprovedSales) + " د.ل", $"متوسط الفاتورة {Money(Model.AverageInvoice)} د.ل", "banknote"),
            ("الفواتير", Model.TotalInvoices.ToString("N0"), $"{Model.ApprovedInvoices:N0} معتمدة • {Model.RejectedInvoices:N0} مرفوضة • {Model.InReviewInvoices:N0} قيد المراجعة", "receipt"),
            ("الاعتماد التلقائي بالذكاء الاصطناعي", Model.AutoApprovalRate + "%", $"{Model.AutoApprovedInvoices:N0} من {Model.ApprovedInvoices:N0} فاتورة معتمدة", "sparkles"),
            ("النقاط الممنوحة", Model.PointsIssued.ToString("N0"), $"العملاء النشطون: {Model.ActiveCustomers:N0}", "coins"),
        };
        if (Model.Filter.TenantId == null)
        {
            kpis.Add(("النقاط المستبدلة", Model.PointsRedeemed.ToString("N0"), $"{Model.VouchersIssued:N0} قسيمة صادرة • {Model.VouchersUsed:N0} مستخدمة", "gift"));
            kpis.Add(("عملاء جدد", Model.NewCustomers.ToString("N0"), "سجّلوا خلال الفترة", "user-plus"));
        }
    }
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
        @foreach (var k in kpis)
        {
            <div class="bg-white rounded-2xl border border-slate-200 p-5">
                <div class="flex items-center gap-2 text-slate-500 text-xs font-semibold">
                    <i data-lucide="@k.Icon" class="w-4 h-4"></i> @k.Label
                </div>
                <div class="mt-2 text-2xl font-extrabold text-slate-900" dir="auto">@k.Value</div>
                <div class="mt-1 text-xs text-slate-500">@k.Sub</div>
            </div>
        }
    </div>

    <!-- المبيعات اليومية: سلسلة واحدة ومحور واحد؛ عدد الفواتير والنقاط في التلميح -->
    <div class="bg-white rounded-2xl border border-slate-200 p-5">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-sm font-bold text-slate-900">المبيعات المعتمدة يومياً (د.ل)</h2>
                <p class="text-xs text-slate-500">مرّر المؤشر على أي يوم لرؤية عدد الفواتير والنقاط</p>
            </div>
            <button type="button" onclick="toggleTable('daily-table')" class="text-xs font-semibold text-slate-600 hover:text-slate-900 underline">عرض كجدول</button>
        </div>
        <div id="daily-chart" class="mt-2 h-72"></div>
        <div id="daily-table" class="hidden mt-3 overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="text-xs text-slate-500 bg-slate-50"><tr><th class="p-2 text-right">التاريخ</th><th class="p-2">الفواتير</th><th class="p-2">المعتمدة</th><th class="p-2">المبيعات</th><th class="p-2">النقاط</th></tr></thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var d in Model.Daily.AsEnumerable().Reverse())
                    {
                        <tr><td class="p-2" dir="ltr">@d.Date.ToString("yyyy/MM/dd")</td><td class="p-2 text-center">@d.Invoices</td><td class="p-2 text-center">@d.Approved</td><td class="p-2 text-center" dir="ltr">@Money(d.Sales)</td><td class="p-2 text-center">@d.Points</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-5 gap-5">
        <!-- المتاجر -->
        <div class="xl:col-span-3 bg-white rounded-2xl border border-slate-200 p-5">
            <h2 class="text-sm font-bold text-slate-900 mb-3">أداء المتاجر</h2>
            @if (Model.Stores.Count == 0)
            {
                <p class="text-sm text-slate-500 py-6 text-center">لا توجد فواتير في هذه الفترة.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="text-xs text-slate-500"><tr class="border-b border-slate-100"><th class="py-2 text-right">المتجر</th><th class="py-2">الفواتير</th><th class="py-2">المرفوضة</th><th class="py-2">النقاط</th><th class="py-2 text-right w-48">المبيعات</th></tr></thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var s in Model.Stores)
                            {
                                <tr>
                                    <td class="py-2.5"><div class="font-semibold text-slate-900">@s.Name</div><div class="text-[11px] text-slate-500">@s.Category</div></td>
                                    <td class="py-2.5 text-center">@s.Invoices</td>
                                    <td class="py-2.5 text-center @(s.Rejected > 0 ? "text-rose-700 font-semibold" : "text-slate-400")">@s.Rejected</td>
                                    <td class="py-2.5 text-center">@s.Points.ToString("N0")</td>
                                    <td class="py-2.5">
                                        <div class="flex items-center gap-2">
                                            <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden" title="@s.SharePercent% من المبيعات">
                                                <div class="h-full rounded-full bg-brand-600" style="width:@(Math.Max(s.SharePercent, s.Sales > 0 ? 2 : 0).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                            </div>
                                            <span class="text-xs font-semibold text-slate-800 w-20 text-left" dir="ltr">@Money(s.Sales)</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- أسباب الرفض -->
        <div class="xl:col-span-2 bg-white rounded-2xl border border-slate-200 p-5">
            <h2 class="text-sm font-bold text-slate-900 mb-3">أكثر أسباب رفض الفواتير</h2>
            @if (Model.RejectionReasons.Count == 0)
            {
                <p class="text-sm text-slate-500 py-6 text-center">لا توجد فواتير مرفوضة في هذه الفترة.</p>
            }
            else
            {
                var maxReason = Model.RejectionReasons.Max(r => r.Count);
                <ul class="space-y-3">
                    @foreach (var r in Model.RejectionReasons)
                    {
                        <li>
                            <div class="flex justify-between text-xs"><span class="text-slate-700">@r.Reason</span><span class="font-bold text-slate-900">@r.Count</span></div>
                            <div class="mt-1 h-2 rounded-full bg-slate-100 overflow-hidden"><div class="h-full rounded-full bg-slate-500" style="width:@(r.Count * 100 / maxReason)%"></div></div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-5">
        <!-- أفضل العملاء -->
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <h2 class="text-sm font-bold text-slate-900 mb-3">أفضل العملاء (حسب المشتريات المعتمدة)</h2>
            @if (Model.TopCustomers.Count == 0)
            {
                <p class="text-sm text-slate-500 py-6 text-center">لا توجد مشتريات معتمدة في هذه الفترة.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="text-xs text-slate-500"><tr class="border-b border-slate-100"><th class="py-2 text-right">العميل</th><th class="py-2">المستوى</th><th class="py-2">الفواتير</th><th class="py-2">النقاط</th><th class="py-2 text-left">المشتريات</th></tr></thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var c in Model.TopCustomers.Take(10))
                            {
                                <tr>
                                    <td class="py-2.5"><a href="/AdminDashboard/CustomerDetails/@c.Id" class="font-semibold text-slate-900 hover:underline">@c.Name</a><div class="text-[11px] text-slate-500" dir="ltr">@c.Phone</div></td>
                                    <td class="py-2.5 text-center text-xs">@c.Tier</td>
                                    <td class="py-2.5 text-center">@c.Invoices</td>
                                    <td class="py-2.5 text-center">@c.Points.ToString("N0")</td>
                                    <td class="py-2.5 text-left font-semibold" dir="ltr">@Money(c.Sales)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- المكافآت -->
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <h2 class="text-sm font-bold text-slate-900 mb-3">استبدال المكافآت</h2>
            @if (Model.Filter.TenantId != null)
            {
                <p class="text-sm text-slate-500 py-6 text-center">المكافآت على مستوى المول ولا تُعرض لمتجر واحد.</p>
            }
            else if (Model.Rewards.Count == 0)
            {
                <p class="text-sm text-slate-500 py-6 text-center">لم تُستبدل أي مكافأة في هذه الفترة.</p>
            }
            else
            {
                <table class="w-full text-sm">
                    <thead class="text-xs text-slate-500"><tr class="border-b border-slate-100"><th class="py-2 text-right">المكافأة</th><th class="py-2">مرات الاستبدال</th><th class="py-2">مستخدمة</th><th class="py-2 text-left">النقاط</th></tr></thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var r in Model.Rewards)
                        {
                            <tr><td class="py-2.5 font-semibold text-slate-900">@r.Title</td><td class="py-2.5 text-center">@r.Redemptions</td><td class="py-2.5 text-center">@r.Used</td><td class="py-2.5 text-left" dir="ltr">@r.PointsSpent.ToString("N0")</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleTable(id) { document.getElementById(id).classList.toggle('hidden'); }

    (function () {
        const daily = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Daily.Select(d => new { date = d.Date.ToString("MM/dd"), sales = d.Sales, invoices = d.Invoices, approved = d.Approved, points = d.Points })));
        const fmt = (v) => Number(v).toLocaleString('en', { maximumFractionDigits: 2 });
        MM.chart(document.getElementById('daily-chart'), () => ({
            chart: { type: 'bar', height: 288, animations: { enabled: false } },
            series: [{ name: 'المبيعات المعتمدة', data: daily.map(d => d.sales) }],
            xaxis: { categories: daily.map(d => d.date), labels: { rotate: 0, hideOverlappingLabels: true } },
            yaxis: { labels: { formatter: fmt } },
            colors: [MM.color('chart-primary')],
            plotOptions: { bar: { borderRadius: 4, borderRadiusApplication: 'end', columnWidth: daily.length > 40 ? '80%' : '55%' } },
            dataLabels: { enabled: false },
            states: { hover: { filter: { type: 'darken', value: 0.85 } } },
            tooltip: {
                custom: ({ dataPointIndex }) => {
                    const d = daily[dataPointIndex];
                    return `<div style="padding:8px 12px;direction:rtl;font-size:12px">
                        <div style="font-weight:700;margin-bottom:4px">${d.date}</div>
                        <div>المبيعات المعتمدة: <b dir="ltr">${fmt(d.sales)}</b> د.ل</div>
                        <div>الفواتير: <b>${d.invoices}</b> (معتمدة ${d.approved})</div>
                        <div>النقاط الممنوحة: <b>${d.points}</b></div></div>`;
                }
            },
            noData: { text: 'لا توجد بيانات' }
        }));
    })();
</script>
}
