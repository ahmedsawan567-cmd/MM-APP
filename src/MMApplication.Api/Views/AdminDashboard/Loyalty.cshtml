            </div>

            <div id="earning-box-spend" class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                <label class="form-label text-slate-800">معدل الاكتساب (نقطة لكل دينار):</label>
                <div class="grid grid-cols-2 gap-2">
                    <input type="number" step="0.01" id="earning-spend-ratio" value="0.10" class="form-input font-bold num">
                    <div class="flex items-center text-xs font-semibold text-slate-600">
