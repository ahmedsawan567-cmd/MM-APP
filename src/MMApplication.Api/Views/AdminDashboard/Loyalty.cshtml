@model MMApplication.Api.ViewModels.LoyaltyPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "برنامج ولاء المول وقواعد النقاط";
    ViewData["ActiveTab"] = "loyalty";
}

<div class="space-y-6">

    <!-- 1. Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
        <div>
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold">
                    <i data-lucide="award" class="w-5 h-5"></i>
                </div>
                <div>
                    <h1 class="text-base font-bold text-slate-900">محرك قواعد الولاء والنقاط الذكي</h1>
                    <p class="text-xs text-slate-500">إدارة أنماط احتساب النقاط، محفزات الأصناف (SKU)، حملات المضاعفة، ومستويات عضوية الزوار</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <button onclick="openModal('modal-add-earning-rule')" class="btn-secondary">
                <i data-lucide="sliders-horizontal" class="w-4 h-4 text-purple-600"></i>
                <span>قاعدة احتساب جديدة</span>
            </button>
            <button onclick="openModal('modal-add-campaign')" class="btn-primary">
                <i data-lucide="sparkles" class="w-4 h-4"></i>
                <span>إطلاق حملة مضاعفة</span>
            </button>
        </div>
    </div>

    <!-- 2. KPI Metrics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">الحملات الترويجية</span>
                <i data-lucide="sparkles" class="w-4 h-4 text-purple-500"></i>
            </div>
            <div class="text-xl font-bold text-slate-900 num">@Model.Campaigns.Count</div>
            <div class="text-[11px] text-emerald-700 mt-1 flex items-center gap-1 font-medium">
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>@Model.Campaigns.Count(c => c.IsActive) حملات نشطة حالياً</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">معدل الاكتساب الأساسي</span>
                <i data-lucide="coins" class="w-4 h-4 text-amber-500"></i>
            </div>
            <div class="text-xl font-bold text-slate-900 num">@Model.Rules.DinarsPerPoint <span class="text-xs font-sans font-normal text-slate-500">د.ل / نقطة</span></div>
            <div class="text-[11px] text-slate-400 mt-1">1 نقطة لكل @Model.Rules.DinarsPerPoint د.ل مشتريات</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">قيمة استبدال النقطة</span>
                <i data-lucide="banknote" class="w-4 h-4 text-emerald-500"></i>
            </div>
            <div class="text-xl font-bold text-emerald-600 num">@Model.Rules.PointRedemptionValueDinars <span class="text-xs font-sans font-normal text-slate-500">د.ل</span></div>
            <div class="text-[11px] text-slate-400 mt-1">100 نقطة = @(Model.Rules.PointRedemptionValueDinars * 100) د.ل</div>
        </div>

        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-400 mb-2">
                <span class="text-xs font-semibold text-slate-500">مضاعف الفئة البلاتينية</span>
                <i data-lucide="crown" class="w-4 h-4 text-purple-600"></i>
            </div>
            <div class="text-xl font-bold text-purple-600 num">@(Model.Rules.PlatinumMultiplier)x</div>
            <div class="text-[11px] text-purple-700 mt-1 font-medium">أعضاء النخبة VIP</div>
        </div>
    </div>

    <!-- 3. Segmented Navigation Tabs -->
    <div class="bg-white p-2 rounded-2xl border border-slate-200 shadow-2xs flex flex-wrap items-center gap-1.5" id="loyaltyTabs">
        <button class="segmented-tab active px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-2 bg-ink text-surface shadow-xs" onclick="switchLoyaltyTab('earning-rules', this)">
            <i data-lucide="sliders-horizontal" class="w-3.5 h-3.5"></i>
            <span>قواعد احتساب النقاط</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-white/20 text-surface">@(Model.EarningRules?.Count ?? 0)</span>
        </button>
        <button class="segmented-tab px-4 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100" onclick="switchLoyaltyTab('sku-boosters', this)">
            <i data-lucide="zap" class="w-3.5 h-3.5 text-amber-500"></i>
            <span>محفزات الأصناف والـ SKU</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-slate-100 text-slate-600">@(Model.Boosters?.Count ?? 0)</span>
        </button>
        <button class="segmented-tab px-4 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100" onclick="switchLoyaltyTab('campaigns', this)">
            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-purple-500"></i>
            <span>حملات المضاعفة</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-slate-100 text-slate-600">@Model.Campaigns.Count</span>
        </button>
        <button class="segmented-tab px-4 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100" onclick="switchLoyaltyTab('general-rules', this)">
            <i data-lucide="settings-2" class="w-3.5 h-3.5 text-slate-500"></i>
            <span>القواعد العامة ومستويات العضوية</span>
        </button>
    </div>

    <!-- TAB 1: EARNING RULES -->
    <div id="tab-content-earning-rules" class="loyalty-tab-content space-y-4">
        <div class="card overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-white">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">محرك احتساب النقاط المرن (Flexible Earning Engine)</h3>
                    <p class="text-xs text-slate-500 mt-0.5">أنماط احتساب النقاط: نقطة ثابتة لكل فاتورة، نسبة الإنفاق، بونص الأصناف، أو النظام الهجين</p>
                </div>
                <button onclick="openModal('modal-add-earning-rule')" class="btn-primary">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                    <span>إضافة مخصص لمتجر</span>
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>اسم القاعدة والمتجر</th>
                            <th>نمط الاحتساب</th>
                            <th>المعايير المحددة</th>
                            <th>الحد الأدنى للفاتورة</th>
                            <th>سقف النقاط (Cap)</th>
                            <th>الحالة</th>
                            <th class="text-left">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.EarningRules == null || Model.EarningRules.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-12 text-slate-400">
                                    <div class="w-12 h-12 rounded-full bg-slate-50 text-slate-400 flex items-center justify-center mx-auto mb-2">
                                        <i data-lucide="sliders" class="w-6 h-6"></i>
                                    </div>
                                    <div class="font-bold text-slate-700">لا توجد قواعد مخصصة مسجلة حالياً</div>
                                    <p class="text-xs text-slate-400 mt-1">يتم تطبيق النمط الافتراضي تلقائياً (0.10 نقطة لكل دينار = 1 نقطة لكل 10 د.ل)</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var r in Model.EarningRules)
                            {
                                <tr>
                                    <td>
                                        <div class="font-bold text-slate-900">@r.RuleName</div>
                                        <div class="text-xs text-slate-500 mt-0.5 flex items-center gap-1">
                                            <i data-lucide="store" class="w-3 h-3 text-slate-400"></i>
                                            <span>@(string.IsNullOrEmpty(r.StoreName) ? "كافة متاجر المول (عام / افتراضي)" : r.StoreName)</span>
                                        </div>
                                    </td>
                                    <td>
                                        @switch (r.CalculationType)
                                        {
                                            case "FIXED_PER_INVOICE":
                                                <span class="badge badge-blue">
                                                    <i data-lucide="map-pin" class="w-3 h-3"></i> ثابت لكل فاتورة
                                                </span>
                                                break;
                                            case "SPEND_RATIO":
                                                <span class="badge badge-emerald">
                                                    <i data-lucide="percent" class="w-3 h-3"></i> نسبة الإنفاق
                                                </span>
                                                break;
                                            case "ITEM_BOOSTER":
                                                <span class="badge badge-purple">
                                                    <i data-lucide="zap" class="w-3 h-3"></i> بونص الأصناف (SKU)
                                                </span>
                                                break;
                                            case "HYBRID":
                                                <span class="badge badge-amber">
                                                    <i data-lucide="layers" class="w-3 h-3"></i> نظام هجين مدمج
                                                </span>
                                                break;
                                            default:
                                                <span class="badge badge-slate">@r.CalculationType</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (r.CalculationType == "FIXED_PER_INVOICE")
                                        {
                                            <span class="font-bold text-slate-800 num">@r.FixedPointsPerInvoice نقطة / فاتورة</span>
                                        }
                                        else if (r.CalculationType == "SPEND_RATIO")
                                        {
                                            <span class="font-bold text-slate-800 num">@(r.SpendRatioRate * 10) نقاط لكل 10 د.ل</span>
                                            <span class="text-xs text-slate-400 mr-1">(@r.SpendRatioRate)</span>
                                        }
                                        else if (r.CalculationType == "ITEM_BOOSTER")
                                        {
                                            <span class="text-slate-600 text-xs font-medium">بونص الأصناف المطابقة فقط</span>
                                        }
                                        else if (r.CalculationType == "HYBRID")
                                        {
                                            <div class="text-xs space-y-0.5">
                                                <div class="font-bold text-slate-800 num">+@r.FixedPointsPerInvoice زيارة + @(r.SpendRatioRate * 10) نقطة/10د.ل</div>
                                                <div class="text-slate-500">+ بونص أصناف السلة</div>
                                            </div>
                                        }
                                    </td>
                                    <td class="font-semibold text-slate-800 num">
                                        @(r.MinInvoiceAmount > 0 ? $"{r.MinInvoiceAmount:N0} د.ل" : "بدون حد أدنى")
                                    </td>
                                    <td class="text-slate-700 num">
                                        @(r.MaxPointsCap.HasValue ? $"{r.MaxPointsCap.Value} نقطة" : "غير محدود")
                                    </td>
                                    <td>
                                        @if (r.IsActive)
                                        {
                                            <span class="badge badge-emerald">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> نشطة
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-slate">معطلة</span>
                                        }
                                    </td>
                                    <td class="text-left">
                                        <div class="flex items-center gap-1 justify-end">
                                            <button onclick="toggleEarningRule(@r.RuleId)" title="تبديل التفعيل" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition">
                                                <i data-lucide="@(r.IsActive ? "pause" : "play")" class="w-4 h-4"></i>
                                            </button>
                                            <button onclick="openEditEarningRuleModal(@r.RuleId, '@r.RuleName', '@r.StoreTenantId', '@r.CalculationType', @r.FixedPointsPerInvoice, @r.SpendRatioRate, @r.MinInvoiceAmount, @(r.MaxPointsCap.HasValue ? r.MaxPointsCap.Value.ToString() : "null"), @(r.IsActive ? "true" : "false"))" title="تعديل القاعدة" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition">
                                                <i data-lucide="edit-3" class="w-4 h-4"></i>
                                            </button>
                                            <button onclick="deleteEarningRule(@r.RuleId, '@r.RuleName')" title="حذف القاعدة" class="p-1.5 rounded-lg text-rose-500 hover:text-rose-700 hover:bg-rose-50 transition">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 2: SKU BOOSTERS -->
    <div id="tab-content-sku-boosters" class="loyalty-tab-content hidden space-y-4">
        <div class="card overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-white">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">محفزات الأصناف والماركات التجارية (SKU & Brand Boosters)</h3>
                    <p class="text-xs text-slate-500 mt-0.5">مكافآت نقاط إضافية وتلقائية عند شراء ماركة معينة أو أصناف محددة مستخرجة بالـ OCR</p>
                </div>
                <button onclick="openModal('modal-add-booster')" class="btn-primary">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                    <span>إضافة محفز صنف جديد</span>
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>اسم القاعدة والهدف</th>
                            <th>نوع الاستهداف</th>
                            <th>المضاعف / البونص</th>
                            <th>شروط التفعيل</th>
                            <th>فترة السريان</th>
                            <th>الحالة</th>
                            <th class="text-left">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Boosters == null || Model.Boosters.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-12 text-slate-400">
                                    <div class="w-12 h-12 rounded-full bg-slate-50 text-slate-400 flex items-center justify-center mx-auto mb-2">
                                        <i data-lucide="zap-off" class="w-6 h-6"></i>
                                    </div>
                                    <div class="font-bold text-slate-700">لا توجد قواعد تحفيز أصناف مسجلة حالياً</div>
                                    <p class="text-xs text-slate-400 mt-1">أضف محفزات للعلامات التجارية لتحفيز سلال المشتريات المحددة</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var b in Model.Boosters)
                            {
                                <tr>
                                    <td>
                                        <div class="font-bold text-slate-900">@b.RuleName</div>
                                        <div class="text-xs text-slate-500 font-mono mt-0.5">الهدف: @b.TargetValue</div>
                                    </td>
                                    <td>
                                        <span class="badge badge-slate">@b.TargetType</span>
                                    </td>
                                    <td>
                                        <div class="flex items-center gap-1.5">
                                            @if (b.PointsMultiplier > 1.0m)
                                            {
                                                <span class="badge badge-amber font-bold num">@(b.PointsMultiplier)x</span>
                                            }
                                            @if (b.BonusPoints > 0)
                                            {
                                                <span class="badge badge-emerald font-bold num">+@b.BonusPoints نقطة</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-slate-700 text-xs font-medium num">
                                        @(b.MinQuantity > 1 ? $"{b.MinQuantity} قطع" : "") 
                                        @(b.MinSpendAmount > 0 ? $" / {b.MinSpendAmount:N0} د.ل" : "")
                                        @(b.MinQuantity <= 1 && b.MinSpendAmount <= 0 ? "بدون شروط" : "")
                                    </td>
                                    <td class="text-xs text-slate-500 num">
                                        @b.StartDate.ToString("yyyy/MM/dd") - @b.EndDate.ToString("yyyy/MM/dd")
                                    </td>
                                    <td>
                                        @if (b.IsActive)
                                        {
                                            <span class="badge badge-emerald">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> نشط
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-slate">متوقف</span>
                                        }
                                    </td>
                                    <td class="text-left">
                                        <div class="flex items-center gap-1 justify-end">
                                            <button onclick="openEditBoosterModal('@b.Id', '@b.RuleName', '@b.TargetType', '@b.TargetValue', @b.PointsMultiplier, @b.BonusPoints, @b.MinQuantity, @(b.MinSpendAmount ?? 0), '@b.StartDate.ToString("yyyy-MM-dd")', '@b.EndDate.ToString("yyyy-MM-dd")', @(b.IsActive ? "true" : "false"))" title="تعديل المحفز" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition">
                                                <i data-lucide="edit-3" class="w-4 h-4"></i>
                                            </button>
                                            <button onclick="deleteBooster('@b.Id', '@b.RuleName')" title="حذف المحفز" class="p-1.5 rounded-lg text-rose-500 hover:text-rose-700 hover:bg-rose-50 transition">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 3: CAMPAIGNS -->
    <div id="tab-content-campaigns" class="loyalty-tab-content hidden space-y-4">
        <div class="card overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-white">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">حملات مضاعفة النقاط الترويجية (Loyalty Campaigns)</h3>
                    <p class="text-xs text-slate-500 mt-0.5">إدارة حملات مضاعفة النقاط المؤقتة للمول والفعاليات التسويقية ومواسم التخفيضات</p>
                </div>
                <button onclick="openModal('modal-add-campaign')" class="btn-primary">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                    <span>إطلاق حملة جديدة</span>
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>اسم الحملة والوصف</th>
                            <th>مضاعف النقاط</th>
                            <th>الحد الأدنى للإنفاق</th>
                            <th>فترة الحملة</th>
                            <th>الحالة</th>
                            <th class="text-left">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Campaigns.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-12 text-slate-400">
                                    <div class="w-12 h-12 rounded-full bg-slate-50 text-slate-400 flex items-center justify-center mx-auto mb-2">
                                        <i data-lucide="calendar" class="w-6 h-6"></i>
                                    </div>
                                    <div class="font-bold text-slate-700">لا توجد حملات مضاعفة مسجلة حالياً</div>
                                    <p class="text-xs text-slate-400 mt-1">أنشئ حملة مضاعفة بمناسبة الأعياد أو الفعاليات الخاصة</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var c in Model.Campaigns)
                            {
                                <tr>
                                    <td>
                                        <div class="font-bold text-slate-900">@c.Name</div>
                                        <div class="text-xs text-slate-500 max-w-md truncate mt-0.5">@c.Description</div>
                                    </td>
                                    <td>
                                        <span class="badge badge-amber font-bold num">
                                            @(c.PointsMultiplier)x
                                        </span>
                                    </td>
                                    <td class="font-semibold text-slate-800 num">
                                        @(c.MinSpendAmount > 0 ? $"{c.MinSpendAmount:N0} د.ل" : "بدون حد أدنى")
                                    </td>
                                    <td class="text-xs text-slate-500 num">
                                        @c.StartDate.ToString("yyyy/MM/dd") - @c.EndDate.ToString("yyyy/MM/dd")
                                    </td>
                                    <td>
                                        @if (c.IsActive)
                                        {
                                            <span class="badge badge-emerald">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> سارية
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-slate">متوقفة</span>
                                        }
                                    </td>
                                    <td class="text-left">
                                        <div class="flex items-center gap-1 justify-end">
                                            <button onclick="openEditCampaignModal('@c.Id', '@c.Name', '@c.Description', @c.PointsMultiplier, @c.MinSpendAmount, '@c.StartDate.ToString("yyyy-MM-dd")', '@c.EndDate.ToString("yyyy-MM-dd")', @(c.IsActive ? "true" : "false"))" title="تعديل الحملة" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition">
                                                <i data-lucide="edit-3" class="w-4 h-4"></i>
                                            </button>
                                            <button onclick="deleteCampaign('@c.Id', '@c.Name')" title="حذف الحملة" class="p-1.5 rounded-lg text-rose-500 hover:text-rose-700 hover:bg-rose-50 transition">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 4: GENERAL RULES & TIERS -->
    <div id="tab-content-general-rules" class="loyalty-tab-content hidden space-y-4">
        <div class="card p-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-5 border-b border-slate-100 mb-6">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">إعدادات ومستويات برنامج الولاء العام للمول</h3>
                    <p class="text-xs text-slate-500 mt-0.5">حدد معدل تحويل الدينار إلى نقاط، وقيمة الاستبدال المالي ومضاعفات مستويات العضوية (Tier Multipliers)</p>
