@section Scripts {
<script>
    function switchLoyaltyTab(tabId, el) {
        document.querySelectorAll('.loyalty-tab-content').forEach(c => c.classList.add('hidden'));
        const target = document.getElementById(`tab-content-${tabId}`);
        if (target) target.classList.remove('hidden');

        document.querySelectorAll('#loyaltyTabs .segmented-tab').forEach(t => {
            t.classList.remove('active', 'bg-ink', 'text-surface', 'shadow-xs');
            t.classList.add('text-slate-600', 'hover:text-slate-900', 'hover:bg-slate-100');
        });
        if (el) {
            el.classList.add('active', 'bg-ink', 'text-surface', 'shadow-xs');
            el.classList.remove('text-slate-600', 'hover:text-slate-900', 'hover:bg-slate-100');
        }
    }

    function onEarningModeChange(prefix) {
        const mode = document.getElementById(`${prefix}-calc-type`).value;
        const fixedBox = document.getElementById(`${prefix}-box-fixed`);
        const spendBox = document.getElementById(`${prefix}-box-spend`);
        const itemBox = document.getElementById(`${prefix}-box-item`);

        if (fixedBox) fixedBox.classList.toggle('hidden', mode !== 'FIXED_PER_INVOICE' && mode !== 'HYBRID');
        if (spendBox) spendBox.classList.toggle('hidden', mode !== 'SPEND_RATIO' && mode !== 'HYBRID');
        if (itemBox) itemBox.classList.toggle('hidden', mode !== 'ITEM_BOOSTER' && mode !== 'HYBRID');
    }

    async function submitCreateEarningRule() {
        const ruleName = document.getElementById('earning-name').value.trim();
        const storeTenantId = document.getElementById('earning-store-id').value || null;
        const calculationType = document.getElementById('earning-calc-type').value;
        const fixedPointsPerInvoice = parseInt(document.getElementById('earning-fixed-pts').value, 10) || 0;
        const spendRatioRate = parseFloat(document.getElementById('earning-spend-ratio').value) || 0.10;
        const minInvoiceAmount = parseFloat(document.getElementById('earning-min-spend').value) || 0;
        const maxCapVal = document.getElementById('earning-max-cap').value.trim();
        const maxPointsCap = maxCapVal ? parseInt(maxCapVal, 10) : null;

        if (!ruleName) {
            showToast('يرجى إدخال اسم قاعدة احتساب النقاط.', 'error');
            return;
        }

        try {
            const res = await fetch('/api/SuperAdmin/loyalty/earning-rules', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    ruleName,
                    storeTenantId,
                    calculationType,
                    fixedPointsPerInvoice,
                    spendRatioRate,
                    minInvoiceAmount,
                    maxPointsCap
                })
            });

            if (!res.ok) {
                const err = await res.json().catch(() => ({}));
                throw new Error(err.message || 'فشل حفظ قاعدة النقاط');
            }

            closeModal('modal-add-earning-rule');
            showToast('تم حفظ وتفعيل قاعدة احتساب النقاط بنجاح!', 'success');
            setTimeout(() => location.reload(), 600);
        } catch (err) {
            showToast(err.message, 'error');
        }
    }

    function openEditEarningRuleModal(id, name, storeId, calcType, fixedPts, spendRatio, minSpend, maxCap, isActive) {
        document.getElementById('edit-earning-id').value = id;
        document.getElementById('edit-earning-name').value = name;
        document.getElementById('edit-earning-store-id').value = storeId || '';
        document.getElementById('edit-earning-calc-type').value = calcType;
        document.getElementById('edit-earning-fixed-pts').value = fixedPts;
        document.getElementById('edit-earning-spend-ratio').value = spendRatio;
        document.getElementById('edit-earning-min-spend').value = minSpend;
        document.getElementById('edit-earning-max-cap').value = (maxCap !== null && maxCap !== 'null') ? maxCap : '';
        document.getElementById('edit-earning-active').value = isActive ? 'true' : 'false';
        
        onEarningModeChange('edit-earning');
        openModal('modal-edit-earning-rule');
    }

