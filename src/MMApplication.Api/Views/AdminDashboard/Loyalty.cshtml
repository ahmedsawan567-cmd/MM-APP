                    <input type="number" step="0.5" id="rule-dinars-per-point" value="@Model.Rules.DinarsPerPoint" class="form-input font-bold num">
                    <p class="text-[11px] text-slate-500">مثال: 10 د.ل مشتريات = 1 نقطة</p>
                </div>

                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-2">
                    <label class="form-label font-bold text-slate-800">قيمة النقطة عند الاستبدال (د.ل):</label>
                    <input type="number" step="0.05" id="rule-redemption-val" value="@Model.Rules.PointRedemptionValueDinars" class="form-input font-bold text-emerald-600 num">
                    <p class="text-[11px] text-slate-500">مثال: 0.50 د.ل لكل نقطة في المحفظة</p>
                </div>

                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-2">
                    <label class="form-label font-bold text-slate-800">مضاعف الفئة الفضية (Silver):</label>
                    <input type="number" step="0.05" id="rule-silver-mult" value="@Model.Rules.SilverMultiplier" class="form-input font-bold text-slate-700 num">
