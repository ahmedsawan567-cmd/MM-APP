@model MMApplication.Application.DTOs.SuperAdminOverviewDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "الرئيسية والمؤشرات";
    ViewData["ActiveTab"] = "overview";
}

<div class="space-y-6">

    <!-- 1. Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs">
        <div>
            <h1 class="text-base font-bold text-slate-900">لوحة المؤشرات والعمليات المركزية</h1>
            <p class="text-xs text-slate-500 mt-0.5">نظرة عامة على المبيعات المعتمدة، وتيرة الفواتير اليومية، ونشاط المتاجر في المركز التجاري</p>
        </div>

        <div class="flex items-center gap-2.5">
            <a asp-controller="AdminDashboard" asp-action="InvoiceTemplates" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-brand-50 text-brand-700 hover:bg-brand-100 transition">
                <i data-lucide="scan-line" class="w-4 h-4 text-brand-600"></i>
                <span>قوالب الفواتير والـ AI</span>
            </a>
            <button onclick="window.location.reload()" class="btn-secondary">
                <i data-lucide="rotate-cw" class="w-3.5 h-3.5"></i>
                <span>تحديث</span>
            </button>
        </div>
    </div>

    <!-- 2. 4 Executive KPI Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Total Sales Volume -->
        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-500 mb-2">
                <span class="text-xs font-semibold">إجمالي حجم المبيعات المعتمدة</span>
                <div class="w-9 h-9 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center">
                    <i data-lucide="wallet" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="space-y-1">
                <div class="text-xl font-bold text-slate-900 num">
                    @Model.TotalSalesVolume.ToString("N2") <span class="text-xs font-sans font-medium text-slate-500">د.ل</span>
                </div>
                @{ var change = ViewData["SalesChangePercent"] as decimal?; }
                @if (change.HasValue)
                {
                    <div class="text-[11px] font-semibold flex items-center gap-1 @(change.Value >= 0 ? "text-emerald-600" : "text-rose-600")">
                        <i data-lucide="@(change.Value >= 0 ? "trending-up" : "trending-down")" class="w-3.5 h-3.5"></i>
                        <span>@(change.Value >= 0 ? "+" : "")@change.Value% آخر 30 يوماً مقارنة بالـ 30 السابقة</span>
                    </div>
                }
                else
                {
                    <div class="text-[11px] text-slate-400">لا توجد بيانات كافية للمقارنة</div>
                }
            </div>
        </div>

        <!-- Today Scans -->
        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-500 mb-2">
                <span class="text-xs font-semibold">عمليات المسح اليومية</span>
                <div class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                    <i data-lucide="scan" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="space-y-1">
                <div class="text-xl font-bold text-slate-900 num">
                    @Model.TodayScansCount.ToString("N0") <span class="text-xs font-sans font-medium text-slate-500">فاتورة</span>
                </div>
                <div class="text-[11px] text-slate-400">
                    عبر منافذ بيع المول
                </div>
            </div>
        </div>

        <!-- Pending Reviews -->
        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-500 mb-2">
                <span class="text-xs font-semibold">فواتير تتطلب تدقيق</span>
                <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                    <i data-lucide="shield-alert" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="space-y-1">
                <div class="text-xl font-bold text-amber-600 num">
                    @Model.PendingReviewCount <span class="text-xs font-sans font-medium text-slate-500">معلقة</span>
                </div>
                <div class="text-[11px] text-slate-400">
                    <a asp-action="Fraud" class="text-amber-600 font-semibold hover:underline">مراجعة طابور التدقيق &larr;</a>
                </div>
            </div>
        </div>

        <!-- Circulating Points -->
        <div class="stat-card">
            <div class="flex items-center justify-between text-slate-500 mb-2">
                <span class="text-xs font-semibold">النقاط المتداولة بالمحافظ</span>
                <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
                    <i data-lucide="coins" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="space-y-1">
                <div class="text-xl font-bold text-purple-700 num">
                    @Model.CirculatingPoints.ToString("N0") <span class="text-xs font-sans font-medium text-slate-500">نقطة</span>
                </div>
                <div class="text-[11px] text-slate-400">
                    في محافظ المتسوقين النشطة
                </div>
            </div>
        </div>

    </div>

    <!-- 3. Charts Grid (Activity Pace + Category Distribution) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        
        <!-- Activity Pace (8 cols) -->
        <div class="lg:col-span-8 card p-5 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center">
                        <i data-lucide="activity" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h2 class="text-xs font-bold text-slate-900">حركة الفواتير والمبيعات — آخر 14 يوماً</h2>
                        <p class="text-[11px] text-slate-400">المبيعات المعتمدة يومياً (د.ل) — مرّر المؤشر لرؤية عدد الفواتير</p>
                    </div>
                </div>
                            </div>

            <div id="apexScanPaceChart" class="min-h-[280px]"></div>
        </div>

        <!-- Category Distribution (4 cols) -->
        <div class="lg:col-span-4 card p-5 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center">
                        <i data-lucide="layers" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h2 class="text-xs font-bold text-slate-900">توزيع المبيعات حسب الأنشطة</h2>
                        <p class="text-[11px] text-slate-400">المبيعات المعتمدة حسب فئة المتجر</p>
                    </div>
                </div>
            </div>

            @if (Model.CategoryDistribution.Count == 0)
            {
                <p class="text-sm text-slate-500 text-center py-16">لا توجد مبيعات معتمدة بعد.</p>
            }
            else
            {
                var maxCat = Model.CategoryDistribution.Max(c => c.TotalAmount);
                <ul class="space-y-3">
                    @foreach (var c in Model.CategoryDistribution.Take(8))
                    {
                        <li>
                            <div class="flex justify-between text-xs">
                                <span class="font-semibold text-slate-700">@c.CategoryName</span>
                                <span class="text-slate-500"><b class="text-slate-900" dir="ltr">@c.TotalAmount.ToString("N0")</b> د.ل • @c.Percentage%</span>
                            </div>
                            <div class="mt-1 h-2 rounded-full bg-slate-100 overflow-hidden">
                                <div class="h-full rounded-full bg-brand-600" style="width:@((maxCat > 0 ? Math.Max(2, c.TotalAmount * 100 / maxCat) : 0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>

    </div>

    <!-- 4. Top Performing Stores Table -->
    <div class="card p-5 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
                    <i data-lucide="trophy" class="w-4 h-4"></i>
                </div>
                <div>
                    <h2 class="text-xs font-bold text-slate-900">أعلى المتاجر مبيعاً ونشاطاً في المركز التجاري</h2>
                    <p class="text-[11px] text-slate-400">المتاجر الأكثر تسجيلاً للفواتير وإقبالاً من الزبائن</p>
                </div>
            </div>
            <a asp-action="Stores" class="text-xs text-brand-600 hover:text-brand-700 font-semibold flex items-center gap-1">
                <span>عرض كافة المتاجر</span>
                <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
            </a>
        </div>

        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>اسم المتجر</th>
                        <th>عدد الفواتير المعتمدة</th>
                        <th>إجمالي المبيعات المحققة</th>
                        <th class="text-center">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.TopPerformingStores.Count; i++)
                    {
                        var st = Model.TopPerformingStores[i];
                        <tr>
                            <td>
                                <span class="w-6 h-6 rounded-full @(i == 0 ? "bg-amber-100 text-amber-800 font-bold" : (i == 1 ? "bg-slate-200 text-slate-800 font-bold" : "bg-slate-100 text-slate-600 font-medium")) flex items-center justify-center text-xs num">
                                    @(i + 1)
                                </span>
                            </td>
                            <td>
                                <div class="font-bold text-slate-900 text-xs">@st.StoreName</div>
                            </td>
                            <td>
                                <span class="badge badge-blue num font-bold">@st.InvoicesCount فاتورة</span>
                            </td>
                            <td>
                                <span class="font-bold text-slate-900 num text-xs">@st.TotalSales.ToString("N2")</span> <span class="text-[11px] text-slate-500">د.ل</span>
                            </td>
                            <td class="text-center">
                                <a asp-controller="AdminDashboard" asp-action="InvoiceTemplates" class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
                                    <i data-lucide="scan-line" class="w-3.5 h-3.5 text-brand-600"></i>
                                    <span>نموذج الفاتورة</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // المبيعات اليومية: سلسلة واحدة على محور واحد؛ عدد الفواتير في التلميح
        const paceLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ScanActivityPace.Select(p => p.TimeLabel)));
        const paceScans = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ScanActivityPace.Select(p => p.ScanCount)));
        const paceAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ScanActivityPace.Select(p => (double)p.VolumeAmount)));
        const fmt = (v) => Number(v).toLocaleString('en', { maximumFractionDigits: 2 });

        MM.chart(document.querySelector("#apexScanPaceChart"), () => ({
            chart: { type: 'bar', height: 280, animations: { enabled: false } },
            series: [{ name: 'المبيعات المعتمدة', data: paceAmounts }],
            colors: [MM.color('chart-primary')],
            plotOptions: { bar: { borderRadius: 4, borderRadiusApplication: 'end', columnWidth: '55%' } },
            dataLabels: { enabled: false },
            xaxis: { categories: paceLabels },
            yaxis: { labels: { formatter: fmt } },
            states: { hover: { filter: { type: 'darken', value: 0.85 } } },
            tooltip: {
                custom: ({ dataPointIndex: i }) =>
                    `<div style="padding:8px 12px;direction:rtl;font-size:12px">
                        <div style="font-weight:700;margin-bottom:4px">${paceLabels[i]}</div>
                        <div>المبيعات المعتمدة: <b>${fmt(paceAmounts[i])}</b> د.ل</div>
                        <div>الفواتير المرفوعة: <b>${paceScans[i]}</b></div></div>`
            }
        }));
    });
</script>
}
