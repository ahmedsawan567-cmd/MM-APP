@using MMApplication.Domain.Enums
@{
    var activeTab = ViewData["ActiveTab"] as string ?? "";
    var currentRole = User.FindFirst("SystemRole")?.Value ?? (User.IsInRole("superadmin") ? "SUPER_ADMIN" : (User.IsInRole("auditor") ? "FRAUD_AUDITOR" : (User.IsInRole("storemanager") ? "STORE_MANAGER" : "SUPER_ADMIN")));
    var isDevOrSuperAdmin = User.IsInRole("superadmin") || currentRole == "SUPER_ADMIN";
    var isAuditor = User.IsInRole("auditor") || currentRole == "FRAUD_AUDITOR";
    var isStoreManager = User.IsInRole("storemanager") || currentRole == "STORE_MANAGER";
    var tenantName = User.FindFirst("TenantName")?.Value;

    var layoutDb = Context.RequestServices.GetService(typeof(MMApplication.Infrastructure.Data.AppDbContext)) as MMApplication.Infrastructure.Data.AppDbContext;
    // عدد الفواتير التي تنتظر قرار الموظفين (حقيقي من قاعدة البيانات)
    var reviewQueueCount = (isDevOrSuperAdmin || isAuditor) && layoutDb != null
        ? layoutDb.Invoices.Count(i => i.ProcessingStatus == InvoiceStatus.REVIEW_REQUIRED
            || i.ProcessingStatus == InvoiceStatus.PENDING
            || i.ProcessingStatus == InvoiceStatus.PROCESSING
            || i.ProcessingStatus == InvoiceStatus.DISPUTED)
        : 0;
    var dbIsPersistent = layoutDb != null && !string.Equals(layoutDb.Database.ProviderName, "Microsoft.EntityFrameworkCore.InMemory", StringComparison.Ordinal);

    var currentUserName = User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(User.Identity.Name) ? User.Identity.Name : "المسؤول";
    var userInitial = currentUserName.Trim().Length > 0 ? currentUserName.Trim()[..1] : "م";
    var roleDisplayName = isDevOrSuperAdmin ? "المدير العام"
        : isAuditor ? "مدقق الفواتير والاحتيال"
        : isStoreManager ? (!string.IsNullOrEmpty(tenantName) ? $"مدير متجر: {tenantName}" : "مدير متجر")
        : "طاقم العمل";

    // عناصر القائمة: (القسم، العنوان، الصفحة، الأيقونة، المفتاح، الظهور، العدّاد)
    var nav = new List<(string Section, string Label, string Action, string Icon, string Key, bool Visible, int Count)>
    {
        ("", isStoreManager ? "لوحة متجري" : "الرئيسية", "Index", "layout-dashboard", "overview", true, 0),
        ("", "التقارير", "Reports", "chart-no-axes-combined", "reports", isDevOrSuperAdmin || isAuditor || isStoreManager, 0),

        ("الفواتير", "مراجعة الفواتير", "Review", "scan-search", "review", isDevOrSuperAdmin || isAuditor, reviewQueueCount),
        ("الفواتير", "سجل الفواتير", "Invoices", "receipt-text", "invoices", true, 0),
        ("الفواتير", "تدقيق الاحتيال", "Fraud", "shield-alert", "fraud", isDevOrSuperAdmin || isAuditor, 0),
        ("الفواتير", "نماذج الفواتير", "InvoiceTemplates", "scan-text", "invoice_templates", isDevOrSuperAdmin || isAuditor || isStoreManager, 0),

        ("العملاء والمكافآت", "العملاء", "Customers", "users", "customers", isDevOrSuperAdmin || isAuditor, 0),
        ("العملاء والمكافآت", "المكافآت والقسائم", "Rewards", "gift", "rewards", true, 0),
        ("العملاء والمكافآت", "قواعد النقاط", "Loyalty", "award", "loyalty", isDevOrSuperAdmin || isStoreManager, 0),
        ("العملاء والمكافآت", "الإعلانات", "Ads", "megaphone", "ads", isDevOrSuperAdmin, 0),
        ("العملاء والمكافآت", "الإشعارات المرسلة", "SentNotifications", "send", "sent_notifications", isDevOrSuperAdmin, 0),

        ("المتاجر", isStoreManager ? "بيانات متجري" : "المتاجر", "Stores", "store", "stores", isDevOrSuperAdmin || isStoreManager, 0),
        ("المتاجر", isStoreManager ? "مستحقات متجري" : "التسويات المالية", "Settlements", "wallet-cards", "settlements", true, 0),

        ("الإدارة", "طاقم العمل", "Staff", "user-cog", "staff", isDevOrSuperAdmin, 0),
        ("الإدارة", "الإعدادات والسجل", "Settings", "settings", "settings", isDevOrSuperAdmin, 0),
    };
    var visibleNav = nav.Where(n => n.Visible).ToList();
    var pageTitle = ViewData["Title"] as string ?? "لوحة التحكم";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>@pageTitle — المرأة مول</title>
    <link rel="icon" type="image/svg+xml" href="~/img/brand/mark.svg">
    <link rel="icon" type="image/png" sizes="192x192" href="~/img/brand/icon-192.png">
    <link rel="apple-touch-icon" href="~/img/brand/apple-touch-icon.png">
    <meta name="theme-color" content="#B607BC">
    <script>
        // تطبيق الوضع المحفوظ قبل الرسم لتجنب وميض الألوان
        (function () {
            var t = null;
            try { t = localStorage.getItem('mm-theme'); } catch (e) { }
            if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/tailwind.css" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/apexcharts.css" asp-append-version="true">
    <script src="~/lib/lucide.min.js" asp-append-version="true"></script>
    <script src="~/lib/apexcharts.min.js" asp-append-version="true"></script>
    <script src="~/lib/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script src="~/js/mm.js" asp-append-version="true"></script>
</head>
<body class="min-h-screen">

    <!-- خلفية القائمة على الجوال -->
    <div id="nav-backdrop" class="fixed inset-0 z-40 bg-slate-950/40 backdrop-blur-[2px] hidden lg:hidden" onclick="MM.nav(false)"></div>

    <!-- القائمة الجانبية -->
    <aside id="sidebar"
           class="fixed inset-y-0 right-0 z-50 flex w-72 lg:w-[17rem] flex-col border-l border-line bg-surface transition-transform duration-200 translate-x-full lg:translate-x-0">
        <div class="flex h-[4.5rem] shrink-0 items-center gap-3 px-5 border-b border-line">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white p-1.5 ring-1 ring-line shadow-sm">
                <img src="~/img/brand/mark.svg" alt="المرأة مول" class="h-full w-full" />
            </div>
            <div class="min-w-0 leading-tight">
                <div class="text-[1.0625rem] font-bold text-ink">المرأة مول</div>
                <div class="text-xs text-ink-3">منظومة الولاء والفواتير</div>
            </div>
            <button type="button" class="btn-icon mr-auto lg:hidden" onclick="MM.nav(false)" aria-label="إغلاق القائمة">
                <i data-lucide="x" class="h-5 w-5"></i>
            </button>
        </div>

        <nav class="flex-1 overflow-y-auto px-3 pb-6" aria-label="القائمة الرئيسية">
            @foreach (var group in visibleNav.GroupBy(n => n.Section))
            {
                @if (!string.IsNullOrEmpty(group.Key))
                {
                    <div class="nav-section">@group.Key</div>
                }
                else
                {
                    <div class="pt-4"></div>
                }
                <div class="space-y-0.5">
                    @foreach (var item in group)
                    {
                        <a asp-controller="AdminDashboard" asp-action="@item.Action"
                           class="sidebar-link @(activeTab == item.Key ? "active" : "")"
                           aria-current="@(activeTab == item.Key ? "page" : null)" data-nav-label="@item.Label">
                            <i data-lucide="@item.Icon"></i>
                            <span class="truncate">@item.Label</span>
                            @if (item.Count > 0)
                            {
                                <span class="nav-count">@item.Count</span>
                            }
                        </a>
                    }
                </div>
            }
        </nav>

        <div class="shrink-0 border-t border-line p-3">
            <div class="flex items-center gap-3 rounded-xl bg-surface-2 p-2.5">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-700 text-sm font-bold text-white">@userInitial</div>
                <div class="min-w-0 flex-1 leading-tight">
                    <div class="truncate text-sm font-bold text-ink">@currentUserName</div>
                    <div class="truncate text-xs text-ink-3">@roleDisplayName</div>
                </div>
                <a asp-controller="AdminDashboard" asp-action="Logout" class="btn-icon h-8 w-8 hover:!text-rose-600" title="تسجيل الخروج" aria-label="تسجيل الخروج">
                    <i data-lucide="log-out" class="h-4 w-4"></i>
                </a>
            </div>
        </div>
    </aside>

    <div class="flex min-h-screen min-w-0 flex-col lg:pr-[17rem]">

        <!-- الشريط العلوي -->
        <header class="sticky top-0 z-30 flex h-[4.5rem] items-center gap-3 border-b border-line bg-surface/80 px-4 backdrop-blur-md sm:px-6">
            <button type="button" class="btn-icon lg:hidden" onclick="MM.nav(true)" aria-label="فتح القائمة">
                <i data-lucide="menu" class="h-5 w-5"></i>
            </button>

            <!-- البحث السريع في صفحات المنظومة -->
            <div class="relative w-full max-w-xs sm:max-w-sm">
                <i data-lucide="search" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-3"></i>
                <input id="quick-nav" type="search" autocomplete="off" placeholder="انتقل إلى صفحة..."
                       class="w-full rounded-xl border border-line bg-surface-2 py-2 pl-12 pr-9 text-sm text-ink placeholder:text-ink-3 focus:border-brand-600 focus:bg-surface focus:outline-none focus:ring-4 focus:ring-brand-600/15"
                       aria-label="البحث عن صفحة" />
                <kbd class="pointer-events-none absolute left-2.5 top-1/2 hidden -translate-y-1/2 rounded-md border border-line bg-surface px-1.5 text-xs font-semibold text-ink-3 sm:block">/</kbd>
                <div id="quick-nav-results" class="dropdown right-0 left-0 hidden"></div>
            </div>

            <div class="mr-auto flex items-center gap-1.5">
                <span class="hidden items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset md:inline-flex @(dbIsPersistent ? "bg-emerald-50 text-emerald-700 ring-emerald-200" : "bg-amber-50 text-amber-700 ring-amber-200")"
                      title="@(dbIsPersistent ? "البيانات محفوظة بشكل دائم" : "قاعدة بيانات مؤقتة في الذاكرة: تُمسح البيانات عند إعادة تشغيل الخادم")">
                    <span class="dot @(dbIsPersistent ? "bg-emerald-500" : "bg-amber-500")"></span>
                    @(dbIsPersistent ? "قاعدة البيانات متصلة" : "قاعدة بيانات تجريبية")
                </span>

                <!-- الإشعارات -->
                <div class="relative">
                    <button type="button" id="notif-button" class="btn-icon relative" onclick="MM.notifications.toggle()" aria-haspopup="menu" aria-expanded="false" title="الإشعارات" aria-label="الإشعارات">
                        <i data-lucide="bell" class="h-5 w-5"></i>
                        <span id="notif-badge" class="hidden absolute -top-0.5 -left-0.5 min-w-[1.25rem] h-5 px-1 rounded-full bg-rose-600 text-white text-xs font-bold leading-5 text-center ring-2 ring-surface"></span>
                    </button>
                    <div id="notif-menu" class="dropdown left-0 hidden w-[22rem] max-w-[calc(100vw-2rem)] !p-0 overflow-hidden" role="menu">
                        <div class="flex items-center justify-between gap-2 px-4 py-3 border-b border-line">
                            <span class="font-bold text-ink">الإشعارات</span>
                            <button type="button" class="text-sm font-semibold text-brand-700 hover:underline" onclick="MM.notifications.readAll()">تحديد الكل كمقروء</button>
                        </div>
                        <div id="notif-list" class="max-h-[26rem] overflow-y-auto divide-y divide-line">
                            <div class="px-4 py-8 text-center text-sm text-ink-3">جارٍ التحميل...</div>
                        </div>
                        <button type="button" id="notif-desktop" class="hidden w-full px-4 py-3 border-t border-line text-sm font-semibold text-ink-2 hover:bg-slate-50 text-right" onclick="MM.notifications.enableDesktop()">
                            تفعيل تنبيهات المتصفح عند وصول إشعار جديد
                        </button>
                    </div>
                </div>

                <button type="button" class="btn-icon" onclick="MM.toggleTheme()" title="تبديل الوضع الفاتح / الداكن" aria-label="تبديل الوضع الفاتح أو الداكن">
                    <i data-lucide="moon" class="h-[18px] w-[18px] theme-icon-light"></i>
                    <i data-lucide="sun" class="h-[18px] w-[18px] theme-icon-dark"></i>
                </button>

                <div class="relative">
                    <button type="button" class="flex items-center gap-2 rounded-xl p-1 pl-2 hover:bg-slate-100" onclick="MM.dropdown('user-menu')" aria-haspopup="menu" aria-expanded="false">
                        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-700 text-sm font-bold text-white">@userInitial</span>
                        <i data-lucide="chevron-down" class="h-4 w-4 text-ink-3"></i>
                    </button>
                    <div id="user-menu" class="dropdown left-0 hidden" role="menu">
                        <div class="px-3 py-2 border-b border-line mb-1">
                            <div class="text-sm font-bold text-ink">@currentUserName</div>
                            <div class="text-xs text-ink-3">@roleDisplayName</div>
                        </div>
                        <button type="button" class="dropdown-item" onclick="MM.toggleTheme()" role="menuitem">
                            <i data-lucide="sun-moon" class="h-4 w-4"></i> تبديل الوضع الفاتح / الداكن
                        </button>
                        <button type="button" class="dropdown-item" onclick="MM.help()" role="menuitem">
                            <i data-lucide="life-buoy" class="h-4 w-4"></i> الدليل والمساعدة
                        </button>
                        <a asp-controller="AdminDashboard" asp-action="Logout" class="dropdown-item !text-rose-600" role="menuitem">
                            <i data-lucide="log-out" class="h-4 w-4"></i> تسجيل الخروج
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <form id="mm-af" class="hidden">@Html.AntiForgeryToken()</form>

        <main id="main" class="mx-auto w-full max-w-[1360px] flex-1 space-y-6 p-4 animate-fade-in sm:p-6 lg:px-10 lg:py-8">
            @RenderBody()
        </main>

        <footer class="px-6 py-5 text-center text-xs text-ink-3">
            منظومة المرأة مول © @DateTime.UtcNow.Year
        </footer>
    </div>

    <script>
        // للتوافق مع الصفحات القديمة
        function toggleMobileNav(show) { MM.nav(show); }
        function showHelpModal() { MM.help(); }
        window.MM_NAV = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(visibleNav.Select(n => new { label = n.Label, section = n.Section, icon = n.Icon, url = Url.Action(n.Action, "AdminDashboard") })));
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
